    local screenGui = playerGui:FindFirstChild("ScreenGui")
    local menu      = screenGui and screenGui:FindFirstChild("Menu")
    local blc       = menu and menu:FindFirstChild("BottomLeftCorner")
    local trinkets  = (blc and blc:FindFirstChild("Trinkets")) or (screenGui and screenGui:FindFirstChild("Trinkets", true))

    if trinkets then
        for i = 1, 2 do
            local slot = trinkets:FindFirstChild("TrinketSlot" .. i)
            if slot then
                local itemImage = slot:FindFirstChild("ItemImage") or slot:FindFirstChildWhichIsA("ImageLabel", true)
                local img       = itemImage and tostring(itemImage.Image or "") or ""
                if string.find(img, "17653810346", 1, true) then
                    local textLabel = slot:FindFirstChild("TextLabel") or slot:FindFirstChildWhichIsA("TextLabel", true)
                    local cleanTxt  = textLabel and string.lower(tostring(textLabel.Text or "")) or ""
                    local isActive  = (string.match(cleanTxt, "^%s*active%s*$") ~= nil)
                    return true, isActive
                end
            end
        end
    end
    return false, false
end

local function isTrinketActive()
