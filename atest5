-- Loop Auto Masuk Real Elevator (Mendukung PanicTime Item Sweep & Anti-Ramp Verification <= 6.5 studs)
task.spawn(function()
    local isMovingToElev = false

    while _G.TeleportGUI_Loaded do
        if Config.AutoElevator and rootPart and not abortTeleport then
            local isDone, curG, totG = isFloorAllMachinesDone()
            if isDone then
                local panicDeadline, secRem = isPanicDeadlineReached()
                local hasRemItems           = hasSafePickableItemsInMap()

                -- Jika waktu lift masih > PanicTime dan masih ada item aman, biarkan Auto Pickup menyapu item dulu!
                if hasRemItems and not panicDeadline then
                    inElevatorStandby     = false
                    hasVerifiedInElevator = false
                    if secRem then
                        safeSt.Text = string.format("⏳ Sapu Item dulu! (Lift: %ds > Panic %ds)", secRem, Config.PanicTime or 5)
                        safeSt.TextColor3 = Color3.fromRGB(255, 215, 90)
                    end
                    task.wait(0.2)
                    continue
                end

                local elevatorTarget = getRealElevatorCFrame()
                if elevatorTarget then
                    local elevatorsFolder = Workspace:FindFirstChild("Elevators")
                    if elevatorsFolder then
                        for _, el in ipairs(elevatorsFolder:GetChildren()) do
                            local dh = el:FindFirstChild("DoorHitbox", true)
                            if dh and dh:IsA("BasePart") then dh.CanCollide = false end
                        end
                    end

                    local flatDist = Vector2.new(rootPart.Position.X - elevatorTarget.Position.X, rootPart.Position.Z - elevatorTarget.Position.Z).Magnitude

                    if not inElevatorStandby then
                        inElevatorStandby     = true
                        hasVerifiedInElevator = false
                        print(string.format("[AUTO ELEVATOR] Mesin Done (%d/%d)! Menuju titik tengah Real Elevator...", curG, totG))
                    end

                    if isPickingUp or isPathfinding then
                        isPickingUp   = false
                        isPathfinding = false
                        pcall(function() RunService:UnbindFromRenderStep("_TeleportWalkSim") end)
                        if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
                        clearAllServerSyncedHolds()
                        if rootPart then rootPart.Anchored = false end
                    end

                    local function moveIntoRealElevatorCenter()
                        teleportInstant(elevatorTarget, false)
                        task.wait(0.32)
                        if not rootPart then return false end
                        local dAfterSnap = Vector2.new(rootPart.Position.X - elevatorTarget.Position.X, rootPart.Position.Z - elevatorTarget.Position.Z).Magnitude
                        if dAfterSnap <= 6.5 then
                            return true
                        end
                        if dAfterSnap > 15.0 then
                            safeSingleLayerTween(elevatorTarget, Config.TweenSpeed, panicDeadline)
                        end
                        if rootPart and Vector2.new(rootPart.Position.X - elevatorTarget.Position.X, rootPart.Position.Z - elevatorTarget.Position.Z).Magnitude > 6.5 then
                            teleportTween(elevatorTarget, Config.TweenSpeed, true, true)
                        end
                        teleportInstant(elevatorTarget, false)
                        task.wait(0.25)
                        return rootPart and (Vector2.new(rootPart.Position.X - elevatorTarget.Position.X, rootPart.Position.Z - elevatorTarget.Position.Z).Magnitude <= 6.5)
                    end

                    if Config.ForceLockInElevator then
                        if flatDist > 4.5 and not isMovingToElev then
                            isMovingToElev = true
                            if moveIntoRealElevatorCenter() then
                                hasVerifiedInElevator = true
                            end
                            isMovingToElev = false
                        else
                            hasVerifiedInElevator = true
                            if rootPart.Anchored then rootPart.Anchored = false end
                        end
                    else
                        if not hasVerifiedInElevator and not isMovingToElev then
                            isMovingToElev = true
                            safeSt.Text = string.format("🚨 Masuk ke tengah Real Elevator (%d/%d)...", curG, totG)
                            safeSt.TextColor3 = Color3.fromRGB(255, 210, 90)
                            if moveIntoRealElevatorCenter() then
                                hasVerifiedInElevator = true
                                if rootPart.Anchored then rootPart.Anchored = false end
                                safeSt.Text = "✔ Terverifikasi aman di tengah Real Elevator!"
                                safeSt.TextColor3 = Color3.fromRGB(100, 255, 160)
                            end
                            isMovingToElev = false
                        elseif flatDist > 7.5 then
                            hasVerifiedInElevator = false
                        elseif rootPart.Anchored then
                            rootPart.Anchored = false
                        end
                    end
                end
            else
                if inElevatorStandby then
                    inElevatorStandby     = false
                    hasVerifiedInElevator = false
                    safeSt.Text           = ""
                end
            end
        end
        task.wait(0.3)
    end
end)

