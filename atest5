    task.spawn(function()
        doTeleport(freshCF, Config.TeleportMode, Config.TweenSpeed)
        genSt.Text = "✔ Sampai di Lever " .. selectedGenData.label .. "!"
        task.delay(2.5, function() genSt.Text = "" end)
    end)
