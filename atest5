                local dualTag   = isDual and " [2P]" or ""
                local statusTag = completed and " [DONE]" or (possessed and " [POSSESSED]" or (occupied and " [FULL]" or ""))
                local displayLabel = string.format("Gen #%d%s (%d/%d)%s", idx, dualTag, cur, req, statusTag)

                table.insert(genList, {
                    id        = idx,
                    model     = gen,
                    label     = displayLabel,
                    cf        = tpCF,
                    position  = tpCF.Position,
                    completed = completed,
                    possessed = possessed,
                    occupied  = occupied,
                })
            end
        end
    end
    return genList
end

local function getItemsInRoom()
    local items  = {}
    local map    = getMap()
    local folder = map and map:FindFirstChild("Items")
    if not folder then return items end
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Model") then
            if not items[item.Name] then
                items[item.Name] = { count = 0, instances = {} }
            end
            items[item.Name].count = items[item.Name].count + 1
            table.insert(items[item.Name].instances, item)
        end
    end
    return items
end

-- ==============================================================================
-- SMART PRIORITY ITEM PICKUP ENGINE (MONSTER-AWARE + PANIC TIME + VEE REMOTE)
-- ==============================================================================
local function runSmartItemPickup(specificTargetName, cb)
    if isPickingUp then return end
    isPickingUp   = true
    abortTeleport = false
    rebuildPickupLookups()

    local moveMode  = Config.SyncPickupWithMain and Config.TeleportMode or (Config.Pickup and Config.Pickup.MovementMode or Config.PickupMode)
    local moveSpeed = Config.SyncPickupWithMain and Config.TweenSpeed or (Config.Pickup and Config.Pickup.TweenSpeed or Config.PickupTweenSpeed)

    task.spawn(function()
        updateColliderCaches(false)

        -- Pastikan keluar dari lift terlebih dahulu sebelum mulai memungut item!
        ensureExitedElevator(cb)

        local function makePlatform(atPos)
            local plat = Instance.new("Part")
            plat.Size         = Vector3.new(10, 1, 10)
            plat.Anchored     = true
            plat.CanCollide   = true
            plat.Transparency = 1
            plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
            plat.Parent       = Workspace
            return plat
        end

        local skipCounts    = {}
        local cooldownUntil = {}
        local pickedAnyItem = false

        local function getSortedCandidateItems()
            local safeList    = {}
            local guardedList = {}
            local map         = getMap()
            local folder      = map and map:FindFirstChild("Items")
            if not folder or not rootPart then return safeList, guardedList end

            local now   = os.clock()
            local rpPos = rootPart.Position

            for _, item in ipairs(folder:GetChildren()) do
                if item:IsA("Model") and item.Parent and not item:GetAttribute("BlacklistLimbo") and (skipCounts[item] or 0) < 3 then
                    local tier = nil
                    if specificTargetName then
                        if item.Name == specificTargetName then tier = 1 end
                    else
                        tier = getItemPriorityTier(item.Name)
                    end

                    if tier ~= nil then
                        local itemPos       = item:GetPivot().Position
                        local dist          = (rpPos - itemPos).Magnitude
                        local attrCd        = item:GetAttribute("MonsterItemCooldown") or 0
                        local isOnCooldown  = (cooldownUntil[item] and now < cooldownUntil[item]) or (now < attrCd)
                        local isDangerous   = isOnCooldown or isItemAreaDangerous(itemPos)
                        local weightedScore = dist + ((tier - 1) * 30)

                        local entry = {
                            instance = item,
                            name     = item.Name,
                            tier     = tier,
                            pos      = itemPos,
                            dist     = dist,
                            score    = weightedScore,
                        }

                        if isDangerous then
                            if now >= attrCd then
                                item:SetAttribute("MonsterItemCooldown", now + 5.0)
                            end
                            table.insert(guardedList, entry)
                        else
                            table.insert(safeList, entry)
                        end
                    end
                end
            end

            local function sortFn(a, b) return a.score < b.score end
            table.sort(safeList, sortFn)
            table.sort(guardedList, sortFn)
            return safeList, guardedList
        end

        local initSafe, initGuarded = getSortedCandidateItems()
        if #initSafe == 0 and #initGuarded == 0 then
            if cb then
                cb(specificTargetName and ("Item '" .. specificTargetName .. "' tidak ada!") or "✔ Semua item prioritas sudah bersih!")
            end
            isPickingUp = false
            return
        end

        while isPickingUp and not abortTeleport and _G.TeleportGUI_Loaded do
            -- 1. Cek PanicTime: Jika waktu lift <= PanicTime (misal <= 5 detik), langsung hentikan ambil item!
            local panicReached, secLeft = isPanicDeadlineReached()
            if Config.AutoElevator and panicReached then
                if cb then cb(string.format("🚨 Panic Time (%ds <= %ds)! Wajib masuk Lift!", secLeft, Config.PanicTime or 5)) end
                break
            end

            -- 2. Cek VeeRemote Lock (jika diaktifkan dan bukan klik manual item spesifik)
            if not specificTargetName and Config.UseVeeRemoteFirst and isTrinketActive() and not isFloorAllMachinesDone() then
                if cb then cb("📺 VeeRemote masih 'Active'! Menunggu dipakai di mesin...") end
                break
            end

            -- 3. Hirarki Tertinggi: Jika ter-spot monster, wajib masuk ke tengah Thick Collider terdekat!
            if isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
            end

            local safeCandidates, guardedCandidates = getSortedCandidateItems()
            if #safeCandidates == 0 and #guardedCandidates == 0 then
                break
            end

            local chosen = safeCandidates[1]

            if not chosen then
                if moveMode == "Instant" or Config.HybridYMode then
                    chosen = guardedCandidates[1]
                else
                    if cb then cb("🛡 Sisa item dekat monster. Menunda ambil item...") end
                    break
                end
            end

            local item     = chosen.instance
            local itemPos  = chosen.pos
            local totalRem = #safeCandidates + #guardedCandidates
            pickedAnyItem  = true

            if cb then
                local prioTag = (chosen.tier == 1) and "⭐ " or (chosen.tier == 2 and "💊 " or "🎯 ")
                cb(string.format("%sAmbil %s ( %.0fm | Sisa: %d )...", prioTag, chosen.name, chosen.dist, totalRem))
            end

            local itemStandY = getTargetStandingY(itemPos.Y, false)
            local targetPos  = Vector3.new(itemPos.X, itemStandY, itemPos.Z)
            local targetCF   = CFrame.new(targetPos)

            local switchedToOtherItem = false
            local panicTriggeredMid   = false

            local function shouldRerouteToSaferItem()
                if not item or not item.Parent then return true end
                if Config.AutoElevator and isPanicDeadlineReached() then
                    panicTriggeredMid = true
                    return true
                end
                if moveMode == "Tween" and isItemAreaDangerous(item:GetPivot().Position) then
                    cooldownUntil[item] = os.clock() + 5.0
                    item:SetAttribute("MonsterItemCooldown", os.clock() + 5.0)
                    switchedToOtherItem = true
                    return true
                end
                return false
            end

            local moveInterrupted = false
            if Config.HybridYMode then
                local okHyb = executeHybridYTeleport(targetCF, function(msg) if cb then cb(msg) end end)
                if not okHyb and not abortTeleport then
                    moveInterrupted = safeSingleLayerTween(targetCF, moveSpeed, false, shouldRerouteToSaferItem)
                end
            elseif moveMode == "Tween" and Config.PathfindMode then
                moveInterrupted = pathfindTween(targetCF, nil, 0, false, shouldRerouteToSaferItem)
            elseif moveMode == "Tween" and Config.UndergroundTeleport then
                local downY = rootPart.Position.Y - Config.UGDepth
                moveInterrupted = teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
                if not moveInterrupted and not abortTeleport then
                    moveInterrupted = teleportTween(CFrame.new(targetCF.X, downY, targetCF.Z), moveSpeed, false, true, shouldRerouteToSaferItem)
                end
                if not moveInterrupted and not abortTeleport and not switchedToOtherItem then
                    moveInterrupted = teleportTween(CFrame.new(targetCF.X, itemStandY, targetCF.Z), Config.UGRiseSpeed, false, true)
                end
            elseif moveMode == "Tween" then
                moveInterrupted = safeSingleLayerTween(targetCF, moveSpeed, false, shouldRerouteToSaferItem)
            else
                teleportInstant(targetCF, false)
            end

            if abortTeleport or not isPickingUp then break end
            if panicTriggeredMid or (Config.AutoElevator and isPanicDeadlineReached()) then break end

            -- Cek Hirarki Spot Monster TERLEBIH DAHULU sebelum switchedToOtherItem!
            if isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.05)
                continue
            end

            if not item or not item.Parent then
                task.wait(0.02)
                continue
            end

            if switchedToOtherItem then
                if cb then cb("🔀 Monster di dekat " .. chosen.name .. "! Beralih ke item aman lain...") end
                task.wait(0.04)
                continue
            end

            local horizDist = Vector2.new(rootPart.Position.X - itemPos.X, rootPart.Position.Z - itemPos.Z).Magnitude
            if moveInterrupted or horizDist > 11.5 then
                skipCounts[item] = (skipCounts[item] or 0) + 1
                if skipCounts[item] >= 3 and chosen.tier ~= 1 then
                    item:SetAttribute("BlacklistLimbo", true)
                end
                task.wait(0.05)
                continue
            end

            local holdTargetPos      = rootPart.Position
            local plat               = makePlatform(holdTargetPos)
            local holdPickupConn     = startServerSyncedHold(function() return holdTargetPos end)
            local waitTicks          = 0
            local monsterInterrupted = false

            while item.Parent and waitTicks < 14 and not abortTeleport and isPickingUp do
                if Config.AutoElevator and isPanicDeadlineReached() then
                    panicTriggeredMid = true
                    break
                end
                if isThreatened() then
                    monsterInterrupted = true
                    break
                end
                if moveMode == "Tween" and isItemAreaDangerous(itemPos) then
                    cooldownUntil[item] = os.clock() + 5.0
                    item:SetAttribute("MonsterItemCooldown", os.clock() + 5.0)
                    switchedToOtherItem = true
                    break
                end

                local pp   = item:FindFirstChild("Prompt")
                local prox = pp and pp:FindFirstChild("ProximityPrompt")
                if prox and prox.Enabled then
                    interactWithPrompt(prox)
                end

                task.wait(0.06)
                waitTicks = waitTicks + 1
            end

            if holdPickupConn then holdPickupConn:Disconnect(); holdPickupConn = nil end
            clearAllServerSyncedHolds()
            if plat and plat.Parent then plat:Destroy() end
            if rootPart then rootPart.Anchored = false end

            if panicTriggeredMid or (Config.AutoElevator and isPanicDeadlineReached()) then break end

            if monsterInterrupted or isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.05)
                continue
            end

            if switchedToOtherItem then
                if cb then cb("🔀 Monster mendekat! Pindah ke item lain...") end
                task.wait(0.04)
                continue
            end

            if item.Parent then
                skipCounts[item] = (skipCounts[item] or 0) + 1
                if skipCounts[item] >= 2 and chosen.tier ~= 1 then
                    item:SetAttribute("BlacklistLimbo", true)
                end
            end

            restoreNormalGravity()
            task.wait(0.04)
        end

        clearAllServerSyncedHolds()
        if rootPart then rootPart.Anchored = false end

        -- Kembali masuk ke tengah tempat aman (Collider tebal) setelah selesai ambil item (kecuali jika waktunya masuk Lift)
        local allMachinesDone = Config.AutoElevator and isFloorAllMachinesDone() or false
        local shouldGoToElev  = allMachinesDone and (isPanicDeadlineReached() or not hasSafePickableItemsInMap())

        if pickedAnyItem and not abortTeleport and _G.TeleportGUI_Loaded and not shouldGoToElev and rootPart then
            if cb then cb("🛡 Task selesai! Kembali masuk ke tengah tempat aman...") end
            local safeCenter = moveIntoNearestColliderCenter(Config.TweenSpeed, true)
            if safeCenter and rootPart and not abortTeleport then
                local finalSafe = Vector3.new(safeCenter.X, rootPart.Position.Y, safeCenter.Z)
                if Vector2.new(rootPart.Position.X - finalSafe.X, rootPart.Position.Z - finalSafe.Z).Magnitude <= 3.0 then
                    rootPart.CFrame = CFrame.new(finalSafe)
                    if character then character:PivotTo(CFrame.new(finalSafe)) end
                end
            end
        end

        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        isPickingUp = false
        if pfStatusRef then
            pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih"
            pfStatusRef.TextColor3 = Color3.fromRGB(90, 90, 120)
        end
        if cb then
            cb(specificTargetName and ("✔ Selesai ambil " .. specificTargetName .. "!") or "✔ Semua item aman terambil!")
        end
    end)
end

