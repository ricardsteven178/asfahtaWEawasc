local function interactWithPrompt(prompt)
    pcall(function()
        prompt.RequiresLineOfSight   = false
        prompt.MaxActivationDistance = math.huge
        if fireproximityprompt then
            fireproximityprompt(prompt, 1)
        else
            prompt:InputHoldBegin()
            if prompt.HoldDuration > 0 then task.wait(prompt.HoldDuration) end
            prompt:InputHoldEnd()
        end
    end)
end

local function getItemPriorityTier(itemName)
    if not itemName then return nil end
    local lower = itemName:lower()
    if priorityLookup[itemName] or priorityLookup[lower] then
        return 1
    end
    if secondPriorityLookup[itemName] or secondPriorityLookup[lower] then
        return 2
    end
    if ignoreLookup[itemName] or ignoreLookup[lower] then
        return nil
    end
    return 3
end

local function hasSafePickableItemsInMap()
    if not (Config.Pickup and Config.Pickup.Enable) then return false end
    local map = getMap()
    local itemsFolder = map and map:FindFirstChild("Items")
    if not itemsFolder then return false end

    local nowClock = os.clock()
    for _, item in ipairs(itemsFolder:GetChildren()) do
        if item:IsA("Model") and item.Parent and not item:GetAttribute("BlacklistLimbo") and getItemPriorityTier(item.Name) ~= nil then
            local attrCd = item:GetAttribute("MonsterItemCooldown") or 0
            if nowClock >= attrCd then
                local ok, iPos = pcall(function() return item:GetPivot().Position end)
                if ok and iPos and not isItemAreaDangerous(iPos) then
                    return true
                end
            end
        end
    end
    return false
end

