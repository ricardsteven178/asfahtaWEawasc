local function makeSlider(minVal, maxVal, initialVal, step, fillCol, thumbCol, textCol, onChange)
    local row = Instance.new("Frame", content)
    row.Size                   = UDim2.new(1, 0, 0, 26)
    row.BackgroundTransparency = 1
    row.LayoutOrder            = nextLO()

    local input = Instance.new("TextBox", row)
    input.Size             = UDim2.new(0, 54, 1, 0)
    input.Position         = UDim2.new(1, -54, 0, 0)
    input.BackgroundColor3 = Color3.fromRGB(28, 28, 45)
    input.BorderSizePixel  = 0
    input.TextColor3       = textCol
    input.Font             = Enum.Font.GothamBold
    input.TextSize         = 11
    input.Text             = tostring(initialVal)
    input.ClearTextOnFocus = false
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 6)

    local track = Instance.new("Frame", row)
    track.Size             = UDim2.new(1, -62, 0, 6)
    track.Position         = UDim2.new(0, 0, 0.5, -3)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 65)
    track.BorderSizePixel  = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 4)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = fillCol
    fill.BorderSizePixel  = 0
    fill.Size             = UDim2.new(0, 0, 1, 0)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)

    local thumb = Instance.new("TextButton", track)
    thumb.Size             = UDim2.new(0, 14, 0, 14)
    thumb.BackgroundColor3 = thumbCol
    thumb.Text             = ""
    thumb.BorderSizePixel  = 0
    thumb.ZIndex           = 5
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(0, 7)

    local curVal = initialVal
    local function setVal(v)
        v      = math.clamp(math.floor(v / step + 0.5) * step, minVal, maxVal)
        v      = tonumber(string.format("%.2f", v))
        curVal = v
        local f = (v - minVal) / (maxVal - minVal)
        fill.Size      = UDim2.new(f, 0, 1, 0)
        thumb.Position = UDim2.new(f, -7, 0.5, -7)
        input.Text     = tostring(v)
        onChange(v)
    end
    setVal(initialVal)

    local dragging = false
    local dragConn = nil

    local function startDrag()
        dragging = true
        if dragConn then dragConn:Disconnect(); dragConn = nil end
        dragConn = RunService.Heartbeat:Connect(function()
            if not dragging or not _G.TeleportGUI_Loaded then
                if dragConn then dragConn:Disconnect(); dragConn = nil end
                return
            end
            local mp   = UserInputService:GetMouseLocation()
            local tSize = math.max(track.AbsoluteSize.X, 1)
            local frac = math.clamp((mp.X - track.AbsolutePosition.X) / tSize, 0, 1)
            setVal(minVal + frac * (maxVal - minVal))
        end)
    end

    thumb.MouseButton1Down:Connect(startDrag)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            if dragConn then dragConn:Disconnect(); dragConn = nil end
        end
    end)
    input.FocusLost:Connect(function()
        local v = tonumber(input.Text)
        if v then setVal(v) else input.Text = tostring(curVal) end
