end

-- Mengecek apakah pesan 'Doors opening in... X' masih aktif di TopBar.Message
local function isDoorsOpeningCountdownActive()
    local pGui = player:FindFirstChild("PlayerGui")
    if not pGui then return false end

    local screenGui = pGui:FindFirstChild("ScreenGui")
    local menu      = screenGui and screenGui:FindFirstChild("Menu")
    local topBar    = menu and menu:FindFirstChild("TopBar")
    local msgLabel  = topBar and topBar:FindFirstChild("Message")

    if msgLabel and msgLabel:IsA("TextLabel") and msgLabel.Visible then
        local txt = string.lower(tostring(msgLabel.Text or ""))
        if string.find(txt, "doors opening in", 1, true) or string.find(txt, "opening in", 1, true) then
            return true
        end
    end

    for _, gui in ipairs(pGui:GetChildren()) do
        local tb = gui:FindFirstChild("TopBar", true) or gui:FindFirstChild("InfoFrame", true)
        if tb then
            for _, d in ipairs(tb:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local txt = string.lower(tostring(d.Text or ""))
                    if string.find(txt, "doors opening in", 1, true) then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- Membaca sisa detik dari 'Quickly! Elevator leaves in X seconds!'
local function getElevatorCountdownSeconds()
    local pGui = player:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    local screenGui = pGui:FindFirstChild("ScreenGui")
    local menu      = screenGui and screenGui:FindFirstChild("Menu")
    local topBar    = menu and menu:FindFirstChild("TopBar")
    local msgLabel  = topBar and topBar:FindFirstChild("Message")

    if msgLabel and msgLabel:IsA("TextLabel") and msgLabel.Visible then
        local sec = string.match(msgLabel.Text, "Elevator leaves in (%d+)")
            or string.match(string.lower(msgLabel.Text), "leaves in (%d+)")
        if sec then
            return tonumber(sec)
        end
    end

    for _, gui in ipairs(pGui:GetChildren()) do
        local tb = gui:FindFirstChild("TopBar", true) or gui:FindFirstChild("InfoFrame", true)
        if tb then
            for _, d in ipairs(tb:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local sec = string.match(d.Text, "Elevator leaves in (%d+)")
                        or string.match(string.lower(d.Text), "leaves in (%d+)")
                    if sec then
                        return tonumber(sec)
                    end
                end
            end
        end
    end
    return nil
end

local function isPanicDeadlineReached()
    local secLeft = getElevatorCountdownSeconds()
    if secLeft ~= nil and secLeft <= (Config.PanicTime or 5) then
        return true, secLeft
    end
    return false, secLeft
end

-- Menentukan titik tengah kabin Real Elevator yang presisi (7.5 studs di belakang DoorHitbox, bebas dari tanjakan luar!)
local function getRealElevatorCFrame()
    local walkY  = (rootPart and rootPart.Position.Y > -50 and rootPart.Position.Y < 200) and rootPart.Position.Y or nil
    local curMap = getMap()

    if cachedRealElevCF and cachedRealElevRoom == curMap then
        return CFrame.new(cachedRealElevCF.X, walkY or cachedRealElevCF.Y, cachedRealElevCF.Z)
    end

    local elevatorsFolder = Workspace:FindFirstChild("Elevators")
    if elevatorsFolder then
        for _, obj in ipairs(elevatorsFolder:GetChildren()) do
            if obj.Name == "Elevator" and obj:IsA("Model") then
                local centerPos  = (obj.PrimaryPart and obj.PrimaryPart.Position) or getModelCenter(obj)
                local doorHitbox = obj:FindFirstChild("DoorHitbox", true)
                if centerPos and doorHitbox then
                    local dPos      = doorHitbox:IsA("BasePart") and doorHitbox.Position or doorHitbox:GetPivot().Position
                    local mapCenter = (curMap and getModelCenter(curMap))
                    local inwardDir
                    if mapCenter and Vector2.new(dPos.X - mapCenter.X, dPos.Z - mapCenter.Z).Magnitude > 1.0 then
                        inwardDir = Vector3.new(dPos.X - mapCenter.X, 0, dPos.Z - mapCenter.Z).Unit
                    else
                        local rawIn = Vector3.new(centerPos.X - dPos.X, 0, centerPos.Z - dPos.Z)
                        inwardDir = (rawIn.Magnitude > 0.5) and rawIn.Unit or Vector3.new(0, 0, 1)
                    end
                    local safeCabinPos = Vector3.new(dPos.X, centerPos.Y, dPos.Z) + (inwardDir * 7.5)
                    cachedRealElevCF   = CFrame.new(safeCabinPos.X, safeCabinPos.Y + 3, safeCabinPos.Z)
                    cachedRealElevRoom = curMap
                    return CFrame.new(safeCabinPos.X, walkY or (safeCabinPos.Y + 3), safeCabinPos.Z)
                elseif centerPos then
                    cachedRealElevCF   = CFrame.new(centerPos.X, centerPos.Y + 3, centerPos.Z)
                    cachedRealElevRoom = curMap
                    return CFrame.new(centerPos.X, walkY or (centerPos.Y + 3), centerPos.Z)
                end
            end
        end
        for _, obj in ipairs(elevatorsFolder:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                cachedRealElevCF   = cf
                cachedRealElevRoom = curMap
                return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
            end
        end
    end

    local room = Workspace:FindFirstChild("CurrentRoom")
    if room then
        for _, obj in ipairs(room:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local parentName = string.lower(obj.Parent and obj.Parent.Name or "")
                if not string.find(parentName, "fake") then
                    local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                    cachedRealElevCF   = cf
                    cachedRealElevRoom = curMap
                    return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
                end
            end
        end
    end
    return nil
end

local function getMachineProgress()
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        local specGui  = pGui:FindFirstChild("SpectatorGui")
        local info     = specGui and specGui:FindFirstChild("InfoFrame")
        local genFrame = info and info:FindFirstChild("GeneratorFrame")
        local msg      = genFrame and genFrame:FindFirstChild("Message")
        if msg and msg:IsA("TextLabel") then
            local cur, tot = string.match(msg.Text, "Machines Completed: (%d+)/(%d+)")
            if cur and tot then
                return tonumber(cur), tonumber(tot)
            end
        end
        for _, gui in ipairs(pGui:GetChildren()) do
            local topBar = gui:FindFirstChild("TopBar", true)
            local gf     = (topBar and topBar:FindFirstChild("GeneratorFrame")) or gui:FindFirstChild("GeneratorFrame", true)
            local m      = gf and gf:FindFirstChild("Message")
            if m and m:IsA("TextLabel") then
                local cur, tot = string.match(m.Text, "Machines Completed: (%d+)/(%d+)")
                if cur and tot then
                    return tonumber(cur), tonumber(tot)
                end
            end
        end
    end
    return -1, -1
end

local function isFloorAllMachinesDone()
    local map = getMap()
    local genFolder = map and map:FindFirstChild("Generators")
    if not genFolder then return false, -1, -1 end

    local totalGens, uncompletedCount = 0, 0
    for _, gen in ipairs(genFolder:GetChildren()) do
        if gen:IsA("Model") then
            local stats = gen:FindFirstChild("Stats")
            if stats then
                totalGens = totalGens + 1
                local completed = stats:FindFirstChild("Completed") and stats.Completed.Value
                if not completed then
                    uncompletedCount = uncompletedCount + 1
                end
            end
        end
    end

    if totalGens == 0 then return false, -1, -1 end

    local curGenUI, totGenUI = getMachineProgress()
    if curGenUI ~= -1 and totGenUI ~= -1 and totGenUI > 0 then
        return (curGenUI >= totGenUI), curGenUI, totGenUI
    end
    return (uncompletedCount == 0), (totalGens - uncompletedCount), totalGens
end

