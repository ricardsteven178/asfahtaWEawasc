local function clearAllServerSyncedHolds()
    for _, c in ipairs(activeHoldConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(activeHoldConns)
end

local function startServerSyncedHold(getTargetPosFn)
    clearAllServerSyncedHolds()
    if rootPart then rootPart.Anchored = false end
    Workspace.Gravity = 0
    local tickCounter = 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not rootPart or abortTeleport or not _G.TeleportGUI_Loaded or (not isHiding and not isPickingUp) then
            if conn then conn:Disconnect() end
            return
        end
        local holdPos = getTargetPosFn()
        if not holdPos then return end
        if (rootPart.Position - holdPos).Magnitude <= 3.8 then
            tickCounter = tickCounter + 1
            local jitterX = (tickCounter % 2 == 0) and 0.03 or -0.03
            local jitterZ = (tickCounter % 4 < 2) and 0.03 or -0.03
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = CFrame.new(holdPos.X + jitterX, holdPos.Y, holdPos.Z + jitterZ)
        end
    end)
    table.insert(activeHoldConns, conn)
    return conn
end

local function recordFailedRollbackZone(pos)
    if not pos then return end
    for _, p in ipairs(failedRollbackZones) do
        if (p - pos).Magnitude < 4.0 then return end
    end
    table.insert(failedRollbackZones, pos)
    if #failedRollbackZones > 12 then
        table.remove(failedRollbackZones, 1)
    end
end

local function teleportInstant(cf, keepZeroGravity)
    if not rootPart then return end
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity  = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.CFrame = cf
    if character then character:PivotTo(cf) end
    if not keepZeroGravity and not isPathfinding and not isHiding then
        restoreNormalGravity()
    end
end

-- Dual-Speed WalkSim & Linear Tween (Dilengkapi Proteksi Anti-Tween Drag dari Bawah Tanah & Throttled Cancel Check)
local function teleportTween(cf, speed, ignoreThreat, forceSnapEnd, customCancelFn, allowFloorPenetration)
    if not rootPart or not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    rootPart.Anchored = false

    local targetPos = cf.Position
    -- Jika karakter tertinggal di koordinat Y-Bypass bawah tanah (Y < -30) dan BUKAN sedang sengaja penetrasi lantai,
    -- wajib angkat Instant ke lantai normal dulu agar tidak pernah terkena Tween Drag miring dari bawah tanah!
    if not allowFloorPenetration and rootPart.Position.Y < -30 then
        teleportInstant(CFrame.new(rootPart.Position.X, targetPos.Y, rootPart.Position.Z), false)
        task.wait(0.02)
    end

    local startPos     = rootPart.Position
    local verticalDiff = math.abs(targetPos.Y - startPos.Y)

    local baseSpd    = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
    local origWalk   = (hum and hum.WalkSpeed > 0) and hum.WalkSpeed or 16
    local openMult   = speed or Config.TweenSpeed or 3.50
    local noclipMult = Config.NoClipTweenSpeed or 1.05

    local _, segLayers      = analyzeSegmentLayers(startPos, targetPos, nil, 1.8)
    local isSlopedStageMove = (verticalDiff > 1.8)
    local isVerticalMove    = Config.UndergroundTeleport or allowFloorPenetration or isSlopedStageMove

    local effectiveMult = (isSlopedStageMove and segLayers > 0 and not allowFloorPenetration) and math.min(openMult, noclipMult) or openMult
    local moveSpd       = baseSpd * effectiveMult
    local cancelled     = false

    local sensorParams = OverlapParams.new()
    sensorParams.FilterType = Enum.RaycastFilterType.Exclude
    sensorParams.FilterDescendantsInstances = { character }

    local function isTouchingOrApproachingObstacle(curPos, dirUnit)
        local behindPos = curPos - (dirUnit * 2.5)
        local midAhead  = curPos + (dirUnit * 3.0)
        local farAhead  = curPos + (dirUnit * 5.8)

        for _, col in ipairs(getNoClipColliders()) do
            if col and col.Parent then
                if isPointInsideExpandedBox(curPos, col, 4.2, 2.5)
                   or isPointInsideExpandedBox(behindPos, col, 3.2, 2.5)
                   or isPointInsideExpandedBox(midAhead, col, 4.2, 2.5)
                   or isPointInsideExpandedBox(farAhead, col, 3.8, 2.5) then
                    return true
                end
            end
        end

        local ok, parts = pcall(function()
            return Workspace:GetPartBoundsInBox(CFrame.new(curPos + (dirUnit * 2.2)), Vector3.new(7.2, 3.0, 7.2), sensorParams)
        end)
        if ok and parts then
            for _, p in ipairs(parts) do
                if p and p:IsA("BasePart") and not isFloorPart(p) then
                    local pn = p.Name
                    if (pn ~= "_NoClipESP" and pn ~= "_LineESPBeam" and pn ~= "_PFVirtualBlocker" and p.Transparency < 0.98)
                       or isColliderName(pn) or pn == "InvisBlock" then
                        return true
                    end
                end
            end
        end
        return false
    end

    forceCharNoClip = true
    if Config.NoClip then applyNoClipState() end

    if not isVerticalMove and hum then
        restoreNormalGravity()
        hum.PlatformStand = false
        hum.Sit           = false
        if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.None then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end

        local currentDir   = Vector3.zero
        local stepBindName = "_TeleportWalkSim"
        pcall(function() RunService:UnbindFromRenderStep(stepBindName) end)

        RunService:BindToRenderStep(stepBindName, Enum.RenderPriority.Character.Value + 10, function()
            if rootPart and hum and hum.Parent and currentDir.Magnitude > 0.01 then
                hum.WalkSpeed = moveSpd
                hum:Move(currentDir, false)
            end
        end)

        local totalDist          = Vector2.new(targetPos.X - startPos.X, targetPos.Z - startPos.Z).Magnitude
        local minSpdEst          = baseSpd * math.min(openMult, noclipMult)
        local timeoutClock       = os.clock() + math.max((totalDist / math.max(minSpdEst, 5)) * 3.0, 4.0)
        local lastPos            = rootPart.Position
        local stuckTimer         = 0
        local lastObstacleClock  = 0
        local lastSensorCheck    = 0
        local lastCancelCheck    = 0
        local cachedNearObstacle = false

        while rootPart and hum and hum.Parent and os.clock() < timeoutClock do
            -- Prioritas #1: Spot Monster / Abort
            if abortTeleport or (not ignoreThreat and isThreatened()) then
                cancelled = true
                break
            end

            -- Prioritas #2: Custom Cancel (Throttled 0.08s agar ringan di CPU)
            local nowCheck = os.clock()
            if customCancelFn and (nowCheck - lastCancelCheck) >= 0.08 then
                lastCancelCheck = nowCheck
                if customCancelFn() then
                    cancelled = true
                    break
                end
            end

            local curPos   = rootPart.Position
            local flatDiff = Vector3.new(targetPos.X - curPos.X, 0, targetPos.Z - curPos.Z)
            local dist     = flatDiff.Magnitude

            if dist <= 1.6 then
                break
            end

            currentDir = flatDiff.Unit

            local now = os.clock()
            if (now - lastSensorCheck) >= 0.07 then
                lastSensorCheck    = now
                cachedNearObstacle = isTouchingOrApproachingObstacle(curPos, currentDir)
                if cachedNearObstacle then
                    lastObstacleClock = now
                end
            end

            if cachedNearObstacle or (now - lastObstacleClock) < 0.28 or dist <= 4.5 then
                moveSpd = baseSpd * noclipMult
            else
                moveSpd = baseSpd * openMult
            end

            hum.WalkSpeed = moveSpd
            hum:Move(currentDir, false)

            local dt = RunService.Heartbeat:Wait()
            if not rootPart then break end

            if (rootPart.Position - lastPos).Magnitude < 0.08 then
                stuckTimer = stuckTimer + dt
                if stuckTimer > 0.25 then
                    applyNoClipState()
                    stuckTimer = 0
                end
            else
                stuckTimer = 0
                lastPos = rootPart.Position
            end
        end

        currentDir = Vector3.zero
        pcall(function() RunService:UnbindFromRenderStep(stepBindName) end)
        if hum and hum.Parent then
            hum:Move(Vector3.zero, false)
            hum.WalkSpeed = origWalk
        end
    else
        Workspace.Gravity = 0
        local dist = (startPos - targetPos).Magnitude
        local dur  = math.max(dist / math.max(moveSpd, 1), 0.001)
        local tw   = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
        activeTween = tw
        tw:Play()

        local done = false
        tw.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed then done = true end
        end)

        while not done do
            if abortTeleport or (not ignoreThreat and isThreatened()) then
                tw:Cancel()
                cancelled = true
                break
            end
            if customCancelFn and customCancelFn() then
                tw:Cancel()
                cancelled = true
                break
            end
            task.wait(0.015)
        end

        if not cancelled and rootPart and (rootPart.Position - targetPos).Magnitude <= 4.0 then
            rootPart.CFrame = cf
        end
        if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end
        if activeTween == tw then activeTween = nil end
    end

    if not Config.NoClip and not isHiding then
        forceCharNoClip = false
    end
    if not isPathfinding and not isHiding and not allowFloorPenetration then
        restoreNormalGravity()
    end

    return cancelled
end

local function moveIntoNearestColliderCenter(speed, ignoreThreat, excludedCol)
    if not rootPart then return nil, nil end
    rootPart.Anchored = false
    local startPos  = clampPositionAboveFloor(rootPart.Position)
    local hideRoute = getNearestSafeColliderRoute(startPos, excludedCol)
    local targetCol = hideRoute.targetCol

    setTargetColliderPassable(targetCol, true)
    local moveSpd = speed or math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)

    for i, wpPos in ipairs(hideRoute.waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then break end
        local isLast = (i == #hideRoute.waypoints)
        local cancelled = teleportTween(CFrame.new(wpPos), moveSpd, ignoreThreat, isLast)
        if cancelled and not ignoreThreat then
            return nil, hideRoute
        end
    end

    if rootPart and hideRoute.centerPos and not abortTeleport then
        if (rootPart.Position - hideRoute.centerPos).Magnitude <= 3.8 then
            rootPart.CFrame = CFrame.new(hideRoute.centerPos)
            if character then character:PivotTo(CFrame.new(hideRoute.centerPos)) end
        end
    end
    return hideRoute.centerPos, hideRoute
end

-- ==============================================================================
-- [UPGRADED HYBRID ENGINE]: MENDUKUNG 2 MODE SESUAI CHECKBOX GUI!
-- 1. Jika Config.HybridFreefallMode == false (Default):
--    Tween ke Collider -> Instant ke Y-Bypass (-241) -> 100% Instant Snap ke Tujuan.
-- 2. Jika Config.HybridFreefallMode == true (Checkbox Dicentang):
--    Tween menembus lantai tepat di tempat berdiri saat itu -> Freefall (Jatuh Bebas) ->
--    Sebelum sampai dasar, langsung 100% Instant Snap ke Tujuan!
-- ==============================================================================
local function executeHybridYTeleport(targetCF, statusFn)
    if not rootPart then return false end

    local centerPos = rootPart.Position

    if Config.HybridFreefallMode then
        -- ======================================================================
        -- [MODE CHECKBOX ON]: TWEEN TEMBUS LANTAI PIJAKAN + FREEFALL + INSTANT TP
        -- ======================================================================
        local standPos  = rootPart.Position
        local waitDelay = math.max(Config.HybridBypassDelay or 0.40, 0.08)
        local bottomY   = Config.HybridBypassY or -241

        if statusFn then
            statusFn("1/3 🕳 Tween menembus lantai pijakan...", Color3.fromRGB(255, 200, 80))
        end

        -- Matikan CanCollide pada lantai tepat di bawah kaki karakter
        setFloorBeneathPassable(standPos, true)

        -- Tween lurus ke bawah menembus lantai tempat karakter berdiri saat itu (sekitar 9.5 studs ke bawah lantai)
        local penetrateCF = CFrame.new(standPos.X, standPos.Y - 9.5, standPos.Z)
        teleportTween(penetrateCF, math.max(Config.UGRiseSpeed or 1.5, 1.35), true, true, nil, true)

        if abortTeleport or not rootPart or not _G.TeleportGUI_Loaded then
            setFloorBeneathPassable(nil, false)
            restoreNormalGravity()
            return false
        end

        -- Aktifkan Freefall alami dengan gravitasi normal
        restoreNormalGravity()
        if not rootPart or not rootPart.Parent then
            setFloorBeneathPassable(nil, false)
            return false
        end
        rootPart.Anchored = false
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end
        -- Beri dorongan awal ke bawah agar langsung jatuh bebas tanpa nyangkut
        rootPart.AssemblyLinearVelocity = Vector3.new(0, -55, 0)

        local fallStart = os.clock()
        local safetyBottomLimit = math.max(bottomY + 25, standPos.Y - 85)

        while (os.clock() - fallStart) < waitDelay and not abortTeleport and _G.TeleportGUI_Loaded do
            if not rootPart then break end
            -- Sebelum jatuh terlalu jauh / menyentuh batas bawah, langsung hentikan freefall untuk teleport ke tujuan!
            if rootPart.Position.Y <= safetyBottomLimit then
                break
            end
            local remain = math.max(waitDelay - (os.clock() - fallStart), 0)
            if statusFn then
                statusFn(string.format("2/3 🪂 Freefall (Y=%.0f | %.2fs)...", rootPart.Position.Y, remain), Color3.fromRGB(120, 220, 255))
            end
            task.wait(0.03)
        end

        -- Kembalikan lantai seperti semula
        setFloorBeneathPassable(nil, false)
    else
        -- ======================================================================
        -- [MODE CHECKBOX OFF]: HYBRID NORMAL (COLLIDER -> INSTANT Y-BYPASS)
        -- ======================================================================
        if statusFn then statusFn("1/3 🛡 Menuju tengah Collider tebal terdekat...", Color3.fromRGB(255, 190, 80)) end
        local cPos = moveIntoNearestColliderCenter(Config.TweenSpeed, false)
        if abortTeleport or not rootPart then
            setTargetColliderPassable(nil, false)
            restoreNormalGravity()
            return false
        end

        if not cPos then
            cPos = moveIntoNearestColliderCenter(math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5), true)
        end
        centerPos = cPos or rootPart.Position
        task.wait(0.04)

        local bypassY   = Config.HybridBypassY or -241
        local waitDelay = math.max(Config.HybridBypassDelay or 0.4, 0.05)
        local bypassCF  = CFrame.new(centerPos.X, bypassY, centerPos.Z)

        Workspace.Gravity = 0
        teleportInstant(bypassCF, true)

        local holdConn = RunService.Heartbeat:Connect(function()
            if rootPart and not abortTeleport then
                rootPart.AssemblyLinearVelocity  = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
                rootPart.CFrame = bypassCF
            end
        end)

        local elapsed = 0
        while elapsed < waitDelay and not abortTeleport and _G.TeleportGUI_Loaded do
            local remain = math.max(waitDelay - elapsed, 0)
            if statusFn then
                statusFn(string.format("2/3 ⏳ Stay di Y=%.0f (%.2fs)...", bypassY, remain), Color3.fromRGB(120, 220, 255))
            end
            local step = math.min(0.05, waitDelay - elapsed)
            task.wait(step)
            elapsed = elapsed + step
        end

        if holdConn then holdConn:Disconnect() end
    end

    if abortTeleport or not rootPart then
        setFloorBeneathPassable(nil, false)
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    -- ==========================================================================
    -- TAHAP 3/3 (KEDUA MODE): 100% INSTANT SNAP KE TUJUAN SEBENARNYA!
    -- ==========================================================================
    local destPos     = targetCF.Position
    local finalDestCF = CFrame.new(destPos)
    if statusFn then
        statusFn(string.format("3/3 💥 Instant TP ke (%.0f, %.0f, %.0f)!", destPos.X, destPos.Y, destPos.Z), Color3.fromRGB(100, 255, 160))
    end

    Workspace.Gravity = 0
    local snapDestConn = RunService.Heartbeat:Connect(function()
        if rootPart and not abortTeleport and _G.TeleportGUI_Loaded then
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = finalDestCF
        end
    end)
    task.wait(0.18)
    if snapDestConn then snapDestConn:Disconnect() end
    teleportInstant(finalDestCF, false)

    setTargetColliderPassable(nil, false)
    restoreNormalGravity()

    task.wait(0.12)
    if rootPart then
        local flatDist = Vector2.new(rootPart.Position.X - destPos.X, rootPart.Position.Z - destPos.Z).Magnitude
        if flatDist <= 8.0 and rootPart.Position.Y > -30 then
            return true
        end
        if rootPart.Position.Y < -30 then
            teleportInstant(CFrame.new(centerPos.X, centerPos.Y, centerPos.Z), false)
            task.wait(0.05)
        end
    end

    return false
end

-- Deteksi Elevator & DoorHitbox untuk Auto-Exit di awal floor
local function getElevatorAndDoorHitbox()
    if not rootPart then return false, nil, nil, nil end
    local elevatorsFolder = Workspace:FindFirstChild("Elevators")
    if not elevatorsFolder then return false, nil, nil, nil end

    for _, el in ipairs(elevatorsFolder:GetChildren()) do
        if el.Name == "Elevator" and el:IsA("Model") then
            local cPos       = (el.PrimaryPart and el.PrimaryPart.Position) or getModelCenter(el)
            local doorHitbox = el:FindFirstChild("DoorHitbox", true)
            if cPos then
                local flatDist = Vector2.new(rootPart.Position.X - cPos.X, rootPart.Position.Z - cPos.Z).Magnitude
                if flatDist <= 16.5 and math.abs(rootPart.Position.Y - cPos.Y) <= 15 then
                    return true, el, cPos, doorHitbox
                end
            end
        end
    end
    return false, nil, nil, nil
end

local function isCurrentlyInsideElevator()
    local inside = getElevatorAndDoorHitbox()
    return inside
end

ensureExitedElevator = function(statusFn)
    if not Config.AutoExitElevator or not rootPart or inElevatorStandby then return end

    local map = getMap()
    local isInside, insideElevatorModel, elevCenterPos, doorHitbox = getElevatorAndDoorHitbox()

    if not isInside or not insideElevatorModel or not elevCenterPos then
        if map then exitedElevatorFloorMap = map end
        return
    end

    exitedElevatorFloorMap = nil

    local waitMapClock = os.clock()
    while _G.TeleportGUI_Loaded and not abortTeleport and (os.clock() - waitMapClock) < 4.0 do
        map = getMap()
        local gf = map and map:FindFirstChild("Generators")
        if gf and #gf:GetChildren() > 0 then break end
        task.wait(0.15)
    end

    -- [METODE 1]: Bypass Keluar Lift via Teleport ke Mesin (Max 1x Coba Per Floor)
    if Config.UseGenTeleportExit and map and triedGenExitFloorMap ~= map and rootPart and not abortTeleport and _G.TeleportGUI_Loaded then
        triedGenExitFloorMap = map
        local genFolder = map:FindFirstChild("Generators")
        if genFolder then
            local bestGen, bestGenCF = nil, nil
            local bestDist = math.huge
            local veeActiveNow = Config.UseVeeRemoteFirst and isTrinketActive()

            for _, g in ipairs(genFolder:GetChildren()) do
                if g:IsA("Model") then
                    local st   = g:FindFirstChild("Stats")
                    local comp = st and st:FindFirstChild("Completed") and st.Completed.Value
                    local conn = st and st:FindFirstChild("Connie") and st.Connie.Value
                    if not comp and not conn and not isMachineOccupied(g, Config.PlayerRadius, veeActiveNow) then
                        local gCF = getGeneratorTargetCFrame(g)
                        if gCF and not isThreatened(gCF.Position, Config.GeneratorSafeRadius or 18) and not isNearLethalMonster(gCF.Position, 2) then
                            local d = (rootPart.Position - gCF.Position).Magnitude
                            if d < bestDist then
                                bestDist  = d
                                bestGen   = g
                                bestGenCF = gCF
                            end
                        end
                    end
                end
            end

            if bestGen and bestGenCF then
                if statusFn then statusFn("🚀 Mencoba Bypass Keluar Lift via Mesin...") end
                local startElevPos = rootPart.Position
                local bypassY      = Config.HybridBypassY or -241
                local waitDelay    = math.max(Config.HybridBypassDelay or 0.40, 0.10)
                local bypassCF     = CFrame.new(startElevPos.X, bypassY, startElevPos.Z)

                Workspace.Gravity = 0
                teleportInstant(bypassCF, true)
                local holdConn = RunService.Heartbeat:Connect(function()
                    if rootPart and not abortTeleport and _G.TeleportGUI_Loaded then
                        rootPart.AssemblyLinearVelocity  = Vector3.zero
                        rootPart.AssemblyAngularVelocity = Vector3.zero
                        rootPart.CFrame = bypassCF
                    end
                end)

                task.wait(waitDelay)
                if holdConn then holdConn:Disconnect() end

                if rootPart and not abortTeleport and _G.TeleportGUI_Loaded then
                    local snapConn = RunService.Heartbeat:Connect(function()
                        if rootPart and not abortTeleport and _G.TeleportGUI_Loaded then
                            rootPart.AssemblyLinearVelocity  = Vector3.zero
                            rootPart.AssemblyAngularVelocity = Vector3.zero
                            rootPart.CFrame = bestGenCF
                        end
                    end)
                    task.wait(0.18)
                    if snapConn then snapConn:Disconnect() end
                    teleportInstant(bestGenCF, false)
                    restoreNormalGravity()
                    task.wait(0.22)

                    local stillInAfterBypass = getElevatorAndDoorHitbox()
                    if not stillInAfterBypass and rootPart and rootPart.Position.Y > -30 then
                        exitedElevatorFloorMap = getMap()
                        floorStartTimestamp    = os.clock()
                        return
                    else
                        if rootPart and rootPart.Position.Y < -30 then
                            teleportInstant(CFrame.new(startElevPos.X, startElevPos.Y, startElevPos.Z), false)
                            task.wait(0.05)
                        end
                    end
                end
            end
        end
    end

    -- [METODE 2 - FALLBACK STABIL]: Wajib Tunggu 'Doors opening in...' Selesai, Lalu Jalan Lewat DoorHitbox!
    if isDoorsOpeningCountdownActive() then
        if statusFn then statusFn("⏳ Menunggu pintu lift terbuka ('Doors opening in...')...") end
        local waitDoorClock = os.clock()
        while isDoorsOpeningCountdownActive() and (os.clock() - waitDoorClock) < 12.0 and _G.TeleportGUI_Loaded and not abortTeleport do
            task.wait(0.15)
        end
        task.wait(0.20)
    end

    if statusFn then statusFn("🚪 Berjalan keluar melewati DoorHitbox Lift...") end

    for _ = 1, 8 do
        if abortTeleport or not _G.TeleportGUI_Loaded or not rootPart or inElevatorStandby then break end

        while isDoorsOpeningCountdownActive() and _G.TeleportGUI_Loaded and not abortTeleport do
            task.wait(0.15)
        end

        local stillIn, elModel, cPos, dHitbox = getElevatorAndDoorHitbox()
        if not stillIn then
            exitedElevatorFloorMap = getMap()
            floorStartTimestamp    = os.clock()
            return
        end

        elevCenterPos = cPos
        doorHitbox    = dHitbox or elModel:FindFirstChild("DoorHitbox", true)

        if doorHitbox then
            if doorHitbox:IsA("BasePart") then doorHitbox.CanCollide = false end
            for _, d in ipairs(doorHitbox:GetDescendants()) do
                if d:IsA("BasePart") then d.CanCollide = false end
            end
        end
        for _, desc in ipairs(elModel:GetDescendants()) do
            if desc:IsA("BasePart") and not isFloorPart(desc) then
                local ln = desc.Name:lower()
                if ln:find("door") or ln:find("gate") or ln:find("invis") then
                    desc.CanCollide = false
                end
            end
        end

        local walkY   = getSafeWalkY(rootPart.Position.Y)
        local doorPos = nil

        if doorHitbox then
            if doorHitbox:IsA("BasePart") then
                doorPos = doorHitbox.Position
            elseif doorHitbox:IsA("Model") then
                doorPos = (doorHitbox.PrimaryPart and doorHitbox.PrimaryPart.Position) or getModelCenter(doorHitbox) or doorHitbox:GetPivot().Position
            end
        end

        local exitDir
        if doorPos and Vector2.new(doorPos.X - elevCenterPos.X, doorPos.Z - elevCenterPos.Z).Magnitude > 0.5 then
            exitDir = Vector3.new(doorPos.X - elevCenterPos.X, 0, doorPos.Z - elevCenterPos.Z).Unit
        else
            local curMap  = getMap()
            local mCenter = (curMap and getModelCenter(curMap)) or (elevCenterPos + Vector3.new(0, 0, 30))
            exitDir = Vector3.new(mCenter.X - elevCenterPos.X, 0, mCenter.Z - elevCenterPos.Z).Unit
            doorPos = elevCenterPos + (exitDir * 8.5)
        end

        local preDoorCenter = Vector3.new(doorPos.X, walkY, doorPos.Z) - (exitDir * 4.0)
        local onDoorPoint   = Vector3.new(doorPos.X, walkY, doorPos.Z) + (exitDir * 1.5)
        local outsidePoint  = Vector3.new(doorPos.X, walkY, doorPos.Z) + (exitDir * 18.0)

        teleportTween(CFrame.new(preDoorCenter), Config.TweenSpeed, true, true)
        if not abortTeleport and _G.TeleportGUI_Loaded then
            teleportTween(CFrame.new(onDoorPoint), Config.TweenSpeed, true, true)
        end
        if not abortTeleport and _G.TeleportGUI_Loaded then
            teleportTween(CFrame.new(outsidePoint), Config.TweenSpeed, true, true)
        end

        local checkStillIn = getElevatorAndDoorHitbox()
        if not checkStillIn then
            exitedElevatorFloorMap = getMap()
            floorStartTimestamp    = os.clock()
            return
        end

        task.wait(0.25)
    end
end

local function safeSingleLayerTween(targetCF, speed, ignoreThreat, customCancelFn)
    if not rootPart then return false end

    ensureExitedElevator()
    if abortTeleport or not _G.TeleportGUI_Loaded or not rootPart then return true end

    local walkY    = getSafeWalkY(rootPart.Position.Y)
    local goalY    = getTargetStandingY(targetCF.Position.Y, true)
    local startPos = Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z)
    local goalPos  = Vector3.new(targetCF.Position.X, goalY, targetCF.Position.Z)

    local goalCol = nil
    for _, col in ipairs(getNoClipColliders()) do
        if col and col.Parent and isPointInsideExpandedBox(goalPos, col, 1.5, 2.0) then
            goalCol = col
            break
        end
    end

    local routeWps, okOneLayer, penetratedCol = buildSmartOneLayerRoute(startPos, goalPos, goalCol)

    if okOneLayer and #routeWps > 0 then
        if penetratedCol then setTargetColliderPassable(penetratedCol, true) end
        if goalCol then setTargetColliderPassable(goalCol, true) end
        forceCharNoClip = true

        local cancelled = false
        for i, wp in ipairs(routeWps) do
            if abortTeleport or not _G.TeleportGUI_Loaded then
                cancelled = true
                break
            end
            clearPathVisuals()
            drawWaypoint(wp, (i == #routeWps) and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(80, 200, 255))
            cancelled = teleportTween(CFrame.new(wp), speed or Config.TweenSpeed, ignoreThreat, true, customCancelFn)
            if cancelled or abortTeleport then
                break
            end
        end

        clearPathVisuals()
        setTargetColliderPassable(nil, false)

        if abortTeleport then return true end

        if cancelled then
            if not isPickingUp and not ignoreThreat and isThreatened() then
                local resumed = performColliderHide(function(txt, col)
                    if pfStatusRef then pfStatusRef.Text = txt; pfStatusRef.TextColor3 = col or Color3.fromRGB(255, 180, 80) end
                end)
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded then
                    return safeSingleLayerTween(targetCF, speed, ignoreThreat, customCancelFn)
                end
                return true
            end
            if customCancelFn and customCancelFn() then
                return true
            end
            return true
        end

        task.wait(0.03)
        if rootPart and Vector2.new(rootPart.Position.X - goalPos.X, rootPart.Position.Z - goalPos.Z).Magnitude <= 6.5 then
            return false
        else
            recordFailedRollbackZone(routeWps[1])
        end
    end

    if not isPathfinding and not abortTeleport then
        if pfStatusRef then
            pfStatusRef.Text = "🔄 >=2 Lapis terdeteksi! Memutar tanpa tembus..."
            pfStatusRef.TextColor3 = Color3.fromRGB(255, 190, 70)
        end
        return pathfindTween(CFrame.new(goalPos), nil, 1, true, customCancelFn)
    end

    return false
end

performColliderHide = function(statusFn)
    if isHiding or not rootPart or hasVerifiedInElevator or (inElevatorStandby and isPanicDeadlineReached()) then return false end
    rootPart.Anchored = false
    isHiding = true
    local preHidePos = rootPart.Position

    local hideSpeed = math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)
    local centerPos, hideRoute = moveIntoNearestColliderCenter(hideSpeed, true)
    if abortTeleport or not _G.TeleportGUI_Loaded then
        isHiding = false
        clearAllServerSyncedHolds()
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    local targetCol    = hideRoute and hideRoute.targetCol
    local pName        = (targetCol and targetCol.Parent and targetCol.Parent.Name) or (targetCol and targetCol.Name) or "Collider"
    local finalHidePos = (rootPart and centerPos and (rootPart.Position - centerPos).Magnitude <= 4.5) and rootPart.Position or (centerPos or rootPart.Position)

    local hidePlat = Instance.new("Part")
    hidePlat.Size         = Vector3.new(10, 1, 10)
    hidePlat.Anchored     = true
    hidePlat.CanCollide   = true
    hidePlat.Transparency = 1
    hidePlat.CFrame       = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
    hidePlat.Parent       = Workspace

    local syncConn = startServerSyncedHold(function() return finalHidePos end)
    local syncRetryCount = 0

    local function verifyAndFixRealHidePosition()
        if not rootPart or abortTeleport or not _G.TeleportGUI_Loaded or syncRetryCount >= 1 then return end
        local desyncDist = (rootPart.Position - finalHidePos).Magnitude
        if desyncDist > 4.5 then
            syncRetryCount = syncRetryCount + 1
            if syncConn then syncConn:Disconnect(); syncConn = nil end
            if statusFn then statusFn("⚠ Sinkronisasi fisik ke tengah " .. pName .. "...", Color3.fromRGB(255, 160, 60)) end
            setTargetColliderPassable(targetCol, true)
            teleportTween(CFrame.new(finalHidePos), hideSpeed * 0.85, true, true)
            if rootPart and not abortTeleport then
                finalHidePos = rootPart.Position
                syncConn = startServerSyncedHold(function() return finalHidePos end)
            end
        end
    end

    if statusFn then statusFn("🛡 Sembunyi di tengah " .. pName .. ", pantau Logo Mata...", Color3.fromRGB(220, 80, 80)) end
    local hideStartClock   = os.clock()
    local lastSpottedClock = os.clock()
    local spotClearBuffer  = Config.SpotClearBuffer or 1.5
    local didSmartReroute  = false

    while isThreatened() and (os.clock() - hideStartClock) < 22 and not abortTeleport and _G.TeleportGUI_Loaded do
        if isFloorAllMachinesDone() and isPanicDeadlineReached() then
            didSmartReroute = true
            break
        end

        verifyAndFixRealHidePosition()
        if hidePlat and hidePlat.Parent and rootPart then
            hidePlat.CFrame = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
        end

        if isPlayerSpotted() then
            lastSpottedClock = os.clock()
        elseif Config.SmartRerouteOnHide and (os.clock() - lastSpottedClock) >= spotClearBuffer then
            if getMinDistanceToMonsters(finalHidePos) > 16.0 then
                didSmartReroute = true
                break
            end
        end

        task.wait(0.2)
    end

    if not didSmartReroute then
        if statusFn and not abortTeleport then
            statusFn("⏳ Tunggu " .. Config.MonsterSafeDelay .. "s sebelum keluar collider...", Color3.fromRGB(180, 180, 60))
        end
        local safeStartClock = os.clock()
        while (os.clock() - safeStartClock) < Config.MonsterSafeDelay and (os.clock() - hideStartClock) < 30 and not abortTeleport and _G.TeleportGUI_Loaded do
            if isFloorAllMachinesDone() and isPanicDeadlineReached() then
                break
            end
            if isPlayerSpotted() then
                lastSpottedClock = os.clock()
                safeStartClock   = os.clock()
            elseif isThreatened() then
                if Config.SmartRerouteOnHide and (os.clock() - lastSpottedClock) >= spotClearBuffer and getMinDistanceToMonsters(finalHidePos) > 16.0 then
                    break
                end
                safeStartClock = os.clock()
            end
            task.wait(0.2)
        end
    end

    clearAllServerSyncedHolds()
    if hidePlat and hidePlat.Parent then hidePlat:Destroy() end
    if rootPart then rootPart.Anchored = false end
    isHiding = false

    if abortTeleport or not _G.TeleportGUI_Loaded then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if not Config.HybridYMode or not Config.NoClip then
        if statusFn then statusFn("↩ Aman! Keluar ke ruang terbuka...", Color3.fromRGB(100, 220, 150)) end
        local bestExitPos = targetCol and findSafeExitPointOutsideCollider(preHidePos, finalHidePos, targetCol) or (hideRoute and hideRoute.exitPos)
        if bestExitPos then
            teleportTween(CFrame.new(bestExitPos), Config.TweenSpeed, true, true)
        end
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        task.wait(0.1)
    else
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
    end

    return true
end

pathfindTween = function(targetCF, statusCb, _attempt, skipFirstLayerTry, customCancelFn)
    if isPathfinding or not rootPart then return false end
    isPathfinding = true
    abortTeleport = false
    clearPathVisuals()
    updateColliderCaches(false)

    local function setStatus(txt, col)
        if pfStatusRef then
            pfStatusRef.Text       = txt
            pfStatusRef.TextColor3 = col or Color3.fromRGB(160, 120, 255)
        end
        if statusCb then statusCb(txt) end
    end

    local walkY         = getSafeWalkY(rootPart.Position.Y)
    local targetY       = getTargetStandingY(targetCF.Position.Y, true)
    local startFlat     = Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z)
    local computeTarget = Vector3.new(targetCF.Position.X, targetY, targetCF.Position.Z)
    local attempt       = _attempt or 0
    local comboMode     = Config.PathfindMode and Config.UndergroundTeleport

    if attempt == 0 and not skipFirstLayerTry and not comboMode then
        local goalCol = nil
        for _, col in ipairs(cachedAllCols) do
            if col and col.Parent and isPointInsideExpandedBox(computeTarget, col, 1.5, 2.0) then
                goalCol = col
                break
            end
        end

        local okDirect, layerCount, hitCol = analyzeSegmentLayers(startFlat, computeTarget, goalCol, 1.35)
        if okDirect and layerCount <= 1 then
            setStatus("⚡ Jalur 1-Lapis aman! Tembus NoClip langsung...", Color3.fromRGB(100, 240, 160))
            if hitCol then setTargetColliderPassable(hitCol, true) end
            if goalCol then setTargetColliderPassable(goalCol, true) end
            forceCharNoClip = true

            drawWaypoint(computeTarget, Color3.fromRGB(0, 255, 120))
            local isInterrupted = teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true, customCancelFn)
            clearPathVisuals()
            setTargetColliderPassable(nil, false)

            if isInterrupted then
                if abortTeleport or not _G.TeleportGUI_Loaded then
                    isPathfinding = false
                    restoreNormalGravity()
                    return true
                end
                if isThreatened() then
                    restoreNormalGravity()
                    isPathfinding = false
                    local resumed = performColliderHide(setStatus)
                    if resumed and not abortTeleport and _G.TeleportGUI_Loaded then
                        return pathfindTween(targetCF, statusCb, 1, true, customCancelFn)
                    end
                    return true
                end
                if customCancelFn and customCancelFn() then
                    isPathfinding = false
                    restoreNormalGravity()
                    return true
                end
            end

            task.wait(0.05)
            if rootPart and (rootPart.Position - computeTarget).Magnitude <= 5.5 then
                isPathfinding = false
                restoreNormalGravity()
                setStatus("✔ Tembus 1-Lapis selesai!", Color3.fromRGB(100, 220, 150))
                task.delay(1.5, function()
                    if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih" end
                end)
                return false
            else
                setStatus("🔄 Tembus gagal (>=2 Lapis), beralih ke rute memutar...", Color3.fromRGB(255, 180, 60))
            end
        end
    end

    local currentParams = (attempt >= 2) and AGENT_PARAMS_LASTRESORT
                       or (attempt == 1) and AGENT_PARAMS_FALLBACK
                       or AGENT_PARAMS

    for _, col in ipairs(cachedAllCols) do
        if col and col:IsA("BasePart") then col.CanCollide = true end
    end

    local tempVirtualBlockers = {}
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        local looseSize = (Config.LooseRadius or 10) * 1.9
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") and isLooseMonsterName(m.Name) then
                local mp = getMonsterPart(m)
                if mp and rootPart and (mp.Position - rootPart.Position).Magnitude > 3.0 and (mp.Position - computeTarget).Magnitude > 4.0 then
                    local mb = Instance.new("Part")
                    mb.Name         = "_PFVirtualBlocker"
                    mb.Size         = Vector3.new(looseSize, 12, looseSize)
                    mb.Position     = mp.Position
                    mb.Anchored     = true
                    mb.CanCollide   = true
                    mb.Transparency = 1
                    mb.Parent       = Workspace
                    table.insert(tempVirtualBlockers, mb)
                end
            end
        end
    end

    local path = PathfindingService:CreatePath(currentParams)
    local ok   = pcall(function() path:ComputeAsync(startFlat, computeTarget) end)

    for _, vb in ipairs(tempVirtualBlockers) do
        pcall(function() vb:Destroy() end)
    end

    if Config.NoClip then
        applyNoClipState()
    else
        for _, col in ipairs(cachedAllCols) do
            if col and col:IsA("BasePart") then col.CanCollide = true end
        end
    end

    if not ok or path.Status ~= Enum.PathStatus.Success then
        if attempt < 2 then
            isPathfinding = false
            task.wait(0.05)
            return pathfindTween(targetCF, statusCb, attempt + 1, true, customCancelFn)
        else
            setStatus("⚠ Rute sempit, paksa gerak ke tujuan...", Color3.fromRGB(220, 140, 60))
            forceCharNoClip = true
            local cancelled = teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true, customCancelFn)
            forceCharNoClip = false
            isPathfinding = false
            restoreNormalGravity()
            return cancelled
        end
    end

    local rawWaypoints = path:GetWaypoints()
    if #rawWaypoints == 0 then
        isPathfinding = false
        local cancelled = teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true, customCancelFn)
        restoreNormalGravity()
        return cancelled
    end

    local flatWaypoints = {}
    for i = 1, #rawWaypoints do
        local rawY     = rawWaypoints[i].Position.Y + 3.0
        local wpHeight = (math.abs(rawY - walkY) <= 1.8) and walkY or rawY
        table.insert(flatWaypoints, Vector3.new(rawWaypoints[i].Position.X, wpHeight, rawWaypoints[i].Position.Z))
    end

    local optimizedWps = {}
    local curIdx = 1
    while curIdx < #flatWaypoints do
        local nextIdx    = curIdx + 1
        local maxAllowed = (attempt == 0) and 1 or 0
        for j = #flatWaypoints, curIdx + 2, -1 do
            local okSeg, segLayers = analyzeSegmentLayers(flatWaypoints[curIdx], flatWaypoints[j], nil, 1.4)
            if okSeg and segLayers <= maxAllowed then
                nextIdx = j
                break
            end
        end
        table.insert(optimizedWps, flatWaypoints[nextIdx])
        curIdx = nextIdx
    end

    setStatus("🔵 Pathfinding (" .. #optimizedWps .. " titik)...", Color3.fromRGB(160, 120, 255))
    Workspace.Gravity = 0

    for i, wpPos in ipairs(optimizedWps) do
        if abortTeleport or not _G.TeleportGUI_Loaded then
            setStatus("🛑 Dibatalkan", Color3.fromRGB(220, 80, 80))
            break
        end

        local wpY  = (comboMode or Config.UndergroundTeleport) and (wpPos.Y - Config.UGDepth) or wpPos.Y
        local wpCF = CFrame.new(wpPos.X, wpY, wpPos.Z)

        drawWaypoint(wpPos, i == #optimizedWps and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 200, 0))

        local isInterrupted = teleportTween(wpCF, Config.TweenSpeed, false, true, customCancelFn)
        if isInterrupted then
            if abortTeleport or not _G.TeleportGUI_Loaded then break end
            if isThreatened() then
                restoreNormalGravity()
                isPathfinding = false
                local resumed = performColliderHide(setStatus)
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded and attempt < 2 then
                    task.wait(0.1)
                    return pathfindTween(targetCF, statusCb, attempt + 1, true, customCancelFn)
                end
                return true
            end
            if customCancelFn and customCancelFn() then
                isPathfinding = false
                restoreNormalGravity()
                return true
            end
        end
    end

    isPathfinding = false
    restoreNormalGravity()
    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end

    if not abortTeleport and rootPart then
        local fp = computeTarget
        if comboMode then
            teleportTween(CFrame.new(fp.X, walkY, fp.Z), Config.UGRiseSpeed, false, true)
        end
        setStatus("✔ Pathfind selesai!", Color3.fromRGB(100, 220, 150))
        task.delay(2, function()
            if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih" end
            clearPathVisuals()
        end)
    end

    abortTeleport = false
    return false
end

local function doTeleport(cf, mode, speed)
    ensureExitedElevator(function(txt)
        if pfStatusRef then pfStatusRef.Text = txt; pfStatusRef.TextColor3 = Color3.fromRGB(120, 220, 255) end
    end)
    if abortTeleport or not rootPart then return end

    if Config.HybridYMode then
        local okHyb = executeHybridYTeleport(cf, function(txt, col)
            if pfStatusRef then pfStatusRef.Text = txt; pfStatusRef.TextColor3 = col or Color3.fromRGB(120, 220, 255) end
        end)
        if okHyb or abortTeleport then return end
        if pfStatusRef then pfStatusRef.Text = "🔄 Hybrid ditolak server, beralih ke Tween..."; pfStatusRef.TextColor3 = Color3.fromRGB(255, 190, 80) end
    end

    if mode == "Tween" and Config.PathfindMode then
        task.spawn(function() pathfindTween(cf, nil, 0, false) end)
        return
    end

    if Config.UndergroundTeleport and mode == "Tween" then
        if not rootPart then return end
        local target = cf.Position
        local downY  = rootPart.Position.Y - Config.UGDepth
        teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
        if abortTeleport then restoreNormalGravity(); return end
        teleportTween(CFrame.new(target.X, downY, target.Z), speed, false, true)
        if abortTeleport then restoreNormalGravity(); return end
        teleportTween(CFrame.new(target.X, target.Y + 3.1, target.Z), Config.UGRiseSpeed, false, true)
        restoreNormalGravity()
        return
    end

    local finalCF = Config.UndergroundTeleport and CFrame.new(cf.Position.X, cf.Position.Y - Config.UGDepth, cf.Position.Z) or cf
    if mode == "Tween" then
        safeSingleLayerTween(finalCF, speed, false)
    else
        teleportInstant(finalCF, false)
    end
    restoreNormalGravity()
end

