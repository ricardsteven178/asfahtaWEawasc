-- ==============================================================================
-- EKSEKUSI TWEEN 1-LAPIS NOCLIP PRIORITAS + FALLBACK NAVMESH (ANTI-DIAM DI TEMPAT)
-- 1. Coba jalur tembus 1-lapis (atau lurus ruang terbuka) terlebih dahulu.
-- 2. Jika terhalang >= 2 lapis benda berdekatan atau mental balik, otomatis gunakan NavMesh memutar!
-- ==============================================================================
local function safeSingleLayerTween(targetCF, speed, ignoreThreat)
    if not rootPart then return false end
    local walkY    = getSafeWalkY(targetCF.Position.Y)
    local startPos = Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z)
    local goalPos  = Vector3.new(targetCF.Position.X, walkY, targetCF.Position.Z)

    -- Cari apakah goalPos berada di dekat/dalam 1 collider (misal meja item)
    local goalCol = nil
    for _, col in ipairs(getNoClipColliders()) do
        if col and col.Parent and isPointInsideExpandedBox(goalPos, col, 1.5, 2.0) then
            goalCol = col
            break
        end
    end

    local routeWps, okOneLayer, penetratedCol = buildSmartOneLayerRoute(startPos, goalPos, goalCol)

    if okOneLayer and #routeWps > 0 then
        -- Buka NoClip sementara pada 1 lapis objek yang akan ditembus
        if penetratedCol then
            setTargetColliderPassable(penetratedCol, true)
        end
        if goalCol then
            setTargetColliderPassable(goalCol, true)
        end
        forceCharNoClip = true

        local cancelled = false
        for i, wp in ipairs(routeWps) do
            if abortTeleport or not _G.TeleportGUI_Loaded then
                cancelled = true
                break
            end
            clearPathVisuals()
            drawWaypoint(wp, (i == #routeWps) and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(80, 200, 255))
            cancelled = teleportTween(CFrame.new(wp), speed or Config.TweenSpeed, ignoreThreat, true)
            if cancelled or abortTeleport then
                break
            end
        end

        clearPathVisuals()
        setTargetColliderPassable(nil, false)

        if cancelled or abortTeleport then
            return true
        end

        -- Cek apakah karakter berhasil sampai di tujuan (tidak mental balik karena server rollback)
        task.wait(0.06)
        if rootPart and (rootPart.Position - goalPos).Magnitude <= 6.5 then
            return false
        else
            recordFailedRollbackZone(routeWps[1])
        end
    end

    -- Jika gagal tembus (karena >= 2 lapis objek berdekatan atau terkena rollback),
    -- langsung jalankan NavMesh Pathfinding (tanpa tembus & tanpa memanjat benda)!
    if not isPathfinding and not abortTeleport then
        if pfStatusRef then
            pfStatusRef.Text = "🔄 >=2 Lapis terdeteksi! Memutar tanpa tembus..."
            pfStatusRef.TextColor3 = Color3.fromRGB(255, 190, 70)
        end
        pathfindTween(CFrame.new(goalPos), nil, 1, true)
    end

    return false
end

performColliderHide = function(statusFn)
    if not rootPart then return false end
    rootPart.Anchored = false
    isHiding = true

    local hideSpeed = math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)
    local centerPos, hideRoute = moveIntoNearestColliderCenter(hideSpeed, true)
    if abortTeleport or not _G.TeleportGUI_Loaded then
        isHiding = false
        clearAllServerSyncedHolds()
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    local targetCol    = hideRoute and hideRoute.targetCol
    local pName        = (targetCol and targetCol.Parent and targetCol.Parent.Name) or (targetCol and targetCol.Name) or "Collider"
    local finalHidePos = (rootPart and centerPos and (rootPart.Position - centerPos).Magnitude <= 4.5) and rootPart.Position or (centerPos or rootPart.Position)

    local hidePlat = Instance.new("Part")
    hidePlat.Size         = Vector3.new(10, 1, 10)
    hidePlat.Anchored     = true
    hidePlat.CanCollide   = true
    hidePlat.Transparency = 1
    hidePlat.CFrame       = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
    hidePlat.Parent       = Workspace

    local syncConn = startServerSyncedHold(function() return finalHidePos end)
    local syncRetryCount = 0

    local function verifyAndFixRealHidePosition()
        if not rootPart or abortTeleport or not _G.TeleportGUI_Loaded or syncRetryCount >= 1 then return end
        local desyncDist = (rootPart.Position - finalHidePos).Magnitude
        if desyncDist > 4.5 then
            syncRetryCount = syncRetryCount + 1
            if syncConn then syncConn:Disconnect(); syncConn = nil end
            if statusFn then statusFn("⚠ Sinkronisasi fisik ke tengah " .. pName .. "...", Color3.fromRGB(255, 160, 60)) end
            setTargetColliderPassable(targetCol, true)
            teleportTween(CFrame.new(finalHidePos), hideSpeed * 0.85, true, true)
            if rootPart and not abortTeleport then
                finalHidePos = rootPart.Position
                syncConn = startServerSyncedHold(function() return finalHidePos end)
            end
        end
    end

    if statusFn then statusFn("🛡 Sembunyi di tengah " .. pName .. ", tunggu monster...", Color3.fromRGB(220, 80, 80)) end
    local hideStartClock = os.clock()
    while isThreatened() and (os.clock() - hideStartClock) < 20 and not abortTeleport and _G.TeleportGUI_Loaded do
        verifyAndFixRealHidePosition()
        if hidePlat and hidePlat.Parent and rootPart then
            hidePlat.CFrame = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
        end
        task.wait(0.2)
    end

    if statusFn and not abortTeleport then
        statusFn("⏳ Tunggu " .. Config.MonsterSafeDelay .. "s sebelum keluar collider...", Color3.fromRGB(180, 180, 60))
    end
    local safeStartClock = os.clock()
    while (os.clock() - safeStartClock) < Config.MonsterSafeDelay and (os.clock() - hideStartClock) < 28 and not abortTeleport and _G.TeleportGUI_Loaded do
        if isThreatened() then
            if statusFn then statusFn("🛡 Monster kembali! Tetap di tengah " .. pName .. "...", Color3.fromRGB(220, 80, 80)) end
            safeStartClock = os.clock()
        end
        task.wait(0.2)
    end

    clearAllServerSyncedHolds()
    if hidePlat and hidePlat.Parent then hidePlat:Destroy() end
    if rootPart then rootPart.Anchored = false end
    isHiding = false

    if abortTeleport or not _G.TeleportGUI_Loaded then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if not Config.HybridYMode then
        if statusFn then statusFn("↩ Aman! Keluar ke ruang terbuka...", Color3.fromRGB(100, 220, 150)) end
        if hideRoute and hideRoute.exitPos then
            teleportTween(CFrame.new(hideRoute.exitPos), Config.TweenSpeed, true, true)
        end
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        task.wait(0.25)
    else
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
    end

    return true
end

-- ==============================================================================
-- PATHFINDING ENGINE:
-- 1. Saat attempt == 0 (awal jalan), wajib coba Jalur Tembus 1-Lapis dulu!
-- 2. Jika terhalang >= 2 lapis benda berdekatan atau gagal tembus, barulah gunakan
--    NavMesh memutar dengan tinggi Y dikunci di lantai (TIDAK memanjat atas benda).
-- ==============================================================================
pathfindTween = function(targetCF, statusCb, _attempt, skipFirstLayerTry)
    if isPathfinding or not rootPart then return end
    isPathfinding = true
    abortTeleport = false
    clearPathVisuals()
    updateColliderCaches()

    local function setStatus(txt, col)
        if pfStatusRef then
            pfStatusRef.Text       = txt
            pfStatusRef.TextColor3 = col or Color3.fromRGB(160, 120, 255)
        end
        if statusCb then statusCb(txt) end
    end

    local walkY         = getSafeWalkY(targetCF.Position.Y)
    local startFlat     = Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z)
    local computeTarget = Vector3.new(targetCF.Position.X, walkY, targetCF.Position.Z)
    local attempt       = _attempt or 0
    local comboMode     = Config.PathfindMode and Config.UndergroundTeleport

    -- LANGKAH 1: Coba Jalur Tembus 1-Lapis terlebih dahulu pada percobaan pertama!
    if attempt == 0 and not skipFirstLayerTry and not comboMode then
        local goalCol = nil
        for _, col in ipairs(cachedAllCols) do
            if col and col.Parent and isPointInsideExpandedBox(computeTarget, col, 1.5, 2.0) then
                goalCol = col
                break
            end
        end

        local okDirect, layerCount, hitCol = analyzeSegmentLayers(startFlat, computeTarget, goalCol, 1.35)
        if okDirect and layerCount <= 1 then
            setStatus("⚡ Jalur 1-Lapis aman! Tembus NoClip langsung...", Color3.fromRGB(100, 240, 160))
            if hitCol then setTargetColliderPassable(hitCol, true) end
            if goalCol then setTargetColliderPassable(goalCol, true) end
            forceCharNoClip = true

            drawWaypoint(computeTarget, Color3.fromRGB(0, 255, 120))
            local isInterrupted = teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true)
            clearPathVisuals()
            setTargetColliderPassable(nil, false)

            if isInterrupted and isThreatened() then
                restoreNormalGravity()
                local resumed = performColliderHide(setStatus)
                isPathfinding = false
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded then
                    pathfindTween(targetCF, statusCb, 1, true)
                end
                return
            end

            task.wait(0.06)
            if rootPart and (rootPart.Position - computeTarget).Magnitude <= 5.5 then
                isPathfinding = false
                restoreNormalGravity()
                setStatus("✔ Tembus 1-Lapis selesai!", Color3.fromRGB(100, 220, 150))
                task.delay(1.5, function()
                    if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih" end
                end)
                return
            else
                setStatus("🔄 Tembus gagal (>=2 Lapis), beralih ke rute memutar...", Color3.fromRGB(255, 180, 60))
            end
        end
    end

    -- LANGKAH 2: Jalur Tembus tidak memungkinkan (>= 2 Lapis objek berdekatan) -> Hitung NavMesh Memutar!
    local currentParams = (attempt >= 2) and AGENT_PARAMS_LASTRESORT
                       or (attempt == 1) and AGENT_PARAMS_FALLBACK
                       or AGENT_PARAMS

    local allTargetParts = getAllNoClipTargetParts()
    for _, p in ipairs(allTargetParts) do
        if p and p:IsA("BasePart") then p.CanCollide = true end
    end
    for _, col in ipairs(cachedAllCols) do
        if col and col:IsA("BasePart") then col.CanCollide = true end
    end

    local tempVirtualBlockers = {}
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        local looseSize = (Config.LooseRadius or 10) * 1.9
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") and isLooseMonsterName(m.Name) then
                local mp = getMonsterPart(m)
                if mp and rootPart and (mp.Position - rootPart.Position).Magnitude > 3.0 and (mp.Position - computeTarget).Magnitude > 4.0 then
                    local mb = Instance.new("Part")
                    mb.Name         = "_PFVirtualBlocker"
                    mb.Size         = Vector3.new(looseSize, 12, looseSize)
                    mb.Position     = mp.Position
                    mb.Anchored     = true
                    mb.CanCollide   = true
                    mb.Transparency = 1
                    mb.Parent       = Workspace
                    table.insert(tempVirtualBlockers, mb)
                end
            end
        end
    end

    local path = PathfindingService:CreatePath(currentParams)
    local ok   = pcall(function() path:ComputeAsync(startFlat, computeTarget) end)

    for _, vb in ipairs(tempVirtualBlockers) do
        pcall(function() vb:Destroy() end)
    end

    if Config.NoClip then
        applyNoClipState()
    else
        for _, col in ipairs(cachedAllCols) do
            if col and col:IsA("BasePart") then col.CanCollide = true end
        end
    end

    if not ok or path.Status ~= Enum.PathStatus.Success then
        if attempt < 2 then
            isPathfinding = false
            task.wait(0.05)
            pathfindTween(targetCF, statusCb, attempt + 1, true)
            return
        else
            -- Fallback terakhir: paksa jalan lurus ke target agar tidak pernah diam di tempat
            setStatus("⚠ Rute sempit, paksa gerak ke tujuan...", Color3.fromRGB(220, 140, 60))
            forceCharNoClip = true
            teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true)
            forceCharNoClip = false
            isPathfinding = false
            restoreNormalGravity()
            return
        end
    end

    local rawWaypoints = path:GetWaypoints()
    if #rawWaypoints == 0 then
        isPathfinding = false
        teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true)
        restoreNormalGravity()
        return
    end

    -- String-Pulling Shortcut: Pangkas titik-titik NavMesh yang memutar jauh atau memanjat benda
    -- jika segmen antar-waypoint bisa dipotong lurus dengan 0 atau 1 lapis!
    local flatWaypoints = {}
    for i = 1, #rawWaypoints do
        -- Kunci koordinat Y di walkY (tinggi lantai karakter) agar TIDAK PERNAH naik ke atas benda!
        table.insert(flatWaypoints, Vector3.new(rawWaypoints[i].Position.X, walkY, rawWaypoints[i].Position.Z))
    end

    local optimizedWps = {}
    local curIdx = 1
    while curIdx < #flatWaypoints do
        local nextIdx = curIdx + 1
        -- Cari waypoint terjauh yang bisa ditempuh tanpa menabrak > 0 collider (atau <= 1 collider jika percobaan pertama)
        local maxAllowed = (attempt == 0) and 1 or 0
        for j = #flatWaypoints, curIdx + 2, -1 do
            local okSeg, segLayers = analyzeSegmentLayers(flatWaypoints[curIdx], flatWaypoints[j], nil, 1.4)
            if okSeg and segLayers <= maxAllowed then
                nextIdx = j
                break
            end
        end
        table.insert(optimizedWps, flatWaypoints[nextIdx])
        curIdx = nextIdx
    end

    setStatus("🔵 Pathfinding (" .. #optimizedWps .. " titik rata lantai)...", Color3.fromRGB(160, 120, 255))
    Workspace.Gravity = 0

    for i, wpPos in ipairs(optimizedWps) do
        if abortTeleport or not _G.TeleportGUI_Loaded then
            setStatus("🛑 Dibatalkan", Color3.fromRGB(220, 80, 80))
            break
        end

        local wpY  = (comboMode or Config.UndergroundTeleport) and (wpPos.Y - Config.UGDepth) or walkY
        local wpCF = CFrame.new(wpPos.X, wpY, wpPos.Z)

        drawWaypoint(wpPos, i == #optimizedWps and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 200, 0))

        local isInterrupted = teleportTween(wpCF, Config.TweenSpeed, false, true)
        if isInterrupted then
            if isThreatened() then
                restoreNormalGravity()
                local resumed = performColliderHide(setStatus)
                isPathfinding = false
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded and attempt < 2 then
                    task.wait(0.15)
                    pathfindTween(targetCF, statusCb, attempt + 1, true)
                end
                return
            end
            if abortTeleport then break end
        end
    end

    isPathfinding = false
    restoreNormalGravity()
    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end

    if not abortTeleport and rootPart then
        local fp = computeTarget
        if comboMode then
            teleportTween(CFrame.new(fp.X, walkY, fp.Z), Config.UGRiseSpeed, false, true)
        end
        setStatus("✔ Pathfind selesai!", Color3.fromRGB(100, 220, 150))
        task.delay(2, function()
            if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih" end
            clearPathVisuals()
        end)
    end

    abortTeleport = false
end

local function doTeleport(cf, mode, speed)
    if Config.HybridYMode then
        executeHybridYTeleport(cf, function(txt, col)
            if pfStatusRef then pfStatusRef.Text = txt; pfStatusRef.TextColor3 = col or Color3.fromRGB(120, 220, 255) end
        end)
        return
    end

    if mode == "Tween" and Config.PathfindMode then
        task.spawn(function() pathfindTween(cf, nil, 0, false) end)
        return
    end

    if Config.UndergroundTeleport and mode == "Tween" then
        if not rootPart then return end
        local target = cf.Position
        local downY  = rootPart.Position.Y - Config.UGDepth
        teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
        if abortTeleport then restoreNormalGravity(); return end
        teleportTween(CFrame.new(target.X, downY, target.Z), speed, false, true)
        if abortTeleport then restoreNormalGravity(); return end
        teleportTween(CFrame.new(target.X, target.Y + 3.1, target.Z), Config.UGRiseSpeed, false, true)
        restoreNormalGravity()
        return
    end

    local finalCF = Config.UndergroundTeleport and CFrame.new(cf.Position.X, cf.Position.Y - Config.UGDepth, cf.Position.Z) or cf
    if mode == "Tween" then
        safeSingleLayerTween(finalCF, speed, false)
    else
        teleportInstant(finalCF, false)
    end
    restoreNormalGravity()
end

