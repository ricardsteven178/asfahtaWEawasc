nextGenBtn.MouseButton1Click:Connect(function()
    local gens = getGeneratorsInRoom()
    if #gens == 0 then
        genSt.Text = "⚠ Tidak ada Generator di room!"; genSt.TextColor3 = Color3.fromRGB(220, 120, 80)
        return
    end

    -- Cari Generator yang belum selesai (Completed == false) dan jaraknya > 8 studs dari posisi kita sekarang (agar pindah ke Generator lain)
    local candidates = {}
    for _, g in ipairs(gens) do
        local dist = rootPart and (rootPart.Position - g.position).Magnitude or 999
        if not g.completed and dist > 8.0 then
            table.insert(candidates, { data = g, dist = dist })
        end
    end

    -- Fallback: jika tinggal 1 generator yang belum selesai (atau semua sudah selesai), ambil yang jaraknya > 8 studs
    if #candidates == 0 then
        for _, g in ipairs(gens) do
            local dist = rootPart and (rootPart.Position - g.position).Magnitude or 999
            if dist > 8.0 then
                table.insert(candidates, { data = g, dist = dist })
            end
        end
    end

    if #candidates == 0 then
        candidates = { { data = gens[1], dist = 0 } }
    end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    local targetGen = candidates[1].data
    selectedGenData = targetGen
    genDdLabel.Text = targetGen.label

    genSt.Text = "⏳ Pindah ke " .. targetGen.label .. "..."; genSt.TextColor3 = Color3.fromRGB(200, 160, 255)
    task.spawn(function()
        doTeleport(targetGen.cf, Config.TeleportMode, Config.TweenSpeed)
        genSt.Text = "✔ Sampai di " .. targetGen.label .. "!"
        task.delay(2.5, function() genSt.Text = "" end)
    end)
end)

