local function interactWithPrompt(prompt)
    prompt.RequiresLineOfSight   = false
    prompt.MaxActivationDistance = math.huge
    if fireproximityprompt then
        fireproximityprompt(prompt, 1)
    else
        pcall(function()
            prompt:InputHoldBegin()
            if prompt.HoldDuration > 0 then task.wait(prompt.HoldDuration) end
            prompt:InputHoldEnd()
        end)
    end
end

-- Mendapatkan daftar Generator di ruangan beserta titik berdiri & statusnya untuk pengetesan Hybrid / Teleport
local function getGeneratorsInRoom()
    local genList = {}
    local map     = getMap()
    local folder  = map and map:FindFirstChild("Generators")
    if not folder then return genList end

    local walkY = getSafeWalkY(100)
    for idx, gen in ipairs(folder:GetChildren()) do
        if gen:IsA("Model") then
            local stats     = gen:FindFirstChild("Stats")
            local completed = stats and stats:FindFirstChild("Completed") and stats.Completed.Value or false
            local possessed = stats and stats:FindFirstChild("Connie") and stats.Connie.Value or false
            local cur       = stats and stats:FindFirstChild("CurrentAmount") and math.floor(stats.CurrentAmount.Value + 0.5) or 0
            local req       = stats and stats:FindFirstChild("RequiredAmount") and stats.RequiredAmount.Value or 45

            -- Cari titik Prompt / Origin / InvisBlock pada Generator
            local targetPart = gen:FindFirstChild("Prompt")
                or gen:FindFirstChild("Origin")
                or gen:FindFirstChild("InvisBlock")
                or gen.PrimaryPart
                or gen:FindFirstChildWhichIsA("BasePart", true)

            if targetPart then
                local gPos = targetPart:IsA("BasePart") and targetPart.Position or gen:GetPivot().Position
                local tpCF = CFrame.new(gPos.X, walkY, gPos.Z)
                local statusTag = completed and " [DONE]" or (possessed and " [POSSESSED]" or "")
                local displayLabel = string.format("Gen #%d (%d/%d)%s", idx, cur, req, statusTag)

                table.insert(genList, {
                    id        = idx,
                    model     = gen,
                    label     = displayLabel,
                    cf        = tpCF,
                    position  = tpCF.Position,
                    completed = completed,
                    possessed = possessed,
                })
            end
        end
    end
    return genList
end

local function getItemsInRoom()
    local items  = {}
    local map    = getMap()
    local folder = map and map:FindFirstChild("Items")
    if not folder then return items end
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Model") then
            if not items[item.Name] then
                items[item.Name] = { count = 0, instances = {} }
            end
            items[item.Name].count = items[item.Name].count + 1
            table.insert(items[item.Name].instances, item)
        end
    end
    return items
end

local function pickupSelectedItem(targetName, cb)
    if isPickingUp then return end
    isPickingUp   = true
    abortTeleport = false

    -- Jika SyncPickupWithMain == true, ikuti TeleportMode & TweenSpeed; jika false, gunakan nilai mandiri di Config
    if Config.SyncPickupWithMain then
        Config.PickupMode       = Config.TeleportMode
        Config.PickupTweenSpeed = Config.TweenSpeed
    end

    task.spawn(function()
        updateColliderCaches()

        local function makePlatform(atPos)
            local plat = Instance.new("Part")
            plat.Size         = Vector3.new(10, 1, 10)
            plat.Anchored     = true
            plat.CanCollide   = true
            plat.Transparency = 1
            plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
            plat.Parent       = Workspace
            return plat
        end

        local function getRemainingTargets()
            local list   = {}
            local map    = getMap()
            local folder = map and map:FindFirstChild("Items")
            if not folder then return list end
            for _, item in ipairs(folder:GetChildren()) do
                if item:IsA("Model") and item.Name == targetName and item.Parent then
                    table.insert(list, item)
                end
            end
            if rootPart then
                table.sort(list, function(a, b)
                    return (rootPart.Position - a:GetPivot().Position).Magnitude
                         < (rootPart.Position - b:GetPivot().Position).Magnitude
                end)
            end
            return list
        end

        local initialList = getRemainingTargets()
        if #initialList == 0 then
            if cb then cb("Item '" .. targetName .. "' tidak ada di room!") end
            isPickingUp = false
            return
        end

        local skipCounts = {}

        while isPickingUp and not abortTeleport and _G.TeleportGUI_Loaded do
            if isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
            end

            local remaining = getRemainingTargets()
            local item = nil
            for _, it in ipairs(remaining) do
                if (skipCounts[it] or 0) < 3 then
                    local itPos = it:GetPivot().Position
                    if not Config.HybridYMode and isPointNearPassiveMonster(itPos, 8.5) then
                        skipCounts[it] = 3
                        if cb then cb("⚠ " .. targetName .. " dijaga Monster Pasif, skip!") end
                        task.wait(0.2)
                    else
                        item = it
                        break
                    end
                end
            end

            if not item or not item.Parent or not rootPart then
                break
            end

            local retryCount = skipCounts[item] or 0
            if cb then
                local retryTxt = (retryCount > 0) and (" [Coba #" .. (retryCount + 1) .. "]") or ""
                cb("🎯 Mengambil " .. targetName .. " (Sisa: " .. #remaining .. ")" .. retryTxt .. "...")
            end

            local walkY    = getSafeWalkY(rootPart.Position.Y)
            local itemPos  = item:GetPivot().Position
            local targetPos = Vector3.new(itemPos.X, walkY, itemPos.Z)
            local targetCF  = CFrame.new(targetPos)

            local moveInterrupted = false
            if Config.HybridYMode then
                executeHybridYTeleport(targetCF, function(msg) if cb then cb(msg) end end)
            elseif Config.PickupMode == "Tween" and Config.PathfindMode then
                -- Saat retryCount == 0, pathfindTween otomatis mencoba tembus 1-Lapis dulu; jika gagal baru memutar NavMesh
                task.spawn(function() pathfindTween(targetCF, nil, math.min(retryCount, 2), retryCount > 0) end)
                local w = 0
                while not isPathfinding and w < 0.6 do task.wait(0.05); w = w + 0.05 end
                w = 0
                while (isPathfinding or isHiding) and w < 45 and not abortTeleport and isPickingUp do
                    task.wait(0.1)
                    w = w + 0.1
                end
                task.wait(0.1)
            elseif Config.PickupMode == "Tween" and Config.UndergroundTeleport then
                local downY = rootPart.Position.Y - Config.UGDepth
                moveInterrupted = teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
                if not moveInterrupted and not abortTeleport then
                    moveInterrupted = teleportTween(CFrame.new(targetCF.X, downY, targetCF.Z), Config.PickupTweenSpeed, false, true)
                end
                if not moveInterrupted and not abortTeleport then
                    moveInterrupted = teleportTween(CFrame.new(targetCF.X, walkY, targetCF.Z), Config.UGRiseSpeed, false, true)
                end
            elseif Config.PickupMode == "Tween" then
                if retryCount == 0 then
                    -- Prioritas Utama: Tembus 1-Lapis (atau jalan lurus) langsung ke titik item!
                    moveInterrupted = safeSingleLayerTween(targetCF, Config.PickupTweenSpeed, false)
                else
                    -- Jika percobaan pertama mental karena >=2 Lapis, gunakan NavMesh memutar tanpa memanjat benda
                    task.spawn(function() pathfindTween(targetCF, nil, 1, true) end)
                    local w = 0
                    while not isPathfinding and w < 0.6 do task.wait(0.05); w = w + 0.05 end
                    w = 0
                    while (isPathfinding or isHiding) and w < 45 and not abortTeleport and isPickingUp do
                        task.wait(0.1)
                        w = w + 0.1
                    end
                end
            else
                teleportInstant(targetCF, false)
            end

            if abortTeleport or not isPickingUp then break end

            if moveInterrupted or isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.15)
                continue
            end

            -- Cek apakah sudah dekat dengan item (toleransi horizontal XZ <= 11 studs)
            local horizDist = Vector2.new(rootPart.Position.X - itemPos.X, rootPart.Position.Z - itemPos.Z).Magnitude
            if horizDist > 11.0 then
                skipCounts[item] = (skipCounts[item] or 0) + 1
                task.wait(0.15)
                continue
            end

            -- Ambil item dengan ProximityPrompt
            local holdTargetPos = rootPart.Position
            local plat = makePlatform(holdTargetPos)
            local holdPickupConn = startServerSyncedHold(function() return holdTargetPos end)
            local waitTicks = 0
            local monsterInterrupted = false

            while item.Parent and waitTicks < 22 and not abortTeleport and isPickingUp do
                if isThreatened() then
                    monsterInterrupted = true
                    break
                end

                local pp   = item:FindFirstChild("Prompt")
                local prox = pp and pp:FindFirstChild("ProximityPrompt")
                if prox and prox.Enabled then
                    interactWithPrompt(prox)
                end

                task.wait(0.1)
                waitTicks = waitTicks + 1
            end

            if holdPickupConn then holdPickupConn:Disconnect(); holdPickupConn = nil end
            if plat and plat.Parent then plat:Destroy() end
            if rootPart then rootPart.Anchored = false end

            if monsterInterrupted then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.15)
                continue
            end

            if item.Parent then
                skipCounts[item] = (skipCounts[item] or 0) + 1
            end

            if Config.HybridYMode and not abortTeleport and isPickingUp then
                if cb then cb("🛡 Selesai ambil, kembali ke tengah Collider tebal...") end
                moveIntoNearestColliderCenter(Config.TweenSpeed, true)
                setTargetColliderPassable(nil, false)
                restoreNormalGravity()
                task.wait(0.15)
            else
                restoreNormalGravity()
                task.wait(0.2)
            end
        end

        clearAllServerSyncedHolds()
        if rootPart then rootPart.Anchored = false end
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        isPickingUp = false
        if pfStatusRef then
            pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih"
            pfStatusRef.TextColor3 = Color3.fromRGB(90, 90, 120)
        end
        if cb then cb("✔ Selesai ambil " .. targetName .. "!") end
    end)
end

