local function clearESP(tag)
    local list = espInstances[tag]
    if list then
        for _, inst in ipairs(list) do
            pcall(function() if inst and inst.Parent then inst:Destroy() end end)
        end
        table.clear(list)
    end
end

local function addHighlight(parent, fill, outline, tag)
    if parent:FindFirstChild(tag) then return end
    local h = Instance.new("Highlight")
    h.Name             = tag
    h.FillColor        = fill
    h.OutlineColor     = outline
    h.FillTransparency = 0.5
    h.Parent           = parent
    if espInstances[tag] then table.insert(espInstances[tag], h) end
end

local function addBillboard(parent, text, color, tag)
    if parent:FindFirstChild(tag .. "BB") then return end
    local bb = Instance.new("BillboardGui")
    bb.Name        = tag .. "BB"
    bb.Size        = UDim2.new(0, 120, 0, 40)
    bb.AlwaysOnTop = true
    bb.Parent      = parent
    if parent:IsA("Model") then
        bb.Adornee = getMonsterPart(parent)
    elseif parent:IsA("BasePart") then
        bb.Adornee = parent
    end

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size                   = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                   = text
    lbl.TextColor3             = color
    lbl.TextStrokeTransparency = 0.4
    lbl.Font                   = Enum.Font.GothamBold
    lbl.TextSize               = 13
    lbl.TextWrapped            = true
    if espInstances[tag] then table.insert(espInstances[tag], bb) end
end

local function refreshItemESP()
    clearESP("_ItemESP")
    if not Config.ItemESP then return end
    local map    = getMap()
    local folder = map and map:FindFirstChild("Items")
    if not folder then return end
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Model") then
            addHighlight(item, Color3.fromRGB(0, 220, 100), Color3.fromRGB(255, 255, 255), "_ItemESP")
            addBillboard(item, item.Name, Color3.fromRGB(0, 220, 100), "_ItemESP")
        end
    end
end

local function refreshGenESP()
    clearESP("_GenESP")
    if not Config.GenESP then return end
    local map    = getMap()
    local folder = map and map:FindFirstChild("Generators")
    if not folder then return end
    for _, gen in ipairs(folder:GetChildren()) do
        if gen:IsA("Model") then
            local stats     = gen:FindFirstChild("Stats")
            local completed = stats and stats:FindFirstChild("Completed") and stats.Completed.Value
            local possessed = stats and stats:FindFirstChild("Connie") and stats.Connie.Value
            local cur       = stats and stats:FindFirstChild("CurrentAmount") and math.floor(stats.CurrentAmount.Value + 0.5) or 0
            local req       = stats and stats:FindFirstChild("RequiredAmount") and stats.RequiredAmount.Value or 0
            local fill      = completed and Color3.fromRGB(180, 0, 255) or possessed and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(150, 150, 150)
            addHighlight(gen, fill, Color3.fromRGB(255, 255, 255), "_GenESP")
            local lbl = gen.Name .. "\n(" .. cur .. "/" .. req .. ")" .. (possessed and "\n[POSSESSED]" or "") .. (completed and "\n[DONE]" or "")
            addBillboard(gen, lbl, fill, "_GenESP")
        end
    end
end

local function refreshMonsterESP()
    clearESP("_MonsterESP")
    if not Config.MonsterESP then return end
    local map    = getMap()
    local folder = map and map:FindFirstChild("Monsters")
    if not folder then return end
    for _, monster in ipairs(folder:GetChildren()) do
        if monster:IsA("Model") then
            local isPassive = isLooseMonsterName(monster.Name)
            local fillCol = isPassive and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(255, 30, 30)
            local tagTxt  = isPassive and "[⚠ PASIF]\n" or "[👹 MONSTER]\n"
            addHighlight(monster, fillCol, Color3.fromRGB(255, 255, 255), "_MonsterESP")
            addBillboard(monster, tagTxt .. monster.Name, fillCol, "_MonsterESP")
        end
    end
end

local function refreshLineESP()
    clearESP("_LineESP")
    if not Config.LineESP or not rootPart then return end
    local map    = getMap()
    local folder = map and map:FindFirstChild("Monsters")
    if not folder then return end

    local originAtt = rootPart:FindFirstChild("_LineESPOrigin")
    if not originAtt then
        originAtt        = Instance.new("Attachment")
        originAtt.Name   = "_LineESPOrigin"
        originAtt.Parent = rootPart
    end

    for _, monster in ipairs(folder:GetChildren()) do
        local mPart = getMonsterPart(monster)
        if monster:IsA("Model") and mPart then
            local ta = mPart:FindFirstChild("_LineESPTarget")
            if not ta then
                ta        = Instance.new("Attachment")
                ta.Name   = "_LineESPTarget"
                ta.Parent = mPart
            end
            local beam = Instance.new("Beam")
            beam.Name          = "_LineESPBeam"
            beam.Attachment0   = originAtt
            beam.Attachment1   = ta
            beam.Color         = ColorSequence.new(Color3.fromRGB(255, 50, 50), Color3.fromRGB(255, 150, 0))
            beam.Width0        = 0.08
            beam.Width1        = 0.08
            beam.FaceCamera    = true
            beam.Transparency  = NumberSequence.new(0.2)
            beam.LightEmission = 1
            beam.Segments      = 1
            beam.Parent        = rootPart
            table.insert(espInstances._LineESP, beam)
        end
    end
