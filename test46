local pathfindTween
local performColliderHide
local activeHoldConns = {}

local function clearAllServerSyncedHolds()
    for _, c in ipairs(activeHoldConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(activeHoldConns)
end

local function startServerSyncedHold(getTargetPosFn)
    clearAllServerSyncedHolds()
    if rootPart then rootPart.Anchored = false end
    Workspace.Gravity = 0
    local tickCounter = 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not rootPart or abortTeleport or not _G.TeleportGUI_Loaded or (not isHiding and not isPickingUp) then
            if conn then conn:Disconnect() end
            return
        end
        local holdPos = getTargetPosFn()
        if not holdPos then return end
        if (rootPart.Position - holdPos).Magnitude <= 3.5 then
            tickCounter = tickCounter + 1
            local jitterX = (tickCounter % 2 == 0) and 0.03 or -0.03
            local jitterZ = (tickCounter % 4 < 2) and 0.03 or -0.03
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = CFrame.new(holdPos.X + jitterX, holdPos.Y, holdPos.Z + jitterZ)
        end
    end)
    table.insert(activeHoldConns, conn)
    return conn
end

local function recordFailedRollbackZone(pos)
    if not pos then return end
    for _, p in ipairs(failedRollbackZones) do
        if (p - pos).Magnitude < 4.0 then return end
    end
    table.insert(failedRollbackZones, pos)
    if #failedRollbackZones > 12 then
        table.remove(failedRollbackZones, 1)
    end
end

local function teleportInstant(cf, keepZeroGravity)
    if not rootPart then return end
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity  = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.CFrame = cf
    character:PivotTo(cf)
    if not keepZeroGravity and not isPathfinding and not isHiding then
        restoreNormalGravity()
    end
end

local function teleportTween(cf, speed, ignoreThreat, forceSnapEnd)
    if not rootPart or not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    rootPart.Anchored = false

    local targetPos    = cf.Position
    local startPos     = rootPart.Position
    local verticalDiff = math.abs(targetPos.Y - startPos.Y)

    -- Hanya gunakan mode vertikal (CFrame) jika sedang Underground TP atau pindah ketinggian ekstrem (> 8 studs)
    local isVerticalMove = Config.UndergroundTeleport or (verticalDiff > 8.0)

    local baseSpd    = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
    local origWalk   = (hum and hum.WalkSpeed > 0) and hum.WalkSpeed or 16
    local openMult   = speed or Config.TweenSpeed or 2.25
    local noclipMult = Config.NoClipTweenSpeed or 1.05
    local moveSpd    = baseSpd * openMult
    local cancelled  = false

    -- Parameter sensor pendeteksi obstacle fisik di sekitar & depan karakter
    local sensorParams = OverlapParams.new()
    sensorParams.FilterType = Enum.RaycastFilterType.Exclude
    sensorParams.FilterDescendantsInstances = { character }

    local function isTouchingOrApproachingObstacle(curPos, dirUnit)
        local aheadPos = curPos + (dirUnit * 2.0)
        -- 1. Cek terhadap semua Collider & WindowWall di cache (termasuk yang sedang CanCollide = false)
        for _, col in ipairs(getNoClipColliders()) do
            if col and col.Parent then
                if isPointInsideExpandedBox(curPos, col, 1.8, 2.0)
                   or isPointInsideExpandedBox(aheadPos, col, 1.8, 2.0) then
                    return true
                end
            end
        end

        -- 2. Cek part fisik lain (Tembok, Generator, Meja, Cutout) di depan badan karakter
        local ok, parts = pcall(function()
            return Workspace:GetPartBoundsInBox(CFrame.new( curPos:Lerp(aheadPos, 0.5) ), Vector3.new(3.4, 2.6, 3.4), sensorParams)
        end)
        if ok and parts then
            for _, p in ipairs(parts) do
                if p and p:IsA("BasePart") and not isFloorPart(p) then
                    local pn = p.Name
                    if pn ~= "_NoClipESP" and pn ~= "_LineESPBeam" and pn ~= "_PFVirtualBlocker" and p.Transparency < 0.98 or isColliderName(pn) or pn == "InvisBlock" then
                        return true
                    end
                end
            end
        end
        return false
    end

    -- Pastikan tubuh karakter tembus objek (NoClip) selama berjalan
    forceCharNoClip = true
    if Config.NoClip then applyNoClipState() end

    -- CABANG 1: JALAN MENDATAR MURNI DENGAN ANIMASI HUMANOID + AUTO-BRAKE SAAT TEMBUS OBSTACLE
    if not isVerticalMove and hum then
        restoreNormalGravity()
        hum.PlatformStand = false
        hum.Sit           = false
        if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.None then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end

        local currentDir = Vector3.zero
        local stepBindName = "_TeleportWalkSim"
        pcall(function() RunService:UnbindFromRenderStep(stepBindName) end)

        -- Bind di atas prioritas ControlModule (Character + 10) agar animasi lari/jalan selalu aktif
        RunService:BindToRenderStep(stepBindName, Enum.RenderPriority.Character.Value + 10, function()
            if rootPart and hum and hum.Parent and currentDir.Magnitude > 0.01 then
                hum.WalkSpeed = moveSpd
                hum:Move(currentDir, false)
            end
        end)

        local totalDist    = Vector2.new(targetPos.X - startPos.X, targetPos.Z - startPos.Z).Magnitude
        local minSpdEst    = baseSpd * math.min(openMult, noclipMult)
        local timeoutClock = os.clock() + math.max((totalDist / math.max(minSpdEst, 5)) * 2.8, 3.5)
        local lastPos      = rootPart.Position
        local stuckTimer   = 0

        while rootPart and hum and hum.Parent and os.clock() < timeoutClock do
            if abortTeleport or (not ignoreThreat and isThreatened()) then
                cancelled = true
                break
            end

            local curPos   = rootPart.Position
            local flatDiff = Vector3.new(targetPos.X - curPos.X, 0, targetPos.Z - curPos.Z)
            local dist     = flatDiff.Magnitude

            if dist <= 1.6 then
                break
            end

            currentDir = flatDiff.Unit

            -- Otomatis gunakan NoClipTweenSpeed (1.05) jika sedang menembus/mendekati obstacle,
            -- dan gunakan TweenSpeed cepat jika jalanan di depan kosong!
            if isTouchingOrApproachingObstacle(curPos, currentDir) then
                moveSpd = baseSpd * noclipMult
            else
                moveSpd = baseSpd * openMult
            end

            hum.WalkSpeed = moveSpd
            hum:Move(currentDir, false)

            local dt = RunService.Heartbeat:Wait()
            if not rootPart then break end

            if (rootPart.Position - lastPos).Magnitude < 0.08 then
                stuckTimer = stuckTimer + dt
                if stuckTimer > 0.25 then
                    applyNoClipState()
                    stuckTimer = 0
                end
            else
                stuckTimer = 0
                lastPos = rootPart.Position
            end
        end

        currentDir = Vector3.zero
        pcall(function() RunService:UnbindFromRenderStep(stepBindName) end)
        if hum and hum.Parent then
            hum:Move(Vector3.zero, false)
            hum.WalkSpeed = origWalk
        end
    else
        -- CABANG 2: PERGERAKAN VERTIKAL / UNDERGROUND (MENGGUNAKAN TWEEN CFRAME)
        Workspace.Gravity = 0
        local dist = (startPos - targetPos).Magnitude
        local dur  = math.max(dist / math.max(moveSpd, 1), 0.001)
        local tw   = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
        activeTween = tw
        tw:Play()

        local done = false
        tw.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed then done = true end
        end)

        while not done do
            if abortTeleport or (not ignoreThreat and isThreatened()) then
                tw:Cancel()
                cancelled = true
                break
            end
            task.wait(0.015)
        end

        if not cancelled and rootPart and (rootPart.Position - targetPos).Magnitude <= 4.0 then
            rootPart.CFrame = cf
        end
        if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end
        if activeTween == tw then activeTween = nil end
    end

    if not Config.NoClip and not isHiding then
        forceCharNoClip = false
    end
    if not isPathfinding and not isHiding then
        restoreNormalGravity()
    end

    return cancelled
end

local function moveIntoNearestColliderCenter(speed, ignoreThreat, excludedCol)
    if not rootPart then return nil, nil end
    rootPart.Anchored = false
    local startPos  = clampPositionAboveFloor(rootPart.Position, 3.1)
    local hideRoute = getNearestSafeColliderRoute(startPos, excludedCol)
    local targetCol = hideRoute.targetCol

    setTargetColliderPassable(targetCol, true)
    local moveSpd = speed or math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)

    for i, wpPos in ipairs(hideRoute.waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then break end
        local isLast = (i == #hideRoute.waypoints)
        local cancelled = teleportTween(CFrame.new(wpPos), moveSpd, ignoreThreat, isLast)
        if cancelled and not ignoreThreat then
            return nil, hideRoute
        end
    end

    if rootPart and hideRoute.centerPos and not abortTeleport then
        if (rootPart.Position - hideRoute.centerPos).Magnitude <= 3.5 then
            rootPart.CFrame = CFrame.new(hideRoute.centerPos)
            character:PivotTo(CFrame.new(hideRoute.centerPos))
        end
    end
    return hideRoute.centerPos, hideRoute
end

local function executeHybridYTeleport(targetCF, statusFn)
    if not rootPart then return false end

    if statusFn then statusFn("1/3 🛡 Menuju tengah Collider tebal terdekat...", Color3.fromRGB(255, 190, 80)) end
    local centerPos = moveIntoNearestColliderCenter(Config.TweenSpeed, false)
    if abortTeleport or not rootPart then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if not centerPos then
        centerPos = moveIntoNearestColliderCenter(math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5), true)
    end
    if not centerPos then centerPos = rootPart.Position end

    task.wait(0.05)

    local bypassY   = Config.HybridBypassY
    local waitDelay = math.max(Config.HybridBypassDelay or 0.4, 0.05)
    local bypassCF  = CFrame.new(centerPos.X, bypassY, centerPos.Z)

    Workspace.Gravity = 0
    teleportInstant(bypassCF, true)

    local holdConn = RunService.Heartbeat:Connect(function()
        if rootPart and not abortTeleport then
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = bypassCF
        end
    end)

    local elapsed = 0
    while elapsed < waitDelay and not abortTeleport and _G.TeleportGUI_Loaded do
        local remain = math.max(waitDelay - elapsed, 0)
        if statusFn then
            statusFn(string.format("2/3 ⏳ Stay di Y=%.0f (%.2fs)...", bypassY, remain), Color3.fromRGB(120, 220, 255))
        end
        local step = math.min(0.05, waitDelay - elapsed)
        task.wait(step)
        elapsed = elapsed + step
    end

    if holdConn then holdConn:Disconnect() end

    if abortTeleport or not rootPart then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    local destPos     = targetCF.Position
    local finalDestCF = CFrame.new(destPos)
    if statusFn then
        statusFn(string.format("3/3 💥 Boom! Instant ke (%.0f, %.0f, %.0f)", destPos.X, destPos.Y, destPos.Z), Color3.fromRGB(100, 255, 160))
    end
    teleportInstant(finalDestCF, true)
    task.wait(0.05)
    teleportInstant(finalDestCF, false)

    setTargetColliderPassable(nil, false)
    restoreNormalGravity()
    return true
end

