local function isLooseMonsterName(mName)
    if not mName then return false end
    local lower = mName:lower()
    for _, looseName in ipairs(Config.LooseMonsters or {}) do
        if mName == looseName or lower:find(looseName:lower(), 1, true) then
            return true
        end
    end
    if lower:find("blott") or lower:find("squirm") or lower:find("razzle") or lower:find("rodger") or lower:find("connie") or lower:find("gourdy") then
        return true
    end
    return false
end

local function isLethalMonsterName(mName)
    if not mName then return false end
    for _, lethalName in ipairs(Config.AvoidmoreradiusMonsters or {}) do
        if mName == lethalName then
            return true
        end
    end
    return false
end

local function isThreatened()
    local pGui        = player:FindFirstChild("PlayerGui")
    local screenGui   = pGui and pGui:FindFirstChild("ScreenGui")
    local monsterIcon = screenGui and screenGui:FindFirstChild("MonsterIcon")
    if monsterIcon and monsterIcon.Visible and type(monsterIcon.ImageTransparency) == "number" and monsterIcon.ImageTransparency < 0.99 then
        return true
    end

    if not rootPart then return false end
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, monster in pairs(monstersFolder:GetChildren()) do
            if monster:IsA("Model") then
                local chasing = monster:FindFirstChild("ChasingValue")
                if chasing and chasing.Value == character then
                    return true
                end
                local primaryPart = getMonsterPart(monster)
                if primaryPart then
                    local dist = (primaryPart.Position - rootPart.Position).Magnitude
                    if isLethalMonsterName(monster.Name) then
                        if dist <= (Config.LethalRadius or 60) then
                            return true
                        end
                    elseif not isLooseMonsterName(monster.Name) then
                        if dist <= Config.MonsterDangerRadius then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function isPointNearPassiveMonster(pt, customRadius)
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if not monstersFolder then return false end
    local checkRad = customRadius or (Config.LooseRadius or 10)
    for _, m in pairs(monstersFolder:GetChildren()) do
        if m:IsA("Model") and isLooseMonsterName(m.Name) then
            local p = getMonsterPart(m)
            if p and (p.Position - pt).Magnitude <= checkRad then
                return true
            end
        end
    end
    return false
end

local function getMinDistanceToMonsters(pt)
    local minDist = math.huge
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") then
                local p = getMonsterPart(m)
                if p then
                    local d = (p.Position - pt).Magnitude
                    if d < minDist then minDist = d end
                end
            end
        end
    end
    return minDist
end

local function isPointInsideExpandedBox(pt, part, marginXZ, marginY)
    if not part or not part:IsA("BasePart") then return false end
    marginXZ  = marginXZ or 0
    marginY   = marginY or marginXZ
    local lPt = part.CFrame:PointToObjectSpace(pt)
    return math.abs(lPt.X) <= (part.Size.X * 0.5 + marginXZ)
       and math.abs(lPt.Y) <= (part.Size.Y * 0.5 + marginY)
       and math.abs(lPt.Z) <= (part.Size.Z * 0.5 + marginXZ)
end

-- Mengembalikan apakah segmen posA -> posB menembus part, beserta titik masuk (tMin) dan keluar (tMax) [0..1]
local function segmentIntersectsExpandedBox(posA, posB, part, padXZ, padY)
    if not part or not part:IsA("BasePart") then return false, nil, nil end
    padXZ = padXZ or 1.4
    padY  = padY or 1.8

    local cf = part.CFrame
    local lA = cf:PointToObjectSpace(posA)
    local lB = cf:PointToObjectSpace(posB)
    local d  = lB - lA

    local hx = part.Size.X * 0.5 + padXZ
    local hy = part.Size.Y * 0.5 + padY
    local hz = part.Size.Z * 0.5 + padXZ

    local tMin, tMax = 0.0, 1.0

    if math.abs(d.X) < 1e-6 then
        if math.abs(lA.X) > hx then return false, nil, nil end
    else
        local inv = 1.0 / d.X
        local t1, t2 = (-hx - lA.X) * inv, (hx - lA.X) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false, nil, nil end
    end

    if math.abs(d.Y) < 1e-6 then
        if math.abs(lA.Y) > hy then return false, nil, nil end
    else
        local inv = 1.0 / d.Y
        local t1, t2 = (-hy - lA.Y) * inv, (hy - lA.Y) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false, nil, nil end
    end

    if math.abs(d.Z) < 1e-6 then
        if math.abs(lA.Z) > hz then return false, nil, nil end
    else
        local inv = 1.0 / d.Z
        local t1, t2 = (-hz - lA.Z) * inv, (hz - lA.Z) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false, nil, nil end
    end

    return (tMin <= tMax), tMin, tMax
end

local function segmentHitsPassiveMonster(posA, posB)
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if not monstersFolder then return false end
    local looseRad = Config.LooseRadius or 10
    for _, m in pairs(monstersFolder:GetChildren()) do
        if m:IsA("Model") and isLooseMonsterName(m.Name) then
            local p = getMonsterPart(m)
            if p then
                local ab = posB - posA
                local lenSq = ab.X * ab.X + ab.Z * ab.Z
                local t = 0
                if lenSq > 1e-4 then
                    t = math.clamp(((p.Position.X - posA.X) * ab.X + (p.Position.Z - posA.Z) * ab.Z) / lenSq, 0, 1)
                end
                local closestPt = posA + ab * t
                local horizDist = Vector2.new(closestPt.X - p.Position.X, closestPt.Z - p.Position.Z).Magnitude
                if horizDist <= looseRad then
                    return true
                end
            end
        end
    end
    return false
end

local function getColliderGroupKey(col)
    if not col then return nil end
    local room = Workspace:FindFirstChild("CurrentRoom")
    local map  = getMap()
    local p    = col.Parent
    if p and p:IsA("Model") and p ~= room and p ~= map then
        return p
    end
    return col
end

-- ==============================================================================
-- ANALISIS LAPIS OBJEK (0-LAPIS, 1-LAPIS TEMBUS AMAN, ATAU >=2 LAPIS TERLARANG)
-- Mengembalikan: (isValidOneLayer, layerCount, firstHitCollider)
-- Jika hanya menembus 0 atau 1 objek (ketebalan tembus <= 14 studs & tidak berdempetan dengan objek ke-2),
-- maka karakter DIIZINKAN menembus lurus objek 1 lapis tersebut!
-- ==============================================================================
local function analyzeSegmentLayers(posA, posB, ignoredCol, padXZ)
    padXZ = padXZ or 1.35
    if segmentHitsPassiveMonster(posA, posB) then
        return false, 99, nil
    end

    local allCols      = getNoClipColliders()
    local ignoredGroup = getColliderGroupKey(ignoredCol)
    local totalDist    = (posB - posA).Magnitude
    local hitGroups    = {}
    local groupList    = {}

    for _, col in ipairs(allCols) do
        if col and col.Parent and col ~= ignoredCol then
            local gKey = getColliderGroupKey(col)
            if gKey ~= ignoredGroup then
                local hit, tMin, tMax = segmentIntersectsExpandedBox(posA, posB, col, padXZ, 1.6)
                if hit and tMin and tMax then
                    local existing = hitGroups[gKey]
                    if not existing then
                        existing = { col = col, tMin = tMin, tMax = tMax }
                        hitGroups[gKey] = existing
                        table.insert(groupList, existing)
                    else
                        if tMin < existing.tMin then existing.tMin = tMin end
                        if tMax > existing.tMax then existing.tMax = tMax end
                    end
                end
            end
        end
    end

    local numLayers = #groupList
    if numLayers == 0 then
        return true, 0, nil
    elseif numLayers == 1 then
        local g = groupList[1]
        local thicknessThrough = (g.tMax - g.tMin) * totalDist
        -- Pastikan bukan menembus tembok memanjang dari ujung ke ujung (> 14 studs)
        if thicknessThrough <= 14.5 then
            return true, 1, g.col
        else
            return false, 2, g.col
        end
    else
        return false, numLayers, groupList[1].col
    end
end

local function countCollidersHitBySegment(posA, posB, ignoredCol, padXZ)
    local _, layerCount = analyzeSegmentLayers(posA, posB, ignoredCol, padXZ or 1.45)
    return layerCount
end

local function isPointStrictlyOpenAir(pt, marginXZ)
    marginXZ = marginXZ or 1.5
    if isPointNearPassiveMonster(pt, Config.LooseRadius or 10) then
        return false
    end
    for _, col in ipairs(getNoClipColliders()) do
        if col and col.Parent and isPointInsideExpandedBox(pt, col, marginXZ, 1.6) then
            return false
        end
    end
    return true
end

local function findSafeExitPointOutsideCollider(fromPos, centerPos, targetCol)
    local walkY = getSafeWalkY(centerPos.Y)
    local dir = fromPos - centerPos
    dir = Vector3.new(dir.X, 0, dir.Z)
    local baseDir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(1, 0, 0)
    local perpDir = Vector3.new(-baseDir.Z, 0, baseDir.X)
    local wSz     = getWorldBoxSize(targetCol)
    local radius  = math.max(wSz.X, wSz.Z) * 0.5 + 3.6

    local dirs = {
        baseDir, perpDir, -perpDir, -baseDir,
        (baseDir + perpDir).Unit, (baseDir - perpDir).Unit,
        (-baseDir + perpDir).Unit, (-baseDir - perpDir).Unit,
    }

    for _, d in ipairs(dirs) do
        for extra = 0, 9, 3 do
            local candidate = Vector3.new(centerPos.X, walkY, centerPos.Z) + d * (radius + extra)
            if isPointStrictlyOpenAir(candidate, 1.6) then
                if countCollidersHitBySegment(centerPos, candidate, targetCol, 1.45) == 0 then
                    return candidate
                end
            end
        end
    end
    return Vector3.new(fromPos.X, walkY, fromPos.Z)
end

-- Mencari rute ke titik tujuan dengan mengutamakan:
-- 1) Lurus 0-Lapis (Ruang terbuka)
-- 2) Lurus 1-Lapis (Tembus 1 tembok/objek tipis tanpa ada objek ke-2 di dekatnya)
-- 3) 1 atau 2 Titik Belok (Detour) yang masing-masing segmennya maksimal 1-Lapis
local function buildSmartOneLayerRoute(startPos, goalPos, allowedGoalCol)
    local walkY  = getSafeWalkY(startPos.Y)
    local pStart = Vector3.new(startPos.X, walkY, startPos.Z)
    local pGoal  = Vector3.new(goalPos.X, walkY, goalPos.Z)

    -- 1. Cek Jalur Lurus (0-Lapis atau 1-Lapis Tembus)
    local okDirect, directLayers, hitCol = analyzeSegmentLayers(pStart, pGoal, allowedGoalCol, 1.35)
    if okDirect then
        return { pGoal }, true, hitCol
    end

    -- 2. Jika jalur lurus menabrak >= 2 Lapis benda berdekatan, cari 1 titik belok (Detour)
    local dir = pGoal - pStart
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    local uDir = (flatDir.Magnitude > 0.1) and flatDir.Unit or Vector3.new(1, 0, 0)
    local perp = Vector3.new(-uDir.Z, 0, uDir.X)

    local openNodes = {}
    for _, frac in ipairs({ 0.25, 0.5, 0.75 }) do
        local basePt = pStart:Lerp(pGoal, frac)
        for _, offsetDist in ipairs({ 6.0, 11.0, 17.0, 24.0, 32.0 }) do
            for _, side in ipairs({ 1, -1 }) do
                local pt = Vector3.new(basePt.X, walkY, basePt.Z) + (perp * (offsetDist * side))
                if isPointStrictlyOpenAir(pt, 1.5) then
                    local isBad = false
                    for _, badPos in ipairs(failedRollbackZones) do
                        if (pt - badPos).Magnitude < 4.0 then isBad = true; break end
                    end
                    if not isBad then
                        table.insert(openNodes, pt)
                    end
                end
            end
        end
    end

    -- Prioritaskan 1-Belokan yang murni 0-Lapis, lalu 1-Belokan yang maksimal 1-Lapis
    for maxAllowedLayer = 0, 1 do
        local bestRoute, bestDist, bestCol = nil, math.huge, nil
        for _, n1 in ipairs(openNodes) do
            local ok1, l1, c1 = analyzeSegmentLayers(pStart, n1, nil, 1.35)
            local ok2, l2, c2 = analyzeSegmentLayers(n1, pGoal, allowedGoalCol, 1.35)
            if ok1 and ok2 and (l1 + l2) <= maxAllowedLayer then
                local d = (n1 - pStart).Magnitude + (pGoal - n1).Magnitude
                if d < bestDist then
                    bestDist  = d
                    bestRoute = { n1, pGoal }
                    bestCol   = c1 or c2
                end
            end
        end
        if bestRoute then
            return bestRoute, true, bestCol
        end
    end

    -- 3. Cek 2-Belokan di ruang terbuka jika terhalang sudut ruangan L
    for idx1, n1 in ipairs(openNodes) do
        local ok1, l1 = analyzeSegmentLayers(pStart, n1, nil, 1.35)
        if ok1 and l1 == 0 then
            for idx2, n2 in ipairs(openNodes) do
                if idx1 ~= idx2 then
                    local ok2, l2 = analyzeSegmentLayers(n1, n2, nil, 1.35)
                    if ok2 and l2 == 0 then
                        local ok3, l3, c3 = analyzeSegmentLayers(n2, pGoal, allowedGoalCol, 1.35)
                        if ok3 and l3 <= 1 then
                            return { n1, n2, pGoal }, true, c3
                        end
                    end
                end
            end
        end
    end

    return { pGoal }, false, nil
end

local function getNearestSafeColliderRoute(startPos, excludedCol)
    updateColliderCaches()
    local hideableCols = cachedHideCols
    local walkY        = getSafeWalkY(startPos.Y)
    local cleanStart   = Vector3.new(startPos.X, walkY, startPos.Z)

    if #hideableCols == 0 then
        local room = Workspace:FindFirstChild("CurrentRoom")
        if room then
            for _, v in ipairs(room:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name == "NoClip_Collider" or v.Name == "CylinderCollider") then
                    local wSz = getWorldBoxSize(v)
                    local pName = (v.Parent and v.Parent.Name or ""):lower()
                    if math.min(wSz.X, wSz.Z) >= 2.4 and not pName:find("wall") and not pName:find("railing") then
                        table.insert(hideableCols, v)
                    end
                end
            end
        end
    end

    if #hideableCols == 0 then
        return { waypoints = { cleanStart }, targetCol = nil, centerPos = cleanStart, exitPos = cleanStart }
    end

    local candidates = {}
    for _, col in ipairs(hideableCols) do
        if col and col.Parent and col ~= excludedCol then
            local wSz     = getWorldBoxSize(col)
            local minY    = col.Position.Y - (wSz.Y * 0.5) + 2.5
            local maxY    = col.Position.Y + (wSz.Y * 0.5) - 0.5
            local targetY = (minY <= maxY) and math.clamp(walkY, minY, maxY) or walkY
            local center  = Vector3.new(col.Position.X, targetY, col.Position.Z)

            local touchesAdjacentObject = (countCollidersHitBySegment(center, center, col, 1.8) > 0)
            local monsterDist           = getMinDistanceToMonsters(center)

            table.insert(candidates, {
                col         = col,
                centerPos   = center,
                dist        = (center - cleanStart).Magnitude,
                isIsolated  = not touchesAdjacentObject,
                SafeFromMob = (monsterDist > math.max(Config.MonsterDangerRadius, 12.0)),
            })
        end
    end

    if #candidates == 0 then
        return { waypoints = { cleanStart }, targetCol = nil, centerPos = cleanStart, exitPos = cleanStart }
    end

    table.sort(candidates, function(a, b)
        if a.SafeFromMob ~= b.SafeFromMob then return a.SafeFromMob end
        if a.isIsolated ~= b.isIsolated then return a.isIsolated end
        return a.dist < b.dist
    end)

    for _, cand in ipairs(candidates) do
        if cand.isIsolated then
            local ok1Layer = analyzeSegmentLayers(cleanStart, cand.centerPos, cand.col, 1.45)
            if ok1Layer then
                local exitPt = findSafeExitPointOutsideCollider(cleanStart, cand.centerPos, cand.col)
                return { waypoints = { cand.centerPos }, targetCol = cand.col, centerPos = cand.centerPos, exitPos = exitPt }
            end
        end
    end

    for _, cand in ipairs(candidates) do
        if cand.isIsolated then
            local routeWps, okRoute = buildSmartOneLayerRoute(cleanStart, cand.centerPos, cand.col)
            if okRoute and #routeWps > 0 then
                local lastBeforeCenter = (#routeWps >= 2) and routeWps[#routeWps - 1] or cleanStart
                local exitPt = findSafeExitPointOutsideCollider(lastBeforeCenter, cand.centerPos, cand.col)
                return { waypoints = routeWps, targetCol = cand.col, centerPos = cand.centerPos, exitPos = exitPt }
            end
        end
    end

    local best = candidates[1]
    local exitPt = findSafeExitPointOutsideCollider(cleanStart, best.centerPos, best.col)
    return { waypoints = { best.centerPos }, targetCol = best.col, centerPos = best.centerPos, exitPos = exitPt }
end

