    task.spawn(function()
        doTeleport(selectedGenData.cf, Config.TeleportMode, Config.TweenSpeed)
        genSt.Text = "✔ Sampai di " .. selectedGenData.label .. "!"
        task.delay(2.5, function() genSt.Text = "" end)
    end)
