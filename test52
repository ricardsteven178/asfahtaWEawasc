local function interactWithPrompt(prompt)
    prompt.RequiresLineOfSight   = false
    prompt.MaxActivationDistance = math.huge
    if fireproximityprompt then
        fireproximityprompt(prompt, 1)
    else
        pcall(function()
            prompt:InputHoldBegin()
            if prompt.HoldDuration > 0 then task.wait(prompt.HoldDuration) end
            prompt:InputHoldEnd()
        end)
    end
end

-- Menentukan Tier Prioritas suatu Item berdasarkan Config.Pickup:
-- Tier 1 = PriorityList ("ResearchCapsule")
-- Tier 2 = SecondPriorityList ("Bandage", "HealthKit")
-- Tier 3 = Item lain yang TIDAK ada di IgnoreList
-- nil    = Item masuk IgnoreList (Diabaikan)
local function getItemPriorityTier(itemName)
    if not itemName then return nil end
    local lower = itemName:lower()
    if priorityLookup[itemName] or priorityLookup[lower] then
        return 1
    end
    if secondPriorityLookup[itemName] or secondPriorityLookup[lower] then
        return 2
    end
    if ignoreLookup[itemName] or ignoreLookup[lower] then
        return nil
    end
    return 3
end

