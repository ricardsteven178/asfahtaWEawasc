-- SECTION 3: MAP & GEOMETRY HELPER FUNCTIONS
-- ==============================================================================
local function getMap()
    local cr = Workspace:FindFirstChild("CurrentRoom")
    return cr and cr:FindFirstChildWhichIsA("Model")
end

local function getModelCenter(model)
    if not model or not model:IsA("Model") then return nil end
    local total, n = Vector3.zero, 0
    for _, p in pairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            total = total + p.Position
            n = n + 1
        end
    end
    return n > 0 and (total / n) or nil
end

local function getMonsterPart(monster)
    if not monster or not monster:IsA("Model") then return nil end
    return monster.PrimaryPart
        or monster:FindFirstChild("HumanoidRootPart")
        or monster:FindFirstChildWhichIsA("BasePart", true)
end

local function getWorldBoxSize(part)
    local cf = part.CFrame
    local sz = part.Size
    local wx = math.abs(cf.RightVector.X) * sz.X + math.abs(cf.UpVector.X) * sz.Y + math.abs(cf.LookVector.X) * sz.Z
    local wy = math.abs(cf.RightVector.Y) * sz.X + math.abs(cf.UpVector.Y) * sz.Y + math.abs(cf.LookVector.Y) * sz.Z
    local wz = math.abs(cf.RightVector.Z) * sz.X + math.abs(cf.UpVector.Z) * sz.Y + math.abs(cf.LookVector.Z) * sz.Z
    return Vector3.new(wx, wy, wz)
end

local function getSafePlaceCFrame()
    local elevators = Workspace:FindFirstChild("Elevators")
    if elevators then
        for _, el in ipairs(elevators:GetChildren()) do
            if el.Name == "Elevator" and el:IsA("Model") then
                local ds  = el:FindFirstChild("DandyStore")
                local dsh = ds and ds:FindFirstChild("DandyShop")
                local r   = dsh and dsh:FindFirstChild("RootPart")
                if r then return r.CFrame * CFrame.new(0, 3, 0) end
            end
        end
    end

    local map = getMap()
    if map then
        local fa = map:FindFirstChild("FreeArea")
        local fe = fa and fa:FindFirstChild("FakeElevator")
        if fe and fe:IsA("Model") then
            local c = getModelCenter(fe)
            if c then return CFrame.new(c) end
        end
    end
    return nil
end

-- [OPTIMIZED] Mencari CFrame Real Elevator dengan Cache per-ruangan (Tanpa Workspace:GetDescendants() yang bikin lag)
local function getRealElevatorCFrame()
    local walkY = (rootPart and rootPart.Position.Y > -50 and rootPart.Position.Y < 200) and rootPart.Position.Y or nil
    local curMap = getMap()

    if cachedRealElevCF and cachedRealElevRoom == curMap then
        return CFrame.new(cachedRealElevCF.X, walkY or cachedRealElevCF.Y, cachedRealElevCF.Z)
    end

    local elevatorsFolder = Workspace:FindFirstChild("Elevators")
    if elevatorsFolder then
        for _, obj in ipairs(elevatorsFolder:GetChildren()) do
            if obj.Name == "Elevator" and obj:IsA("Model") then
                if obj.PrimaryPart then
                    local p = obj.PrimaryPart.Position
                    cachedRealElevCF   = CFrame.new(p.X, p.Y + 3, p.Z)
                    cachedRealElevRoom = curMap
                    return CFrame.new(p.X, walkY or (p.Y + 3), p.Z)
                else
                    local centerPos = getModelCenter(obj)
                    if centerPos then
                        cachedRealElevCF   = CFrame.new(centerPos.X, centerPos.Y + 3, centerPos.Z)
                        cachedRealElevRoom = curMap
                        return CFrame.new(centerPos.X, walkY or (centerPos.Y + 3), centerPos.Z)
                    end
                end
            end
        end
        for _, obj in ipairs(elevatorsFolder:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                cachedRealElevCF   = cf
                cachedRealElevRoom = curMap
                return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
            end
        end
    end

    local room = Workspace:FindFirstChild("CurrentRoom")
    if room then
        for _, obj in ipairs(room:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local parentName = string.lower(obj.Parent and obj.Parent.Name or "")
                if not string.find(parentName, "fake") then
                    local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                    cachedRealElevCF   = cf
                    cachedRealElevRoom = curMap
                    return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
                end
            end
        end
    end
    return nil
end

local function getMachineProgress()
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        local specGui = pGui:FindFirstChild("SpectatorGui")
        local info = specGui and specGui:FindFirstChild("InfoFrame")
        local genFrame = info and info:FindFirstChild("GeneratorFrame")
        local msg = genFrame and genFrame:FindFirstChild("Message")
        if msg and msg:IsA("TextLabel") then
            local cur, tot = string.match(msg.Text, "Machines Completed: (%d+)/(%d+)")
            if cur and tot then
                return tonumber(cur), tonumber(tot)
            end
        end
    end
    return -1, -1
end

local function isFloorAllMachinesDone()
    local map = getMap()
    local genFolder = map and map:FindFirstChild("Generators")
    if not genFolder then return false, -1, -1 end

    local totalGens, uncompletedCount = 0, 0
    for _, gen in ipairs(genFolder:GetChildren()) do
        if gen:IsA("Model") then
            local stats = gen:FindFirstChild("Stats")
            if stats then
                totalGens = totalGens + 1
                local completed = stats:FindFirstChild("Completed") and stats.Completed.Value
                if not completed then
                    uncompletedCount = uncompletedCount + 1
                end
            end
        end
    end

    if totalGens == 0 then return false, -1, -1 end

    local curGenUI, totGenUI = getMachineProgress()
    if curGenUI ~= -1 and totGenUI ~= -1 and totGenUI > 0 then
        return (curGenUI >= totGenUI), curGenUI, totGenUI
    end
    return (uncompletedCount == 0), (totalGens - uncompletedCount), totalGens
end

