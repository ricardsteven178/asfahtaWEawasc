        puSt.Text = msg
        if not isPickingUp or msg:find("Selesai") or msg:find("tidak ada") then
            task.delay(2.5, function()
                if not isPickingUp then
                    puSt.Text              = ""
                    puBtn.BackgroundColor3 = Color3.fromRGB(40, 130, 65)
                    puBtn.Text             = "🎯 Ambil Item Dropdown Manual"
                    puBtn.Active           = true
                    refreshDd()
                end
            end)
        end
    end)
end)

