    if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
    abortBtn.Text          = "🛑 Aborting..."
    puBtn.BackgroundColor3 = Color3.fromRGB(40, 130, 65)
    puBtn.Text             = "🎯 Ambil Item Dropdown Manual"
