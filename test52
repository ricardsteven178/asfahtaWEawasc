-- ==============================================================================
-- SMART PRIORITY ITEM PICKUP ENGINE (MONSTER-AWARE DYNAMIC REROUTING)
-- 1. Jika specificTargetName == nil, otomatis ambil berdasarkan Config.Pickup
--    (PriorityList -> SecondPriorityList -> Non-Ignored) & jarak terdekat.
-- 2. Jika ada monster di dekat item yang dituju (atau saat sedang jalan ke item itu),
--    langsung alihkan tujuan ke item aman lain terlebih dahulu!
-- ==============================================================================
local function runSmartItemPickup(specificTargetName, cb)
    if isPickingUp then return end
    isPickingUp   = true
    abortTeleport = false
    rebuildPickupLookups()

    local moveMode  = Config.SyncPickupWithMain and Config.TeleportMode or (Config.Pickup and Config.Pickup.MovementMode or Config.PickupMode)
    local moveSpeed = Config.SyncPickupWithMain and Config.TweenSpeed or (Config.Pickup and Config.Pickup.TweenSpeed or Config.PickupTweenSpeed)

    task.spawn(function()
        updateColliderCaches()

        local function makePlatform(atPos)
            local plat = Instance.new("Part")
            plat.Size         = Vector3.new(10, 1, 10)
            plat.Anchored     = true
            plat.CanCollide   = true
            plat.Transparency = 1
            plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
            plat.Parent       = Workspace
            return plat
        end

        local skipCounts      = {}
        local cooldownUntil   = {} -- Cooldown sementara untuk item yang sedang dijaga monster agar pindah ke item lain dulu

        -- Menyusun daftar kandidat item di ruangan berdasarkan:
        -- 1) Aman dari monster (tidak sedang dijaga monster)
        -- 2) Tier Prioritas (1 = PriorityList, 2 = SecondPriorityList, 3 = Non-Ignored)
        -- 3) Jarak terdekat dari posisi LocalPlayer sekarang
        local function getSortedCandidateItems()
            local safeList    = {}
            local guardedList = {}
            local map         = getMap()
            local folder      = map and map:FindFirstChild("Items")
            if not folder or not rootPart then return safeList, guardedList end

            local now   = os.clock()
            local rpPos = rootPart.Position

            for _, item in ipairs(folder:GetChildren()) do
                if item:IsA("Model") and item.Parent and (skipCounts[item] or 0) < 3 then
                    local tier = nil
                    if specificTargetName then
                        if item.Name == specificTargetName then tier = 1 end
                    else
                        tier = getItemPriorityTier(item.Name)
                    end

                    if tier ~= nil then
                        local itemPos = item:GetPivot().Position
                        local dist    = (rpPos - itemPos).Magnitude
                        local isOnCooldown = (cooldownUntil[item] and now < cooldownUntil[item])
                        local isDangerous  = isOnCooldown or isItemAreaDangerous(itemPos)

                        local entry = {
                            instance = item,
                            name     = item.Name,
                            tier     = tier,
                            pos      = itemPos,
                            dist     = dist,
                        }

                        if isDangerous then
                            table.insert(guardedList, entry)
                        else
                            table.insert(safeList, entry)
                        end
                    end
                end
            end

            local function sortFn(a, b)
                if a.tier ~= b.tier then
                    return a.tier < b.tier -- Tier 1 (ResearchCapsule) lebih dulu dari Tier 2 (Bandage/HealthKit)
                end
                return a.dist < b.dist -- Di dalam tier yang sama, ambil yang paling dekat!
            end

            table.sort(safeList, sortFn)
            table.sort(guardedList, sortFn)
            return safeList, guardedList
        end

        local initSafe, initGuarded = getSortedCandidateItems()
        if #initSafe == 0 and #initGuarded == 0 then
            if cb then
                cb(specificTargetName and ("Item '" .. specificTargetName .. "' tidak ada!") or "✔ Semua item prioritas sudah bersih!")
            end
            isPickingUp = false
            return
        end

        while isPickingUp and not abortTeleport and _G.TeleportGUI_Loaded do
            -- 1. Jika karakter kita sendiri sedang terancam monster, sembunyi dulu ke tengah Collider tebal terdekat
            if isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
            end

            local safeCandidates, guardedCandidates = getSortedCandidateItems()
            if #safeCandidates == 0 and #guardedCandidates == 0 then
                break
            end

            local chosen = safeCandidates[1]

            -- 2. Jika semua item yang tersisa sedang dijaga monster di dekatnya:
            if not chosen then
                if isThreatened() then
                    performColliderHide(function(msg) if cb then cb(msg) end end)
                    continue
                end
                -- Jika mode Instant / Hybrid, masih bisa menyambar cepat; jika Tween, tunggu sebentar hingga monster bergeser dari item
                if moveMode == "Instant" or Config.HybridYMode then
                    chosen = guardedCandidates[1]
                else
                    local guardedName = guardedCandidates[1].name
                    if cb then
                        cb("⏳ Menunggu monster menjauh dari " .. guardedName .. " (" .. #guardedCandidates .. " tersisa)...")
                    end
                    task.wait(0.8)
                    -- Lepas cooldown jika sudah menunggu
                    for k in pairs(cooldownUntil) do cooldownUntil[k] = nil end
                    continue
                end
            end

            local item    = chosen.instance
            local itemPos = chosen.pos
            local totalRem = #safeCandidates + #guardedCandidates

            if cb then
                local prioTag = (chosen.tier == 1) and "⭐ " or (chosen.tier == 2 and "💊 " or "🎯 ")
                cb(string.format("%sAmbil %s ( %.0fm | Sisa: %d )...", prioTag, chosen.name, chosen.dist, totalRem))
            end

            local itemStandY = getTargetStandingY(itemPos.Y, false)
            local targetPos  = Vector3.new(itemPos.X, itemStandY, itemPos.Z)
            local targetCF   = CFrame.new(targetPos)

            -- Fungsi deteksi real-time selama berjalan menuju item:
            -- Jika tiba-tiba ada monster mendekati item tujuan dan masih ada item lain yang aman, batalkan jalan & pindah ke item lain!
            local switchedToOtherItem = false
            local function shouldRerouteToSaferItem()
                if not item or not item.Parent then return true end
                if moveMode == "Tween" and isItemAreaDangerous(item:GetPivot().Position) then
                    cooldownUntil[item] = os.clock() + 4.5 -- Tandai item ini berbahaya selama 4.5 detik agar langsung pindah ke item lain
                    switchedToOtherItem = true
                    return true
                end
                return false
            end

            local moveInterrupted = false
            if Config.HybridYMode then
                executeHybridYTeleport(targetCF, function(msg) if cb then cb(msg) end end)
            elseif moveMode == "Tween" and Config.PathfindMode then
                task.spawn(function() pathfindTween(targetCF, nil, 0, false) end)
                local w = 0
                while not isPathfinding and w < 0.6 do task.wait(0.05); w = w + 0.05 end
                w = 0
                while (isPathfinding or isHiding) and w < 45 and not abortTeleport and isPickingUp do
                    if shouldRerouteToSaferItem() then
                        if activeTween then pcall(function() activeTween:Cancel() end) end
                        pcall(function() RunService:UnbindFromRenderStep("_TeleportWalkSim") end)
                        isPathfinding = false
                        break
                    end
                    task.wait(0.1)
                    w = w + 0.1
                end
                task.wait(0.08)
            elseif moveMode == "Tween" and Config.UndergroundTeleport then
                local downY = rootPart.Position.Y - Config.UGDepth
                moveInterrupted = teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
                if not moveInterrupted and not abortTeleport then
                    moveInterrupted = teleportTween(CFrame.new(targetCF.X, downY, targetCF.Z), moveSpeed, false, true, shouldRerouteToSaferItem)
                end
                if not moveInterrupted and not abortTeleport and not switchedToOtherItem then
                    moveInterrupted = teleportTween(CFrame.new(targetCF.X, itemStandY, targetCF.Z), Config.UGRiseSpeed, false, true)
                end
            elseif moveMode == "Tween" then
                moveInterrupted = safeSingleLayerTween(targetCF, moveSpeed, false, shouldRerouteToSaferItem)
            else
                teleportInstant(targetCF, false)
            end

            if abortTeleport or not isPickingUp then break end

            -- 3. Jika batal karena ada monster di dekat item tujuan -> Langsung lanjut loop untuk pindah ke item aman berikutnya!
            if switchedToOtherItem then
                if cb then cb("🔀 Monster di dekat " .. chosen.name .. "! Beralih ke item aman lain...") end
                task.wait(0.08)
                continue
            end

            -- 4. Jika karakter kita yang terancam monster di tengah jalan -> Sembunyi dulu, lalu lanjut ambil item lain!
            if moveInterrupted or isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.1)
                continue
            end

            -- Jika item sudah terambil oleh AuraRange di tengah jalan, langsung lanjut ke item berikutnya!
            if not item.Parent then
                task.wait(0.05)
                continue
            end

            local horizDist = Vector2.new(rootPart.Position.X - itemPos.X, rootPart.Position.Z - itemPos.Z).Magnitude
            if horizDist > 11.5 then
                skipCounts[item] = (skipCounts[item] or 0) + 1
                task.wait(0.1)
                continue
            end

            -- 5. Eksekusi ProximityPrompt pada item
            local holdTargetPos = rootPart.Position
            local plat = makePlatform(holdTargetPos)
            local holdPickupConn = startServerSyncedHold(function() return holdTargetPos end)
            local waitTicks = 0
            local monsterInterrupted = false

            while item.Parent and waitTicks < 18 and not abortTeleport and isPickingUp do
                if isThreatened() then
                    monsterInterrupted = true
                    break
                end
                if moveMode == "Tween" and isItemAreaDangerous(itemPos) then
                    cooldownUntil[item] = os.clock() + 4.5
                    switchedToOtherItem = true
                    break
                end

                local pp   = item:FindFirstChild("Prompt")
                local prox = pp and pp:FindFirstChild("ProximityPrompt")
                if prox and prox.Enabled then
                    interactWithPrompt(prox)
                end

                task.wait(0.08)
                waitTicks = waitTicks + 1
            end

            if holdPickupConn then holdPickupConn:Disconnect(); holdPickupConn = nil end
            if plat and plat.Parent then plat:Destroy() end
            if rootPart then rootPart.Anchored = false end

            if monsterInterrupted then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.1)
                continue
            end

            if switchedToOtherItem then
                if cb then cb("🔀 Monster mendekat! Pindah ke item lain...") end
                task.wait(0.08)
                continue
            end

            if item.Parent then
                skipCounts[item] = (skipCounts[item] or 0) + 1
            end

            if Config.HybridYMode and not abortTeleport and isPickingUp then
                moveIntoNearestColliderCenter(Config.TweenSpeed, true)
                setTargetColliderPassable(nil, false)
                restoreNormalGravity()
                task.wait(0.12)
            else
                restoreNormalGravity()
                task.wait(0.12)
            end
        end

        clearAllServerSyncedHolds()
        if rootPart then rootPart.Anchored = false end
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        isPickingUp = false
        if pfStatusRef then
            pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih"
            pfStatusRef.TextColor3 = Color3.fromRGB(90, 90, 120)
        end
        if cb then
            cb(specificTargetName and ("✔ Selesai ambil " .. specificTargetName .. "!") or "✔ Semua item prioritas selesai diambil!")
        end
    end)
end

