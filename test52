-- [OPTIMIZED] teleportTween dengan Throttled Obstacle Sensor & Custom Cancel Predicate (untuk Dynamic Reroute)
local function teleportTween(cf, speed, ignoreThreat, forceSnapEnd, customCancelFn)
    if not rootPart or not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    rootPart.Anchored = false

    local targetPos    = cf.Position
    local startPos     = rootPart.Position
    local verticalDiff = math.abs(targetPos.Y - startPos.Y)

    local baseSpd    = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
    local origWalk   = (hum and hum.WalkSpeed > 0) and hum.WalkSpeed or 16
    local openMult   = speed or Config.TweenSpeed or 2.25
    local noclipMult = Config.NoClipTweenSpeed or 1.05

    local _, segLayers = analyzeSegmentLayers(startPos, targetPos, nil, 1.8)
    local isSlopedStageMove = (verticalDiff > 1.8)
    local isVerticalMove    = Config.UndergroundTeleport or isSlopedStageMove

    local effectiveMult = (isSlopedStageMove and segLayers > 0) and math.min(openMult, noclipMult) or openMult
    local moveSpd       = baseSpd * effectiveMult
    local cancelled     = false

    local sensorParams = OverlapParams.new()
    sensorParams.FilterType = Enum.RaycastFilterType.Exclude
    sensorParams.FilterDescendantsInstances = { character }

    local function isTouchingOrApproachingObstacle(curPos, dirUnit)
        local behindPos = curPos - (dirUnit * 2.5)
        local midAhead  = curPos + (dirUnit * 3.0)
        local farAhead  = curPos + (dirUnit * 5.8)

        for _, col in ipairs(getNoClipColliders()) do
            if col and col.Parent then
                if isPointInsideExpandedBox(curPos, col, 4.2, 2.5)
                   or isPointInsideExpandedBox(behindPos, col, 3.2, 2.5)
                   or isPointInsideExpandedBox(midAhead, col, 4.2, 2.5)
                   or isPointInsideExpandedBox(farAhead, col, 3.8, 2.5) then
                    return true
                end
            end
        end

        local ok, parts = pcall(function()
            return Workspace:GetPartBoundsInBox(CFrame.new(curPos + (dirUnit * 2.2)), Vector3.new(7.2, 3.0, 7.2), sensorParams)
        end)
        if ok and parts then
            for _, p in ipairs(parts) do
                if p and p:IsA("BasePart") and not isFloorPart(p) then
                    local pn = p.Name
                    if (pn ~= "_NoClipESP" and pn ~= "_LineESPBeam" and pn ~= "_PFVirtualBlocker" and p.Transparency < 0.98)
                       or isColliderName(pn) or pn == "InvisBlock" then
                        return true
                    end
                end
            end
        end
        return false
    end

    forceCharNoClip = true
    if Config.NoClip then applyNoClipState() end

    if not isVerticalMove and hum then
        restoreNormalGravity()
        hum.PlatformStand = false
        hum.Sit           = false
        if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.None then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end

        local currentDir = Vector3.zero
        local stepBindName = "_TeleportWalkSim"
        pcall(function() RunService:UnbindFromRenderStep(stepBindName) end)

        RunService:BindToRenderStep(stepBindName, Enum.RenderPriority.Character.Value + 10, function()
            if rootPart and hum and hum.Parent and currentDir.Magnitude > 0.01 then
                hum.WalkSpeed = moveSpd
                hum:Move(currentDir, false)
            end
        end)

        local totalDist          = Vector2.new(targetPos.X - startPos.X, targetPos.Z - startPos.Z).Magnitude
        local minSpdEst          = baseSpd * math.min(openMult, noclipMult)
        local timeoutClock       = os.clock() + math.max((totalDist / math.max(minSpdEst, 5)) * 3.0, 4.0)
        local lastPos            = rootPart.Position
        local stuckTimer         = 0
        local lastObstacleClock  = 0
        local lastSensorCheck    = 0
        local cachedNearObstacle = false

        while rootPart and hum and hum.Parent and os.clock() < timeoutClock do
            if abortTeleport or (not ignoreThreat and isThreatened()) or (customCancelFn and customCancelFn()) then
                cancelled = true
                break
            end

            local curPos   = rootPart.Position
            local flatDiff = Vector3.new(targetPos.X - curPos.X, 0, targetPos.Z - curPos.Z)
            local dist     = flatDiff.Magnitude

            if dist <= 1.6 then
                break
            end

            currentDir = flatDiff.Unit

            -- Throttle sensor GetPartBoundsInBox setiap 0.07s agar CPU sangat ringan
            local now = os.clock()
            if (now - lastSensorCheck) >= 0.07 then
                lastSensorCheck    = now
                cachedNearObstacle = isTouchingOrApproachingObstacle(curPos, currentDir)
                if cachedNearObstacle then
                    lastObstacleClock = now
                end
            end

            if cachedNearObstacle or (now - lastObstacleClock) < 0.28 or dist <= 4.5 then
                moveSpd = baseSpd * noclipMult
            else
                moveSpd = baseSpd * openMult
            end

            hum.WalkSpeed = moveSpd
            hum:Move(currentDir, false)

            local dt = RunService.Heartbeat:Wait()
            if not rootPart then break end

            if (rootPart.Position - lastPos).Magnitude < 0.08 then
                stuckTimer = stuckTimer + dt
                if stuckTimer > 0.25 then
                    applyNoClipState()
                    stuckTimer = 0
                end
            else
                stuckTimer = 0
                lastPos = rootPart.Position
            end
        end

        currentDir = Vector3.zero
        pcall(function() RunService:UnbindFromRenderStep(stepBindName) end)
        if hum and hum.Parent then
            hum:Move(Vector3.zero, false)
            hum.WalkSpeed = origWalk
        end
    else
        Workspace.Gravity = 0
        local dist = (startPos - targetPos).Magnitude
        local dur  = math.max(dist / math.max(moveSpd, 1), 0.001)
        local tw   = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
        activeTween = tw
        tw:Play()

        local done = false
        tw.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed then done = true end
        end)

        while not done do
            if abortTeleport or (not ignoreThreat and isThreatened()) or (customCancelFn and customCancelFn()) then
                tw:Cancel()
                cancelled = true
                break
            end
            task.wait(0.015)
        end

        if not cancelled and rootPart and (rootPart.Position - targetPos).Magnitude <= 4.0 then
            rootPart.CFrame = cf
        end
        if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end
        if activeTween == tw then activeTween = nil end
    end

    if not Config.NoClip and not isHiding then
        forceCharNoClip = false
    end
    if not isPathfinding and not isHiding then
        restoreNormalGravity()
    end

    return cancelled
end

local function moveIntoNearestColliderCenter(speed, ignoreThreat, excludedCol)
    if not rootPart then return nil, nil end
    rootPart.Anchored = false
    local startPos  = clampPositionAboveFloor(rootPart.Position, 3.1)
    local hideRoute = getNearestSafeColliderRoute(startPos, excludedCol)
    local targetCol = hideRoute.targetCol

    setTargetColliderPassable(targetCol, true)
    local moveSpd = speed or math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)

    for i, wpPos in ipairs(hideRoute.waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then break end
        local isLast = (i == #hideRoute.waypoints)
        local cancelled = teleportTween(CFrame.new(wpPos), moveSpd, ignoreThreat, isLast)
        if cancelled and not ignoreThreat then
            return nil, hideRoute
        end
    end

    if rootPart and hideRoute.centerPos and not abortTeleport then
        if (rootPart.Position - hideRoute.centerPos).Magnitude <= 3.5 then
            rootPart.CFrame = CFrame.new(hideRoute.centerPos)
            character:PivotTo(CFrame.new(hideRoute.centerPos))
        end
    end
    return hideRoute.centerPos, hideRoute
end

local function executeHybridYTeleport(targetCF, statusFn)
    if not rootPart then return false end

    if statusFn then statusFn("1/3 🛡 Menuju tengah Collider tebal terdekat...", Color3.fromRGB(255, 190, 80)) end
    local centerPos = moveIntoNearestColliderCenter(Config.TweenSpeed, false)
    if abortTeleport or not rootPart then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if not centerPos then
        centerPos = moveIntoNearestColliderCenter(math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5), true)
    end
    if not centerPos then centerPos = rootPart.Position end

    task.wait(0.05)

    local bypassY   = Config.HybridBypassY
    local waitDelay = math.max(Config.HybridBypassDelay or 0.4, 0.05)
    local bypassCF  = CFrame.new(centerPos.X, bypassY, centerPos.Z)

    Workspace.Gravity = 0
    teleportInstant(bypassCF, true)

    local holdConn = RunService.Heartbeat:Connect(function()
        if rootPart and not abortTeleport then
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = bypassCF
        end
    end)

    local elapsed = 0
    while elapsed < waitDelay and not abortTeleport and _G.TeleportGUI_Loaded do
        local remain = math.max(waitDelay - elapsed, 0)
        if statusFn then
            statusFn(string.format("2/3 ⏳ Stay di Y=%.0f (%.2fs)...", bypassY, remain), Color3.fromRGB(120, 220, 255))
        end
        local step = math.min(0.05, waitDelay - elapsed)
        task.wait(step)
        elapsed = elapsed + step
    end

    if holdConn then holdConn:Disconnect() end

    if abortTeleport or not rootPart then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    local destPos     = targetCF.Position
    local finalDestCF = CFrame.new(destPos)
    if statusFn then
        statusFn(string.format("3/3 💥 Boom! Instant ke (%.0f, %.0f, %.0f)", destPos.X, destPos.Y, destPos.Z), Color3.fromRGB(100, 255, 160))
    end
    teleportInstant(finalDestCF, true)
    task.wait(0.05)
    teleportInstant(finalDestCF, false)

    setTargetColliderPassable(nil, false)
    restoreNormalGravity()
    return true
end

local function safeSingleLayerTween(targetCF, speed, ignoreThreat, customCancelFn)
    if not rootPart then return false end
    local walkY    = getSafeWalkY(rootPart.Position.Y)
    local goalY    = getTargetStandingY(targetCF.Position.Y, true)
    local startPos = Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z)
    local goalPos  = Vector3.new(targetCF.Position.X, goalY, targetCF.Position.Z)

    local goalCol = nil
    for _, col in ipairs(getNoClipColliders()) do
        if col and col.Parent and isPointInsideExpandedBox(goalPos, col, 1.5, 2.0) then
            goalCol = col
            break
        end
    end

    local routeWps, okOneLayer, penetratedCol = buildSmartOneLayerRoute(startPos, goalPos, goalCol)

    if okOneLayer and #routeWps > 0 then
        if penetratedCol then
            setTargetColliderPassable(penetratedCol, true)
        end
        if goalCol then
            setTargetColliderPassable(goalCol, true)
        end
        forceCharNoClip = true

        local cancelled = false
        for i, wp in ipairs(routeWps) do
            if abortTeleport or not _G.TeleportGUI_Loaded then
                cancelled = true
                break
            end
            clearPathVisuals()
            drawWaypoint(wp, (i == #routeWps) and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(80, 200, 255))
            cancelled = teleportTween(CFrame.new(wp), speed or Config.TweenSpeed, ignoreThreat, true, customCancelFn)
            if cancelled or abortTeleport then
                break
            end
        end

        clearPathVisuals()
        setTargetColliderPassable(nil, false)

        if abortTeleport then
            return true
        end

        if cancelled then
            if not isPickingUp and not ignoreThreat and isThreatened() then
                local resumed = performColliderHide(function(txt, col)
                    if pfStatusRef then pfStatusRef.Text = txt; pfStatusRef.TextColor3 = col or Color3.fromRGB(255, 180, 80) end
                end)
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded then
                    return safeSingleLayerTween(targetCF, speed, ignoreThreat, customCancelFn)
                end
            end
            return true
        end

        task.wait(0.06)
        if rootPart and (rootPart.Position - goalPos).Magnitude <= 6.5 then
            return false
        else
            recordFailedRollbackZone(routeWps[1])
        end
    end

    if not isPathfinding and not abortTeleport then
        if pfStatusRef then
            pfStatusRef.Text = "🔄 >=2 Lapis terdeteksi! Memutar tanpa tembus..."
            pfStatusRef.TextColor3 = Color3.fromRGB(255, 190, 70)
        end
        pathfindTween(CFrame.new(goalPos), nil, 1, true)
    end

    return false
end

performColliderHide = function(statusFn)
    if not rootPart then return false end
    rootPart.Anchored = false
    isHiding = true

    local hideSpeed = math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)
    local centerPos, hideRoute = moveIntoNearestColliderCenter(hideSpeed, true)
    if abortTeleport or not _G.TeleportGUI_Loaded then
        isHiding = false
        clearAllServerSyncedHolds()
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    local targetCol    = hideRoute and hideRoute.targetCol
    local pName        = (targetCol and targetCol.Parent and targetCol.Parent.Name) or (targetCol and targetCol.Name) or "Collider"
    local finalHidePos = (rootPart and centerPos and (rootPart.Position - centerPos).Magnitude <= 4.5) and rootPart.Position or (centerPos or rootPart.Position)

    local hidePlat = Instance.new("Part")
    hidePlat.Size         = Vector3.new(10, 1, 10)
    hidePlat.Anchored     = true
    hidePlat.CanCollide   = true
    hidePlat.Transparency = 1
    hidePlat.CFrame       = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
    hidePlat.Parent       = Workspace

    local syncConn = startServerSyncedHold(function() return finalHidePos end)
    local syncRetryCount = 0

    local function verifyAndFixRealHidePosition()
        if not rootPart or abortTeleport or not _G.TeleportGUI_Loaded or syncRetryCount >= 1 then return end
        local desyncDist = (rootPart.Position - finalHidePos).Magnitude
        if desyncDist > 4.5 then
            syncRetryCount = syncRetryCount + 1
            if syncConn then syncConn:Disconnect(); syncConn = nil end
            if statusFn then statusFn("⚠ Sinkronisasi fisik ke tengah " .. pName .. "...", Color3.fromRGB(255, 160, 60)) end
            setTargetColliderPassable(targetCol, true)
            teleportTween(CFrame.new(finalHidePos), hideSpeed * 0.85, true, true)
            if rootPart and not abortTeleport then
                finalHidePos = rootPart.Position
                syncConn = startServerSyncedHold(function() return finalHidePos end)
            end
        end
    end

    if statusFn then statusFn("🛡 Sembunyi di tengah " .. pName .. ", tunggu monster...", Color3.fromRGB(220, 80, 80)) end
    local hideStartClock = os.clock()
    while isThreatened() and (os.clock() - hideStartClock) < 20 and not abortTeleport and _G.TeleportGUI_Loaded do
        verifyAndFixRealHidePosition()
        if hidePlat and hidePlat.Parent and rootPart then
            hidePlat.CFrame = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
        end
        task.wait(0.2)
    end

    if statusFn and not abortTeleport then
        statusFn("⏳ Tunggu " .. Config.MonsterSafeDelay .. "s sebelum keluar collider...", Color3.fromRGB(180, 180, 60))
    end
    local safeStartClock = os.clock()
    while (os.clock() - safeStartClock) < Config.MonsterSafeDelay and (os.clock() - hideStartClock) < 28 and not abortTeleport and _G.TeleportGUI_Loaded do
        if isThreatened() then
            if statusFn then statusFn("🛡 Monster kembali! Tetap di tengah " .. pName .. "...", Color3.fromRGB(220, 80, 80)) end
            safeStartClock = os.clock()
        end
        task.wait(0.2)
    end

    clearAllServerSyncedHolds()
    if hidePlat and hidePlat.Parent then hidePlat:Destroy() end
    if rootPart then rootPart.Anchored = false end
    isHiding = false

    if abortTeleport or not _G.TeleportGUI_Loaded then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if not Config.HybridYMode then
        if statusFn then statusFn("↩ Aman! Keluar ke ruang terbuka...", Color3.fromRGB(100, 220, 150)) end
        if hideRoute and hideRoute.exitPos then
            teleportTween(CFrame.new(hideRoute.exitPos), Config.TweenSpeed, true, true)
        end
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        task.wait(0.25)
    else
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
    end

    return true
end

pathfindTween = function(targetCF, statusCb, _attempt, skipFirstLayerTry)
    if isPathfinding or not rootPart then return end
    isPathfinding = true
    abortTeleport = false
    clearPathVisuals()
    updateColliderCaches()

    local function setStatus(txt, col)
        if pfStatusRef then
            pfStatusRef.Text       = txt
            pfStatusRef.TextColor3 = col or Color3.fromRGB(160, 120, 255)
        end
        if statusCb then statusCb(txt) end
    end

    local walkY         = getSafeWalkY(rootPart.Position.Y)
    local targetY       = getTargetStandingY(targetCF.Position.Y, true)
    local startFlat     = Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z)
    local computeTarget = Vector3.new(targetCF.Position.X, targetY, targetCF.Position.Z)
    local attempt       = _attempt or 0
    local comboMode     = Config.PathfindMode and Config.UndergroundTeleport

    if attempt == 0 and not skipFirstLayerTry and not comboMode then
        local goalCol = nil
        for _, col in ipairs(cachedAllCols) do
            if col and col.Parent and isPointInsideExpandedBox(computeTarget, col, 1.5, 2.0) then
                goalCol = col
                break
            end
        end

        local okDirect, layerCount, hitCol = analyzeSegmentLayers(startFlat, computeTarget, goalCol, 1.35)
        if okDirect and layerCount <= 1 then
            setStatus("⚡ Jalur 1-Lapis aman! Tembus NoClip langsung...", Color3.fromRGB(100, 240, 160))
            if hitCol then setTargetColliderPassable(hitCol, true) end
            if goalCol then setTargetColliderPassable(goalCol, true) end
            forceCharNoClip = true

            drawWaypoint(computeTarget, Color3.fromRGB(0, 255, 120))
            local isInterrupted = teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true)
            clearPathVisuals()
            setTargetColliderPassable(nil, false)

            if isInterrupted and isThreatened() then
                restoreNormalGravity()
                local resumed = performColliderHide(setStatus)
                isPathfinding = false
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded then
                    pathfindTween(targetCF, statusCb, 1, true)
                end
                return
            end

            task.wait(0.06)
            if rootPart and (rootPart.Position - computeTarget).Magnitude <= 5.5 then
                isPathfinding = false
                restoreNormalGravity()
                setStatus("✔ Tembus 1-Lapis selesai!", Color3.fromRGB(100, 220, 150))
                task.delay(1.5, function()
                    if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih" end
                end)
                return
            else
                setStatus("🔄 Tembus gagal (>=2 Lapis), beralih ke rute memutar...", Color3.fromRGB(255, 180, 60))
            end
        end
    end

    local currentParams = (attempt >= 2) and AGENT_PARAMS_LASTRESORT
                       or (attempt == 1) and AGENT_PARAMS_FALLBACK
                       or AGENT_PARAMS

    for _, col in ipairs(cachedAllCols) do
        if col and col:IsA("BasePart") then col.CanCollide = true end
    end

    local tempVirtualBlockers = {}
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        local looseSize = (Config.LooseRadius or 10) * 1.9
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") and isLooseMonsterName(m.Name) then
                local mp = getMonsterPart(m)
                if mp and rootPart and (mp.Position - rootPart.Position).Magnitude > 3.0 and (mp.Position - computeTarget).Magnitude > 4.0 then
                    local mb = Instance.new("Part")
                    mb.Name         = "_PFVirtualBlocker"
                    mb.Size         = Vector3.new(looseSize, 12, looseSize)
                    mb.Position     = mp.Position
                    mb.Anchored     = true
                    mb.CanCollide   = true
                    mb.Transparency = 1
                    mb.Parent       = Workspace
                    table.insert(tempVirtualBlockers, mb)
                end
            end
        end
    end

    local path = PathfindingService:CreatePath(currentParams)
    local ok   = pcall(function() path:ComputeAsync(startFlat, computeTarget) end)

    for _, vb in ipairs(tempVirtualBlockers) do
        pcall(function() vb:Destroy() end)
    end

    if Config.NoClip then
        applyNoClipState()
    else
        for _, col in ipairs(cachedAllCols) do
            if col and col:IsA("BasePart") then col.CanCollide = true end
        end
    end

    if not ok or path.Status ~= Enum.PathStatus.Success then
        if attempt < 2 then
            isPathfinding = false
            task.wait(0.05)
            pathfindTween(targetCF, statusCb, attempt + 1, true)
            return
        else
            setStatus("⚠ Rute sempit, paksa gerak ke tujuan...", Color3.fromRGB(220, 140, 60))
            forceCharNoClip = true
            teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true)
            forceCharNoClip = false
            isPathfinding = false
            restoreNormalGravity()
            return
        end
    end

    local rawWaypoints = path:GetWaypoints()
    if #rawWaypoints == 0 then
        isPathfinding = false
        teleportTween(CFrame.new(computeTarget), Config.TweenSpeed, false, true)
        restoreNormalGravity()
        return
    end

    local flatWaypoints = {}
    for i = 1, #rawWaypoints do
        local rawY = rawWaypoints[i].Position.Y + 3.0
        local wpHeight = (math.abs(rawY - walkY) <= 1.8) and walkY or rawY
        table.insert(flatWaypoints, Vector3.new(rawWaypoints[i].Position.X, wpHeight, rawWaypoints[i].Position.Z))
    end

    local optimizedWps = {}
    local curIdx = 1
    while curIdx < #flatWaypoints do
        local nextIdx = curIdx + 1
        local maxAllowed = (attempt == 0) and 1 or 0
        for j = #flatWaypoints, curIdx + 2, -1 do
            local okSeg, segLayers = analyzeSegmentLayers(flatWaypoints[curIdx], flatWaypoints[j], nil, 1.4)
            if okSeg and segLayers <= maxAllowed then
                nextIdx = j
                break
            end
        end
        table.insert(optimizedWps, flatWaypoints[nextIdx])
        curIdx = nextIdx
    end

    setStatus("🔵 Pathfinding (" .. #optimizedWps .. " titik)...", Color3.fromRGB(160, 120, 255))
    Workspace.Gravity = 0

    for i, wpPos in ipairs(optimizedWps) do
        if abortTeleport or not _G.TeleportGUI_Loaded then
            setStatus("🛑 Dibatalkan", Color3.fromRGB(220, 80, 80))
            break
        end

        local wpY  = (comboMode or Config.UndergroundTeleport) and (wpPos.Y - Config.UGDepth) or wpPos.Y
        local wpCF = CFrame.new(wpPos.X, wpY, wpPos.Z)

        drawWaypoint(wpPos, i == #optimizedWps and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 200, 0))

        local isInterrupted = teleportTween(wpCF, Config.TweenSpeed, false, true)
        if isInterrupted then
            if isThreatened() then
                restoreNormalGravity()
                local resumed = performColliderHide(setStatus)
                isPathfinding = false
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded and attempt < 2 then
                    task.wait(0.15)
                    pathfindTween(targetCF, statusCb, attempt + 1, true)
                end
                return
            end
            if abortTeleport then break end
        end
    end

    isPathfinding = false
    restoreNormalGravity()
    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end

    if not abortTeleport and rootPart then
        local fp = computeTarget
        if comboMode then
            teleportTween(CFrame.new(fp.X, walkY, fp.Z), Config.UGRiseSpeed, false, true)
        end
        setStatus("✔ Pathfind selesai!", Color3.fromRGB(100, 220, 150))
        task.delay(2, function()
            if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih" end
            clearPathVisuals()
        end)
    end

    abortTeleport = false
end

local function doTeleport(cf, mode, speed)
    if Config.HybridYMode then
        executeHybridYTeleport(cf, function(txt, col)
            if pfStatusRef then pfStatusRef.Text = txt; pfStatusRef.TextColor3 = col or Color3.fromRGB(120, 220, 255) end
        end)
        return
    end

    if mode == "Tween" and Config.PathfindMode then
        task.spawn(function() pathfindTween(cf, nil, 0, false) end)
        return
    end

    if Config.UndergroundTeleport and mode == "Tween" then
        if not rootPart then return end
        local target = cf.Position
        local downY  = rootPart.Position.Y - Config.UGDepth
        teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
        if abortTeleport then restoreNormalGravity(); return end
        teleportTween(CFrame.new(target.X, downY, target.Z), speed, false, true)
        if abortTeleport then restoreNormalGravity(); return end
        teleportTween(CFrame.new(target.X, target.Y + 3.1, target.Z), Config.UGRiseSpeed, false, true)
        restoreNormalGravity()
        return
    end

    local finalCF = Config.UndergroundTeleport and CFrame.new(cf.Position.X, cf.Position.Y - Config.UGDepth, cf.Position.Z) or cf
    if mode == "Tween" then
        safeSingleLayerTween(finalCF, speed, false)
    else
        teleportInstant(finalCF, false)
    end
    restoreNormalGravity()
end

