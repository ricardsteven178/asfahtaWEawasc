local function clearESP(tag)
    local list = espInstances[tag]
    if list then
        for _, inst in ipairs(list) do
            pcall(function() if inst and inst.Parent then inst:Destroy() end end)
        end
        table.clear(list)
    end
end

local function addHighlight(parent, fill, outline, tag)
    if parent:FindFirstChild(tag) then return end
    local h = Instance.new("Highlight")
    h.Name             = tag
    h.FillColor        = fill
    h.OutlineColor     = outline
    h.FillTransparency = 0.5
    h.Parent           = parent
    if espInstances[tag] then table.insert(espInstances[tag], h) end
end

local function addBillboard(parent, text, color, tag)
    if parent:FindFirstChild(tag .. "BB") then return end
    local bb = Instance.new("BillboardGui")
    bb.Name        = tag .. "BB"
    bb.Size        = UDim2.new(0, 120, 0, 40)
    bb.AlwaysOnTop = true
    bb.Parent      = parent
    if parent:IsA("Model") then
        bb.Adornee = getMonsterPart(parent)
    elseif parent:IsA("BasePart") then
        bb.Adornee = parent
    end

