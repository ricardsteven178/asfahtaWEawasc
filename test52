-- SECTION 4: NOCLIP SYSTEM, FLOOR LEVELING & THICK COLLIDER FILTERING
-- ==============================================================================
local function isColliderName(n)
    return n == "NoClip" or n == "NoClip_Collider" or n == "CylinderCollider"
end

local function isFloorPart(p)
    if not p or not p:IsA("BasePart") then return true end
    local ln = p.Name:lower()
    if ln:find("floor") or ln:find("ground") or ln:find("baseplate") or ln:find("carpet") then
        return true
    end
    if p.Size.Y < 2.5 and p.Size.X > 25 and p.Size.Z > 25 and rootPart and p.Position.Y < (rootPart.Position.Y - 1.5) then
        return true
    end
    return false
end

local function getSafeWalkY(referenceY)
    if rootPart and rootPart.Position.Y > -50 and rootPart.Position.Y < 200 then
        return rootPart.Position.Y
    end
    return referenceY or 100
end

local function getTargetStandingY(rawTargetY, isAlreadyStandingHeight)
    local walkY = getSafeWalkY(rawTargetY)
    if not rawTargetY then return walkY end
    local standY = isAlreadyStandingHeight and rawTargetY or (rawTargetY + 3.0)
    if math.abs(standY - walkY) <= 1.8 then
        return walkY
    end
    return standY
end

local function clampPositionAboveFloor(pt, minHeightOffset)
    if Config.UndergroundTeleport then return pt end
    local walkY = getSafeWalkY(pt.Y)
    if math.abs(pt.Y - walkY) <= 1.8 then
        return Vector3.new(pt.X, walkY, pt.Z)
    end
    return Vector3.new(pt.X, pt.Y, pt.Z)
end

local function isWallOrGenBlockerName(n)
    local ln = n:lower()
    return n == "Wall"
        or n == "WindowWall"
        or n == "DoorWall"
        or n == "WallFiller"
        or n == "InvisBlock"
        or n == "BaseMachine"
        or n == "Cutouts"
        or n == "DandyCutout"
        or n == "Cutout_Dandy"
        or n == "AnimatorDesk_Large"
        or ln:find("cutout") ~= nil
end

local function isValidThickHideCollider(col)
    if not col or not col:IsA("BasePart") then return false end
    local n = col.Name
    if n ~= "NoClip_Collider" and n ~= "CylinderCollider" then
        return false
    end

    local parent = col.Parent
    while parent and parent ~= Workspace and parent.Name ~= "CurrentRoom" do
        local pn = parent.Name:lower()
        if pn:find("wall") or pn:find("window") or pn:find("door") or pn:find("railing")
           or pn:find("fence") or pn:find("barrier") or pn:find("border") or pn:find("pillar") then
            return false
        end
        parent = parent.Parent
    end

    local wSize    = getWorldBoxSize(col)
    local minHoriz = math.min(wSize.X, wSize.Z)
    local maxHoriz = math.max(wSize.X, wSize.Z)

    if minHoriz < Config.MinHideThickness then
        return false
    end

    if (maxHoriz / math.max(minHoriz, 0.1)) > 5.5 and minHoriz < 4.5 then
        return false
    end

    return true
end

local function updateColliderCaches()
    local allC, hideC, espList, noclipList = {}, {}, {}, {}
    local seenPart, seenESP, seenNoClip    = {}, {}, {}
    local room = Workspace:FindFirstChild("CurrentRoom")
    local map  = getMap()

    local function addObstaclePart(p)
        if p and p:IsA("BasePart") and not seenPart[p] and not isFloorPart(p) then
            seenPart[p] = true
            table.insert(allC, p)
        end
    end

    local function addESPTarget(obj, labelText)
        if obj and not seenESP[obj] then
            seenESP[obj] = true
            table.insert(espList, { adornee = obj, label = labelText })
        end
    end

    local function addNoClipPart(p)
        if p and p:IsA("BasePart") and not seenNoClip[p] and not isFloorPart(p) then
            seenNoClip[p] = true
            table.insert(noclipList, p)
        end
    end

    local function addNoClipObjectAndDescendants(obj)
        if not obj or obj == room or obj == map then return end
        if obj:IsA("BasePart") then addNoClipPart(obj) end
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("BasePart") then addNoClipPart(child) end
        end
    end

    if room then
        for _, v in ipairs(room:GetDescendants()) do
            local vName = v.Name
            if isColliderName(vName) then
                if v:IsA("BasePart") then
                    addObstaclePart(v)
                    local pName = v.Parent and v.Parent.Name or ""
                    addESPTarget(v, pName ~= "" and (pName .. " > " .. vName) or vName)
                    if isValidThickHideCollider(v) then
                        table.insert(hideC, v)
                    end
                end
                addNoClipObjectAndDescendants(v)
                local parentObj = v.Parent
                if parentObj and parentObj ~= room and parentObj ~= map and (parentObj:IsA("Model") or parentObj:IsA("BasePart")) then
                    addNoClipObjectAndDescendants(parentObj)
                end
            elseif isWallOrGenBlockerName(vName) then
                addNoClipObjectAndDescendants(v)
                if vName == "InvisBlock" and v.Parent and v.Parent:IsA("Model") and v.Parent ~= room and v.Parent ~= map then
                    addNoClipObjectAndDescendants(v.Parent)
                end
                if vName == "WindowWall" and (v:IsA("Model") or v:IsA("BasePart")) then
                    local hasSubCollider = false
                    for _, d in ipairs(v:GetDescendants()) do
                        if d:IsA("BasePart") and isColliderName(d.Name) then
                            hasSubCollider = true
                            break
                        end
                    end
                    if not hasSubCollider then
                        addESPTarget(v, "WindowWall")
                    end
                    if v:IsA("BasePart") then
                        addObstaclePart(v)
                    else
                        local bestPart, maxVol = nil, -1
                        for _, d in ipairs(v:GetDescendants()) do
                            if d:IsA("BasePart") and (d.Name == "Window" or d.Name == "Part") then
                                local vol = d.Size.X * d.Size.Y * d.Size.Z
                                if vol > maxVol then
                                    maxVol   = vol
                                    bestPart = d
                                end
                            end
                        end
                        if bestPart then addObstaclePart(bestPart) end
                    end
                end
            end
        end
    end

    cachedAllCols     = allC
    cachedHideCols    = hideC
    cachedESPAdornees = espList
    cachedNoClipParts = noclipList
end

local function getNoClipColliders()
    if #cachedAllCols == 0 then updateColliderCaches() end
    return cachedAllCols
end

local function getAllNoClipTargetParts()
    if #cachedNoClipParts == 0 then updateColliderCaches() end
    return cachedNoClipParts
end

local function applyNoClipState()
    if Config.NoClip then
        for _, p in ipairs(getAllNoClipTargetParts()) do
            if p and p.Parent then
                if originalCollideStates[p] == nil then
                    originalCollideStates[p] = p.CanCollide
                end
                p.CanCollide = false
            end
        end
    else
        for p, origState in pairs(originalCollideStates) do
            if p and p.Parent then
                p.CanCollide = origState
            end
        end
        table.clear(originalCollideStates)
    end
end

local function setTargetColliderPassable(targetCol, passable)
    if passable and targetCol and targetCol.Parent then
        forceCharNoClip = true
        local room = Workspace:FindFirstChild("CurrentRoom")
        local map  = getMap()

        local function disablePart(p)
            if p and p:IsA("BasePart") and not isFloorPart(p) then
                if tempHideCollideStates[p] == nil then
                    tempHideCollideStates[p] = p.CanCollide
                end
                p.CanCollide = false
            end
        end

        disablePart(targetCol)
        local parentObj = targetCol.Parent
        if parentObj and parentObj ~= room and parentObj ~= map then
            if parentObj:IsA("BasePart") then disablePart(parentObj) end
            for _, d in ipairs(parentObj:GetDescendants()) do
                disablePart(d)
            end
        end

        local ok, overlapping = pcall(function()
            local ovParams = OverlapParams.new()
            ovParams.FilterType = Enum.RaycastFilterType.Exclude
            ovParams.FilterDescendantsInstances = { character }
            local wSz = getWorldBoxSize(targetCol)
            return Workspace:GetPartBoundsInBox(CFrame.new(targetCol.Position), wSz + Vector3.new(2.5, 1.0, 2.5), ovParams)
        end)
        if ok and overlapping then
            for _, p in ipairs(overlapping) do
                disablePart(p)
            end
        end
    elseif not passable then
        forceCharNoClip = false
        if not Config.NoClip then
            for p, orig in pairs(tempHideCollideStates) do
                if p and p.Parent then p.CanCollide = orig end
            end
        end
        table.clear(tempHideCollideStates)
    end
end

task.spawn(function()
    while _G.TeleportGUI_Loaded do
        updateColliderCaches()
