end

local function getOpenAirStandCFForItem(itemPos, preferredIndex)
    local rawPos = clampPositionAboveFloor(Vector3.new(itemPos.X, itemPos.Y + 3.1, itemPos.Z), 3.1)
    if (not preferredIndex or preferredIndex == 0) and isPointStrictlyOpenAir(rawPos, 1.6) then
        return CFrame.new(rawPos)
    end

    local dirs = {
        Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
        Vector3.new(0.707, 0, 0.707), Vector3.new(-0.707, 0, 0.707),
        Vector3.new(0.707, 0, -0.707), Vector3.new(-0.707, 0, -0.707),
    }

    if rootPart then
        local rpPos = rootPart.Position
        table.sort(dirs, function(a, b)
            local pA = Vector3.new(itemPos.X, rpPos.Y, itemPos.Z) + a * 4
            local pB = Vector3.new(itemPos.X, rpPos.Y, itemPos.Z) + b * 4
            return (pA - rpPos).Magnitude < (pB - rpPos).Magnitude
        end)
    end

    local validCandidates = {}
    for _, dist in ipairs({ 3.2, 4.5, 5.8, 7.0 }) do
        for _, d in ipairs(dirs) do
            local rawCand = Vector3.new(itemPos.X, rawPos.Y, itemPos.Z) + (d * dist)
            local okFl, flY = isPointOnValidFloor(rawCand)
            if okFl and flY then
                local candidate = Vector3.new(rawCand.X, flY + 3.1, rawCand.Z)
                if isPointStrictlyOpenAir(candidate, 1.6) then
                    table.insert(validCandidates, CFrame.new(candidate))
                end
            end
        end
    end

    if #validCandidates > 0 then
        local idx = ((preferredIndex or 0) % #validCandidates) + 1
        return validCandidates[idx]
    end
    return CFrame.new(rawPos)
end

local function pickupSelectedItem(targetName, cb)
    if isPickingUp then return end
    isPickingUp             = true
    abortTeleport           = false
    Config.PickupMode       = Config.TeleportMode
    Config.PickupTweenSpeed = Config.TweenSpeed

    task.spawn(function()
        updateColliderCaches()

        local function makePlatform(atPos)
            local plat = Instance.new("Part")
            plat.Size         = Vector3.new(10, 1, 10)
            plat.Anchored     = true
            plat.CanCollide   = true
            plat.Transparency = 1
            plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
            plat.Parent       = Workspace
            return plat
        end

        local function getRemainingTargets()
            local list   = {}
            local map    = getMap()
            local folder = map and map:FindFirstChild("Items")
            if not folder then return list end
            for _, item in ipairs(folder:GetChildren()) do
                if item:IsA("Model") and item.Name == targetName and item.Parent then
                    table.insert(list, item)
                end
            end
            if rootPart then
                table.sort(list, function(a, b)
                    return (rootPart.Position - a:GetPivot().Position).Magnitude
                         < (rootPart.Position - b:GetPivot().Position).Magnitude
                end)
            end
            return list
        end

        local initialList = getRemainingTargets()
        if #initialList == 0 then
            if cb then cb("Item '" .. targetName .. "' tidak ada di room!") end
            isPickingUp = false
            return
        end

        local skipCounts  = {}
        local triedAngles = {}

        while isPickingUp and not abortTeleport and _G.TeleportGUI_Loaded do
            if isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
            end

            local remaining = getRemainingTargets()
            local item = nil
            for _, it in ipairs(remaining) do
                if (skipCounts[it] or 0) < 4 then
                    -- [FIX MONSTER PASIF] Jika item berada tepat di bawah kaki monster pasif (<= 8.5 studs) dan bukan mode Hybrid,
                    -- lewati sementara agar karakter tidak menabrak monster pasif dan kehilangan nyawa!
                    local itPos = it:GetPivot().Position
                    if not Config.HybridYMode and isPointNearPassiveMonster(itPos, 8.5) then
                        skipCounts[it] = 4
                        if cb then cb("⚠ " .. targetName .. " dijaga Monster Pasif, skip demi aman!") end
                        task.wait(0.2)
                    else
                        item = it
                        break
                    end
                end
            end

            if not item or not item.Parent or not rootPart then
                break
            end

            local retryCount = skipCounts[item] or 0
            if cb then
                local retryTxt = (retryCount > 0) and (" [Rute Memutar #" .. retryCount .. "]") or ""
                cb("🎯 Mengambil " .. targetName .. " (Sisa: " .. #remaining .. ")" .. retryTxt .. "...")
            end

            local itemPos = item:GetPivot().Position
            local standCF = getOpenAirStandCFForItem(itemPos, retryCount)
            local exactPos = clampPositionAboveFloor(Vector3.new(itemPos.X, itemPos.Y + 3.1, itemPos.Z), 3.1)
            local exactCF  = CFrame.new(exactPos)

            if not triedAngles[item] then triedAngles[item] = {} end

            local moveInterrupted = false
            if Config.HybridYMode then
                executeHybridYTeleport(exactCF, function(msg) if cb then cb(msg) end end)
            elseif Config.PickupMode == "Tween" and Config.PathfindMode then
                task.spawn(function() pathfindTween(standCF, nil, math.min(retryCount, 2)) end)
                local w = 0
                while not isPathfinding and w < 1 do task.wait(0.05); w = w + 0.05 end
                w = 0
                while (isPathfinding or isHiding) and w < 60 and not abortTeleport and isPickingUp do
                    task.wait(0.1)
                    w = w + 0.1
                end
                task.wait(0.15)
            elseif Config.PickupMode == "Tween" and Config.UndergroundTeleport then
                local downY = rootPart.Position.Y - Config.UGDepth
                moveInterrupted = teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
                if not moveInterrupted and not abortTeleport then
                    moveInterrupted = teleportTween(CFrame.new(standCF.X, downY, standCF.Z), Config.PickupTweenSpeed, false, true)
                end
                if not moveInterrupted and not abortTeleport then
                    moveInterrupted = teleportTween(CFrame.new(standCF.X, standCF.Y + 1, standCF.Z), Config.UGRiseSpeed, false, true)
                end
            elseif Config.PickupMode == "Tween" then
                if retryCount > 0 then
                    if cb then cb("🔄 Memutar deretan blok dari arah lain ke " .. targetName .. "...") end
                    moveInterrupted = attemptAlternateAngleTween(standCF, Config.PickupTweenSpeed, false, triedAngles[item])
                else
                    moveInterrupted = safeSingleLayerTween(standCF, Config.PickupTweenSpeed, false)
                end
            else
                teleportInstant(exactCF, false)
            end

            if abortTeleport or not isPickingUp then break end

            if moveInterrupted or isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.15)
                continue
            end

            task.wait(0.10)
            if rootPart and (rootPart.Position - itemPos).Magnitude > 9.5 then
                recordFailedRollbackZone(standCF.Position)
                skipCounts[item] = (skipCounts[item] or 0) + 1
                if cb then cb("⚠ Mental balik! Menengahkan posisi & ganti rute...") end
                local hallPt = findNearestOpenHallwayPoint(rootPart.Position)
                if hallPt then
                    teleportTween(CFrame.new(hallPt), Config.PickupTweenSpeed * 0.85, false, true)
                end
                task.wait(0.15)
                continue
            end

            local holdTargetPos = clampPositionAboveFloor(rootPart.Position, 3.1)
            local plat = makePlatform(holdTargetPos)
            local holdPickupConn = startServerSyncedHold(function() return holdTargetPos end)
            local waitTicks = 0
            local monsterInterrupted = false
            local rolledBack = false

            while item.Parent and waitTicks < 25 and not abortTeleport and isPickingUp do
                if isThreatened() then
                    monsterInterrupted = true
                    break
                end

                if rootPart and (rootPart.Position - itemPos).Magnitude > 10.0 then
                    rolledBack = true
                    break
                end

                if waitTicks == 10 and item.Parent and rootPart and not Config.HybridYMode then
                    if holdPickupConn then holdPickupConn:Disconnect(); holdPickupConn = nil end
                    local goalCol = getColliderContainingPoint(exactPos, 1.4)
                    if countCollidersHitBySegment(rootPart.Position, exactPos, goalCol, 1.6) <= 1
                       and not isPointNearPassiveMonster(exactPos, 8.5) then
                        teleportTween(exactCF, Config.PickupTweenSpeed * 0.85, false, true)
                    end
                    if rootPart then
                        holdTargetPos = clampPositionAboveFloor(rootPart.Position, 3.1)
                        holdPickupConn = startServerSyncedHold(function() return holdTargetPos end)
                    end
                end

                local pp   = item:FindFirstChild("Prompt")
                local prox = pp and pp:FindFirstChild("ProximityPrompt")
                if prox and prox.Enabled then
                    interactWithPrompt(prox)
                end

                task.wait(0.1)
                waitTicks = waitTicks + 1
            end

            if holdPickupConn then holdPickupConn:Disconnect(); holdPickupConn = nil end
            if plat and plat.Parent then plat:Destroy() end
            if rootPart then rootPart.Anchored = false end

            if monsterInterrupted then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.15)
                continue
            end

            if rolledBack or item.Parent then
                recordFailedRollbackZone(standCF.Position)
                skipCounts[item] = (skipCounts[item] or 0) + 1
                if rolledBack and cb then
                    cb("🔄 Terpental balik! Menengahkan & memutar lewat arah lain...")
                end
            end

            if Config.HybridYMode and not abortTeleport and isPickingUp then
                if cb then cb("🛡 Selesai ambil, kembali ke tengah Collider tebal...") end
                moveIntoNearestColliderCenter(Config.TweenSpeed, true)
                setTargetColliderPassable(nil, false)
                restoreNormalGravity()
                task.wait(0.15)
            else
                restoreNormalGravity()
                task.wait(0.25)
            end
        end

        if rootPart then rootPart.Anchored = false end
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        if cb then cb("✔ Selesai ambil " .. targetName .. "!") end
        isPickingUp = false
    end)
end

