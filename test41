    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Model") then
            addHighlight(item, Color3.fromRGB(0, 220, 100), Color3.fromRGB(255, 255, 255), "_ItemESP")
            addBillboard(item, item.Name, Color3.fromRGB(0, 220, 100), "_ItemESP")
        end
    end
end

local function refreshGenESP()
    clearESP("_GenESP")
    if not Config.GenESP then return end
    local map    = getMap()
    local folder = map and map:FindFirstChild("Generators")
    if not folder then return end
    for _, gen in ipairs(folder:GetChildren()) do
        if gen:IsA("Model") then
            local stats     = gen:FindFirstChild("Stats")
            local completed = stats and stats:FindFirstChild("Completed") and stats.Completed.Value
            local possessed = stats and stats:FindFirstChild("Connie") and stats.Connie.Value
            local cur       = stats and stats:FindFirstChild("CurrentAmount") and math.floor(stats.CurrentAmount.Value + 0.5) or 0
