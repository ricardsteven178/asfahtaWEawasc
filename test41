-- [FITUR BARU - ANTI CRASH MONSTER PASIF (REFERENSI REV 26)]
-- Membedakan Monster Pasif/Diam (LooseMonsters) dan Monster Mematikan (AvoidmoreradiusMonsters)
local function isLooseMonsterName(mName)
    if not mName then return false end
    local lower = mName:lower()
    for _, looseName in ipairs(Config.LooseMonsters or {}) do
        if mName == looseName or lower:find(looseName:lower(), 1, true) then
            return true
        end
    end
    -- Fallback deteksi nama umum monster pasif/stasioner
    if lower:find("blott") or lower:find("squirm") or lower:find("razzle") or lower:find("rodger") or lower:find("connie") or lower:find("gourdy") then
        return true
    end
    return false
end

local function isLethalMonsterName(mName)
    if not mName then return false end
    for _, lethalName in ipairs(Config.AvoidmoreradiusMonsters or {}) do
        if mName == lethalName then
            return true
        end
    end
    return false
end

-- Deteksi apakah monster yang mengancam adalah monster AKTIF (mengejar / patroli)
-- Monster pasif (LooseMonsters) yang diam TIDAK AKAN memicu ngumpet abadi di collider (penyebab freeze/stuck),
-- melainkan hanya dihindari jalurnya!
local function isThreatened()
    local pGui        = player:FindFirstChild("PlayerGui")
    local screenGui   = pGui and pGui:FindFirstChild("ScreenGui")
    local monsterIcon = screenGui and screenGui:FindFirstChild("MonsterIcon")
    if monsterIcon and monsterIcon.Visible and type(monsterIcon.ImageTransparency) == "number" and monsterIcon.ImageTransparency < 0.99 then
        return true
    end

    if not rootPart then return false end
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, monster in pairs(monstersFolder:GetChildren()) do
            if monster:IsA("Model") then
                local chasing = monster:FindFirstChild("ChasingValue")
                if chasing and chasing.Value == character then
                    return true
                end
                local primaryPart = getMonsterPart(monster)
                if primaryPart then
                    local dist = (primaryPart.Position - rootPart.Position).Magnitude
                    if isLethalMonsterName(monster.Name) then
                        if dist <= (Config.LethalRadius or 60) then
                            return true
                        end
                    elseif isLooseMonsterName(monster.Name) then
                        -- Monster pasif (Blott, Squirm, RazzleDazzle, Rodger, Connie, Gourdy) diam di tempat:
                        -- Jangan memicu performColliderHide kecuali ChasingValue / MonsterIcon aktif!
                    else
                        if dist <= Config.MonsterDangerRadius then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

-- Mengecek apakah suatu titik terlalu dekat dengan Monster Pasif (LooseMonsters) agar rute memutarinya
local function isPointNearPassiveMonster(pt, customRadius)
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if not monstersFolder then return false end
    local checkRad = customRadius or (Config.LooseRadius or 10)
    for _, m in pairs(monstersFolder:GetChildren()) do
        if m:IsA("Model") and isLooseMonsterName(m.Name) then
            local p = getMonsterPart(m)
            if p and (p.Position - pt).Magnitude <= checkRad then
                return true
            end
        end
    end
    return false
end

local function getMinDistanceToMonsters(pt)
    local minDist = math.huge
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") then
                local p = getMonsterPart(m)
                if p then
                    local d = (p.Position - pt).Magnitude
                    if d < minDist then minDist = d end
                end
            end
        end
    end
    return minDist
end

local function isPointInsideExpandedBox(pt, part, marginXZ, marginY)
    if not part or not part:IsA("BasePart") then return false end
    marginXZ  = marginXZ or 0
    marginY   = marginY or marginXZ
    local cf  = part.CFrame
    local lPt = cf:PointToObjectSpace(pt)
    return math.abs(lPt.X) <= (part.Size.X * 0.5 + marginXZ)
       and math.abs(lPt.Y) <= (part.Size.Y * 0.5 + marginY)
       and math.abs(lPt.Z) <= (part.Size.Z * 0.5 + marginXZ)
end

local function segmentIntersectsExpandedBox(posA, posB, part, padXZ, padY)
    if not part or not part:IsA("BasePart") then return false end
    padXZ = padXZ or 1.8
    padY  = padY or 2.0

    local cf = part.CFrame
    local lA = cf:PointToObjectSpace(posA)
    local lB = cf:PointToObjectSpace(posB)
    local d  = lB - lA

    local hx = part.Size.X * 0.5 + padXZ
    local hy = part.Size.Y * 0.5 + padY
    local hz = part.Size.Z * 0.5 + padXZ

    local tMin, tMax = 0.0, 1.0

    if math.abs(d.X) < 1e-6 then
        if math.abs(lA.X) > hx then return false end
    else
        local inv = 1.0 / d.X
        local t1, t2 = (-hx - lA.X) * inv, (hx - lA.X) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false end
    end

    if math.abs(d.Y) < 1e-6 then
        if math.abs(lA.Y) > hy then return false end
    else
        local inv = 1.0 / d.Y
        local t1, t2 = (-hy - lA.Y) * inv, (hy - lA.Y) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false end
    end

    if math.abs(d.Z) < 1e-6 then
        if math.abs(lA.Z) > hz then return false end
    else
        local inv = 1.0 / d.Z
        local t1, t2 = (-hz - lA.Z) * inv, (hz - lA.Z) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false end
    end

    return tMin <= tMax
end

-- Mengecek apakah segmen garis posA -> posB menabrak zona bahaya Monster Pasif (LooseMonsters)
local function segmentHitsPassiveMonster(posA, posB)
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if not monstersFolder then return false end
    local looseRad = Config.LooseRadius or 10
    for _, m in pairs(monstersFolder:GetChildren()) do
        if m:IsA("Model") and isLooseMonsterName(m.Name) then
            local p = getMonsterPart(m)
            if p then
                -- Buat virtual box di posisi monster pasif sebesar LooseRadius
                local ab = posB - posA
                local lenSq = ab.X * ab.X + ab.Z * ab.Z
                local t = 0
                if lenSq > 1e-4 then
                    t = math.clamp(((p.Position.X - posA.X) * ab.X + (p.Position.Z - posA.Z) * ab.Z) / lenSq, 0, 1)
                end
                local closestPt = posA + ab * t
                local horizDist = Vector2.new(closestPt.X - p.Position.X, closestPt.Z - p.Position.Z).Magnitude
                if horizDist <= looseRad then
                    return true
                end
            end
        end
    end
    return false
end

local function getColliderContainingPoint(pt, marginXZ)
    marginXZ = marginXZ or 1.4
    for _, col in ipairs(getNoClipColliders()) do
        if col and col.Parent and isPointInsideExpandedBox(pt, col, marginXZ, 2.0) then
            return col
        end
    end
    return nil
end

local function countCollidersHitBySegment(posA, posB, ignoredCol, padXZ)
    padXZ = padXZ or 1.85
    local allCols = getNoClipColliders()
    local count   = 0

    for _, col in ipairs(allCols) do
        if col and col.Parent and col ~= ignoredCol then
            if segmentIntersectsExpandedBox(posA, posB, col, padXZ, 1.8) then
                count = count + 1
            end
        end
    end
    return count
end

local function isPointStrictlyOpenAir(pt, marginXZ)
    marginXZ = marginXZ or 2.0
    local okFloor = isPointOnValidFloor(pt)
    if not okFloor then
        return false
    end
    if isPointNearPassiveMonster(pt, Config.LooseRadius or 10) then
        return false
    end
    for _, col in ipairs(getNoClipColliders()) do
        if col and col.Parent and isPointInsideExpandedBox(pt, col, marginXZ, 1.8) then
            return false
        end
    end
    return true
end

local function findNearestOpenHallwayPoint(originPos)
    local basePt = clampPositionAboveFloor(originPos, 3.1)
    local bestPt = nil
    local bestClearance = -1

    local angles = 12
    for _, radius in ipairs({ 5, 10, 15, 21 }) do
        for a = 1, angles do
            local rad = (a / angles) * math.pi * 2
            local candidateRaw = basePt + Vector3.new(math.cos(rad) * radius, 0, math.sin(rad) * radius)
            local okFloor, floorY = isPointOnValidFloor(candidateRaw)
            if okFloor and floorY then
                local candidate = Vector3.new(candidateRaw.X, floorY + 3.1, candidateRaw.Z)
                if isPointStrictlyOpenAir(candidate, 2.1) and isSegmentAboveValidFloor(basePt, candidate) then
                    local currentInsideCol = getColliderContainingPoint(basePt, 1.5)
                    if countCollidersHitBySegment(basePt, candidate, currentInsideCol, 1.7) == 0
                       and not segmentHitsPassiveMonster(basePt, candidate) then
                        local minColDist = math.huge
                        for _, col in ipairs(getNoClipColliders()) do
                            if col and col.Parent then
                                local d = (col.Position - candidate).Magnitude
                                if d < minColDist then minColDist = d end
                            end
                        end
                        if minColDist > bestClearance then
                            bestClearance = minColDist
                            bestPt = candidate
                        end
                    end
                end
            end
        end
        if bestPt and bestClearance >= 6.0 then
            return bestPt
        end
    end
    return bestPt
end

local function findSafeExitPointOutsideCollider(fromPos, centerPos, targetCol)
    local dir = fromPos - centerPos
    dir = Vector3.new(dir.X, 0, dir.Z)
    local baseDir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(1, 0, 0)
    local perpDir = Vector3.new(-baseDir.Z, 0, baseDir.X)
    local wSz     = getWorldBoxSize(targetCol)
    local radius  = math.max(wSz.X, wSz.Z) * 0.5 + 3.8

    local dirs = {
        baseDir, perpDir, -perpDir, -baseDir,
        (baseDir + perpDir).Unit, (baseDir - perpDir).Unit,
        (-baseDir + perpDir).Unit, (-baseDir - perpDir).Unit,
    }

    for _, d in ipairs(dirs) do
        for extra = 0, 9, 3 do
            local rawCand = centerPos + d * (radius + extra)
            local okFloor, floorY = isPointOnValidFloor(rawCand)
            if okFloor and floorY then
                local candidate = Vector3.new(rawCand.X, floorY + 3.1, rawCand.Z)
                if isPointStrictlyOpenAir(candidate, 2.0) and isSegmentAboveValidFloor(centerPos, candidate) then
                    if countCollidersHitBySegment(centerPos, candidate, targetCol, 1.85) == 0 then
                        return candidate
                    end
                end
            end
        end
    end
    return clampPositionAboveFloor(fromPos, 3.1)
end

-- [FIX ANTI-CRASH] Multi-Step Open-Air Corridor Router yang ringan (Maksimal 24 Node, Tanpa Loop O(N^3) yang bikin freeze)
local function buildMultiStepOpenRoute(startPos, goalPos, allowedGoalCol)
    local pStart = clampPositionAboveFloor(startPos, 3.1)
    local pGoal  = clampPositionAboveFloor(goalPos, 3.1)
    local startCol = getColliderContainingPoint(pStart, 1.3)

    local function isCleanOpenSegment(a, b, ignoreCol)
        if segmentHitsPassiveMonster(a, b) then return false end
        if countCollidersHitBySegment(a, b, ignoreCol, 1.8) > 0 then return false end
        return isSegmentAboveValidFloor(a, b)
    end

    local preWaypoints = {}
    local effectiveStart = pStart
    if startCol and startCol ~= allowedGoalCol then
        local exitFirst = findSafeExitPointOutsideCollider(pGoal, pStart, startCol)
        if exitFirst and (exitFirst - pStart).Magnitude > 1.0 then
            table.insert(preWaypoints, exitFirst)
            effectiveStart = exitFirst
        end
    end

    if isCleanOpenSegment(effectiveStart, pGoal, allowedGoalCol) then
        table.insert(preWaypoints, pGoal)
        return preWaypoints, true
    end

    local dir = pGoal - effectiveStart
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    local uDir = (flatDir.Magnitude > 0.1) and flatDir.Unit or Vector3.new(1, 0, 0)
    local perp = Vector3.new(-uDir.Z, 0, uDir.X)

    local openNodes = {}
    local function tryAddNode(rawPt)
        if #openNodes >= 24 then return end
        local okFloor, floorY = isPointOnValidFloor(rawPt)
        if okFloor and floorY then
            local pt = Vector3.new(rawPt.X, floorY + 3.1, rawPt.Z)
            if isPointStrictlyOpenAir(pt, 1.95) then
                for _, badPos in ipairs(failedRollbackZones) do
                    if (pt - badPos).Magnitude < 4.0 then
                        return
                    end
                end
                table.insert(openNodes, pt)
            end
        end
    end

    for _, frac in ipairs({ 0.25, 0.5, 0.75 }) do
        local basePt = effectiveStart:Lerp(pGoal, frac)
        for _, offsetDist in ipairs({ 6.5, 12.0, 18.0, 25.0 }) do
            tryAddNode(basePt + perp * offsetDist)
            tryAddNode(basePt - perp * offsetDist)
        end
    end

    -- Cek 1: Rute 1-Belokan
    local best1Route, best1Dist = nil, math.huge
    for _, n1 in ipairs(openNodes) do
        if isCleanOpenSegment(effectiveStart, n1, nil) and isCleanOpenSegment(n1, pGoal, allowedGoalCol) then
            local d = (n1 - effectiveStart).Magnitude + (pGoal - n1).Magnitude
            if d < best1Dist then
                best1Dist  = d
                best1Route = { n1, pGoal }
            end
        end
    end
    if best1Route then
        for _, wp in ipairs(best1Route) do table.insert(preWaypoints, wp) end
        return preWaypoints, true
    end

    -- Cek 2: Rute 2-Belokan (Maksimal 24x24 ringan, tanpa O(N^3) yang menyebabkan freeze)
    local startReachable = {}
    local goalReachable  = {}
    for idx, n in ipairs(openNodes) do
        if isCleanOpenSegment(effectiveStart, n, nil) then
            table.insert(startReachable, idx)
        end
        if isCleanOpenSegment(n, pGoal, allowedGoalCol) then
            goalReachable[idx] = true
        end
    end

    local best2Route, best2Dist = nil, math.huge
    for _, i1 in ipairs(startReachable) do
        local n1 = openNodes[i1]
        for i2 = 1, #openNodes do
            if i1 ~= i2 and goalReachable[i2] then
                local n2 = openNodes[i2]
                if isCleanOpenSegment(n1, n2, nil) then
                    local d = (n1 - effectiveStart).Magnitude + (n2 - n1).Magnitude + (pGoal - n2).Magnitude
                    if d < best2Dist then
                        best2Dist  = d
                        best2Route = { n1, n2, pGoal }
                    end
                end
            end
        end
    end
    if best2Route then
        for _, wp in ipairs(best2Route) do table.insert(preWaypoints, wp) end
        return preWaypoints, true
    end

    if countCollidersHitBySegment(effectiveStart, pGoal, allowedGoalCol, 1.75) <= 1
       and not segmentHitsPassiveMonster(effectiveStart, pGoal)
       and isSegmentAboveValidFloor(effectiveStart, pGoal)
       and not startCol then
        table.insert(preWaypoints, pGoal)
        return preWaypoints, true
    end

    return preWaypoints, false
end

local function getNearestSafeColliderRoute(startPos, excludedCol)
    updateColliderCaches()
    local hideableCols = cachedHideCols
    local cleanStart   = clampPositionAboveFloor(startPos, 3.1)
    local startCol     = getColliderContainingPoint(cleanStart, 1.3)

    if #hideableCols == 0 then
        local room = Workspace:FindFirstChild("CurrentRoom")
        if room then
            for _, v in ipairs(room:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name == "NoClip_Collider" or v.Name == "CylinderCollider") then
                    local wSz = getWorldBoxSize(v)
                    local pName = (v.Parent and v.Parent.Name or ""):lower()
                    if math.min(wSz.X, wSz.Z) >= 2.4 and not pName:find("wall") and not pName:find("railing") then
                        table.insert(hideableCols, v)
                    end
                end
            end
        end
    end

    if #hideableCols == 0 then
        return { waypoints = { cleanStart }, targetCol = nil, centerPos = cleanStart, exitPos = cleanStart }
    end

    local candidates = {}
    for _, col in ipairs(hideableCols) do
        if col and col.Parent and col ~= excludedCol then
            local wSz     = getWorldBoxSize(col)
            local floorY, hasFl = getFloorYAtPoint(col.Position)
            local baseFloorY = (hasFl and floorY) and (floorY + 3.1) or cleanStart.Y
            local minY    = col.Position.Y - (wSz.Y * 0.5) + 2.5
            local maxY    = col.Position.Y + (wSz.Y * 0.5) - 0.5
            local targetY = (minY <= maxY) and math.clamp(baseFloorY, minY, maxY) or baseFloorY
            local center  = Vector3.new(col.Position.X, targetY, col.Position.Z)

            local touchesAdjacentObject = (countCollidersHitBySegment(center, center, col, 2.0) > 0)
            local monsterDist           = getMinDistanceToMonsters(center)
            local minThickness          = math.min(wSz.X, wSz.Z)

            -- Pastikan titik sembunyi tidak berada di dalam radius bahaya monster pasif maupun aktif
            table.insert(candidates, {
                col         = col,
                centerPos   = center,
                dist        = (center - cleanStart).Magnitude,
                isIsolated  = not touchesAdjacentObject,
                SafeFromMob = (monsterDist > math.max(Config.MonsterDangerRadius, 12.0)),
                thickness   = minThickness,
            })
        end
    end

    if #candidates == 0 then
        return { waypoints = { cleanStart }, targetCol = nil, centerPos = cleanStart, exitPos = cleanStart }
    end

    table.sort(candidates, function(a, b)
        if a.SafeFromMob ~= b.SafeFromMob then
            return a.SafeFromMob
        end
        if a.isIsolated ~= b.isIsolated then
            return a.isIsolated
        end
        return a.dist < b.dist
    end)

    for _, cand in ipairs(candidates) do
        if cand.isIsolated then
            if (not startCol or startCol == cand.col)
               and countCollidersHitBySegment(cleanStart, cand.centerPos, cand.col, 1.9) == 0
               and not segmentHitsPassiveMonster(cleanStart, cand.centerPos)
               and isSegmentAboveValidFloor(cleanStart, cand.centerPos) then
                local exitPt = findSafeExitPointOutsideCollider(cleanStart, cand.centerPos, cand.col)
                return { waypoints = { cand.centerPos }, targetCol = cand.col, centerPos = cand.centerPos, exitPos = exitPt }
            end
        end
    end

    for _, cand in ipairs(candidates) do
        if cand.isIsolated then
            local routeWps, okRoute = buildMultiStepOpenRoute(cleanStart, cand.centerPos, cand.col)
            if okRoute and #routeWps > 0 then
                local lastBeforeCenter = (#routeWps >= 2) and routeWps[#routeWps - 1] or cleanStart
                local exitPt = findSafeExitPointOutsideCollider(lastBeforeCenter, cand.centerPos, cand.col)
                return { waypoints = routeWps, targetCol = cand.col, centerPos = cand.centerPos, exitPos = exitPt }
            end
        end
    end

    local best = candidates[1]
    local exitPt = findSafeExitPointOutsideCollider(cleanStart, best.centerPos, best.col)
    return { waypoints = { best.centerPos }, targetCol = best.col, centerPos = best.centerPos, exitPos = exitPt }
end

