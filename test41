-- SECTION 6: TELEPORT, HYBRID Y-BYPASS ENGINE & MONSTER HIDE
-- ==============================================================================
local pathfindTween
local performColliderHide
local activeHoldConns = {}

local function clearAllServerSyncedHolds()
    for _, c in ipairs(activeHoldConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(activeHoldConns)
end

local function startServerSyncedHold(getTargetPosFn)
    clearAllServerSyncedHolds()
    if rootPart then rootPart.Anchored = false end
    Workspace.Gravity = 0
    local tickCounter = 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not rootPart or abortTeleport or not _G.TeleportGUI_Loaded or (not isHiding and not isPickingUp) then
            if conn then conn:Disconnect() end
            return
        end
        local holdPos = getTargetPosFn()
        if not holdPos then return end
        -- Hanya tahan velocity & CFrame jika karakter berada di titik hold (mencegah bug jalan lamban)
        if (rootPart.Position - holdPos).Magnitude <= 3.5 then
            tickCounter = tickCounter + 1
            local jitterX = (tickCounter % 2 == 0) and 0.03 or -0.03
            local jitterZ = (tickCounter % 4 < 2) and 0.03 or -0.03
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            local syncedCF = CFrame.new(holdPos.X + jitterX, holdPos.Y, holdPos.Z + jitterZ)
            rootPart.CFrame = syncedCF
        end
    end)
    table.insert(activeHoldConns, conn)
    return conn
end

local function recordFailedRollbackZone(pos)
    if not pos then return end
    for _, p in ipairs(failedRollbackZones) do
        if (p - pos).Magnitude < 4.0 then return end
    end
    table.insert(failedRollbackZones, pos)
    if #failedRollbackZones > 12 then
        table.remove(failedRollbackZones, 1)
    end
end

local function teleportInstant(cf, keepZeroGravity)
    if not rootPart then return end
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity  = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.CFrame = cf
    character:PivotTo(cf)
    if not keepZeroGravity and not isPathfinding and not isHiding then
        restoreNormalGravity()
    end
end

local function teleportTween(cf, speed, ignoreThreat, forceSnapEnd)
    if not rootPart then return false end
    rootPart.Anchored = false
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity = Vector3.zero

    local safeTargetPos = cf.Position
    if not Config.UndergroundTeleport and not Config.HybridYMode and safeTargetPos.Y > -100 and safeTargetPos.Y < 150 then
        safeTargetPos = clampPositionAboveFloor(safeTargetPos, 3.1)
        cf = CFrame.new(safeTargetPos)
    end

    local spd  = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
    local dist = (rootPart.Position - cf.Position).Magnitude
    local dur  = math.max(dist / (spd * (speed or 1.25)), 0.001)

    local tw = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
    activeTween = tw
    tw:Play()

    local done, cancelled = false, false
    tw.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed then done = true end
    end)

    while not done do
        -- [FIX ABORT] abortTeleport wajib selalu menghentikan Tween meskipun ignoreThreat = true!
        if abortTeleport or (not ignoreThreat and isThreatened()) then
            tw:Cancel()
            cancelled = true
            break
        end
        task.wait(0.015)
    end

    if not cancelled and rootPart then
        local remainDist = (rootPart.Position - cf.Position).Magnitude
        if (forceSnapEnd and remainDist <= 3.0) or (not isHiding and remainDist <= 3.0) then
            rootPart.CFrame = cf
            character:PivotTo(cf)
        end
    end

    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end
    if activeTween == tw then activeTween = nil end
    if not isPathfinding and not isHiding then
        restoreNormalGravity()
    end
    return cancelled
end

local function moveIntoNearestColliderCenter(speed, ignoreThreat, excludedCol)
    if not rootPart then return nil, nil end
    rootPart.Anchored = false
    local startPos  = clampPositionAboveFloor(rootPart.Position, 3.1)
    local hideRoute = getNearestSafeColliderRoute(startPos, excludedCol)
    local targetCol = hideRoute.targetCol

    setTargetColliderPassable(targetCol, true)
    local moveSpd = speed or math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)

    for i, wpPos in ipairs(hideRoute.waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then break end
        local isLast = (i == #hideRoute.waypoints)
        local cancelled = teleportTween(CFrame.new(wpPos), moveSpd, ignoreThreat, isLast)
        if cancelled and not ignoreThreat then
            return nil, hideRoute
        end
    end

    if rootPart and hideRoute.centerPos and not abortTeleport then
        task.wait(0.08)
        local realDist = (rootPart.Position - hideRoute.centerPos).Magnitude
        if realDist > 2.2 then
            local dir = hideRoute.centerPos - rootPart.Position
            local flat = Vector3.new(dir.X, 0, dir.Z)
            local uDir = (flat.Magnitude > 0.1) and flat.Unit or Vector3.new(1, 0, 0)
            local perp = Vector3.new(-uDir.Z, 0, uDir.X)
            for _, side in ipairs({ 1, -1 }) do
                local rawSidePt = hideRoute.centerPos + (perp * (5.5 * side))
                local sidePt = clampPositionAboveFloor(rawSidePt, 3.1)
                if isPointStrictlyOpenAir(sidePt, 1.5) and countCollidersHitBySegment(rootPart.Position, sidePt, targetCol, 1.7) == 0 then
                    teleportTween(CFrame.new(sidePt), moveSpd * 0.85, ignoreThreat, true)
                    break
                end
            end
            teleportTween(CFrame.new(hideRoute.centerPos), moveSpd * 0.8, ignoreThreat, true)
            task.wait(0.06)
        end

        if (rootPart.Position - hideRoute.centerPos).Magnitude <= 2.5 then
            rootPart.CFrame = CFrame.new(hideRoute.centerPos)
            character:PivotTo(CFrame.new(hideRoute.centerPos))
        end
    end
    return hideRoute.centerPos, hideRoute
end

-- ==============================================================================
-- EKSEKUSI HYBRID Y-BYPASS DENGAN SLIDER WAKTU TUNGGU (Config.HybridBypassDelay)
-- ==============================================================================
local function executeHybridYTeleport(targetCF, statusFn)
    if not rootPart then return false end

    -- Tahap 1: Menuju ke tengah Collider tebal terdekat
    if statusFn then statusFn("1/3 🛡 Menuju tengah Collider tebal terdekat...", Color3.fromRGB(255, 190, 80)) end
    local centerPos = moveIntoNearestColliderCenter(Config.TweenSpeed, false)
    if abortTeleport or not rootPart then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if not centerPos then
        centerPos = moveIntoNearestColliderCenter(math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5), true)
    end
    if not centerPos then centerPos = rootPart.Position end

    task.wait(0.05)

    -- Tahap 2: Instant Teleport ke koordinat (X_tengah, HybridBypassY, Z_tengah) & Tunggu sesuai Slider
    local bypassY   = Config.HybridBypassY
    local waitDelay = math.max(Config.HybridBypassDelay or 0.4, 0.05)
    local bypassCF  = CFrame.new(centerPos.X, bypassY, centerPos.Z)

    Workspace.Gravity = 0
    teleportInstant(bypassCF, true)

    -- Tahan posisi di koordinat Y-Bypass tanpa Anchored agar client terus mengirim paket posisi ke server
    local holdConn = RunService.Heartbeat:Connect(function()
        if rootPart and not abortTeleport then
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = bypassCF
        end
    end)

    local elapsed = 0
    while elapsed < waitDelay and not abortTeleport and _G.TeleportGUI_Loaded do
        local remain = math.max(waitDelay - elapsed, 0)
        if statusFn then
            statusFn(string.format("2/3 ⏳ Stay di Y=%.0f (%.2fs)...", bypassY, remain), Color3.fromRGB(120, 220, 255))
        end
        local step = math.min(0.05, waitDelay - elapsed)
        task.wait(step)
        elapsed = elapsed + step
    end

    if holdConn then holdConn:Disconnect() end

    if abortTeleport or not rootPart then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    -- Tahap 3: Boom! Instant Teleport langsung ke titik tujuan akhir
    local destPos = clampPositionAboveFloor(targetCF.Position, 3.1)
    local finalDestCF = CFrame.new(destPos)
    if statusFn then
        statusFn(string.format("3/3 💥 Boom! Instant ke (%.0f, %.0f, %.0f)", destPos.X, destPos.Y, destPos.Z), Color3.fromRGB(100, 255, 160))
    end
    teleportInstant(finalDestCF, true)
    task.wait(0.05)
    teleportInstant(finalDestCF, false) -- Kembalikan gravitasi normal (196.2)

    setTargetColliderPassable(nil, false)
    restoreNormalGravity()
    return true
end

local function attemptAlternateAngleTween(targetCF, speed, ignoreThreat, triedAngles)
    if not rootPart then return false end
    triedAngles = triedAngles or {}
    local curPos  = clampPositionAboveFloor(rootPart.Position, 3.1)
    local goalPos = clampPositionAboveFloor(targetCF.Position, 3.1)
    local goalCol = getColliderContainingPoint(goalPos, 1.5)

    local centerHallPt = findNearestOpenHallwayPoint(curPos)
    if centerHallPt and (centerHallPt - curPos).Magnitude >= 2.5 then
        local cHall = teleportTween(CFrame.new(centerHallPt), math.max((speed or Config.TweenSpeed) * 0.85, 0.5), ignoreThreat, true)
        if cHall or abortTeleport then return true end
        task.wait(0.06)
        curPos = clampPositionAboveFloor(rootPart.Position, 3.1)
    end

    local corridorWps, okCorridor = buildMultiStepOpenRoute(curPos, goalPos, goalCol)
    local safeSpd = math.max((speed or Config.TweenSpeed) * 0.85, 0.5)

    if okCorridor and #corridorWps > 0 then
        for _, wp in ipairs(corridorWps) do
            if abortTeleport or not _G.TeleportGUI_Loaded then return true end
            local cStep = teleportTween(CFrame.new(wp), safeSpd, ignoreThreat, true)
            if cStep or abortTeleport then return true end
            task.wait(0.06)
            if rootPart and (rootPart.Position - wp).Magnitude > 5.0 then
                recordFailedRollbackZone(wp)
                break
            end
        end
        if rootPart and (rootPart.Position - goalPos).Magnitude <= 6.0 then
            return false
        end
    end

    curPos = clampPositionAboveFloor(rootPart.Position, 3.1)
    local dir     = Vector3.new(goalPos.X - curPos.X, 0, goalPos.Z - curPos.Z)
    local baseDir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(1, 0, 0)
    local angleList = { 60, -60, 95, -95, 130, -130, 40, -40 }

    for _, deg in ipairs(angleList) do
        if not triedAngles[deg] then
            local rad  = math.rad(deg)
            local cosA = math.cos(rad)
            local sinA = math.sin(rad)
            local rotDir = Vector3.new(baseDir.X * cosA - baseDir.Z * sinA, 0, baseDir.X * sinA + baseDir.Z * cosA)

            for _, dist in ipairs({ 9, 15, 22 }) do
                local rawDetour = curPos + (rotDir * dist)
                local okFl, flY = isPointOnValidFloor(rawDetour)
                if okFl and flY then
                    local detourPt = Vector3.new(rawDetour.X, flY + 3.1, rawDetour.Z)
                    if isPointStrictlyOpenAir(detourPt, 1.95)
                       and isSegmentAboveValidFloor(curPos, detourPt)
                       and not segmentHitsPassiveMonster(curPos, detourPt)
                       and countCollidersHitBySegment(curPos, detourPt, nil, 1.8) == 0 then
                        triedAngles[deg] = true
                        local c1 = teleportTween(CFrame.new(detourPt), safeSpd, ignoreThreat, true)
                        if c1 or abortTeleport then return true end
                        task.wait(0.08)

                        if rootPart and (rootPart.Position - detourPt).Magnitude <= 5.0 then
                            local subWps, okSub = buildMultiStepOpenRoute(rootPart.Position, goalPos, goalCol)
                            if okSub and #subWps > 0 then
                                for _, swp in ipairs(subWps) do
                                    local cSub = teleportTween(CFrame.new(swp), safeSpd, ignoreThreat, true)
                                    if cSub or abortTeleport then return true end
                                    task.wait(0.05)
                                end
                                if rootPart and (rootPart.Position - goalPos).Magnitude <= 6.0 then
                                    return false
                                end
                            end
                        else
                            recordFailedRollbackZone(detourPt)
                        end
                    end
                end
            end
        end
    end

    return false
end

local function clearPathVisuals()
    for _, v in ipairs(pathVisuals) do pcall(function() v:Destroy() end) end
    pathVisuals = {}
end

local function drawWaypoint(pos, color)
    -- Batasi maksimal jumlah bola neon di Workspace agar tidak pernah bikin lag/crash
    if #pathVisuals >= 40 then return end
    local p = Instance.new("Part")
    p.Size       = Vector3.new(0.35, 0.35, 0.35)
    p.Shape      = Enum.PartType.Ball
    p.Anchored   = true
    p.CanCollide = false
    p.Material   = Enum.Material.Neon
    p.Color      = color or Color3.fromRGB(255, 200, 0)
    p.CFrame     = CFrame.new(pos)
    p.Parent     = Workspace
    table.insert(pathVisuals, p)
end

local function safeSingleLayerTween(targetCF, speed, ignoreThreat)
    if not rootPart then return false end
    local startPos = clampPositionAboveFloor(rootPart.Position, 3.1)
    local goalPos  = clampPositionAboveFloor(targetCF.Position, 3.1)
    local goalCol  = getColliderContainingPoint(goalPos, 1.5)

    local routeWps, okRoute = buildMultiStepOpenRoute(startPos, goalPos, goalCol)
    local cancelled = false

    if okRoute and #routeWps > 0 then
        for i, wp in ipairs(routeWps) do
            if abortTeleport or not _G.TeleportGUI_Loaded then return true end
            clearPathVisuals()
            drawWaypoint(wp, (i == #routeWps) and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(80, 200, 255))
            cancelled = teleportTween(CFrame.new(wp), speed, ignoreThreat, true)
            if cancelled or abortTeleport then
                clearPathVisuals()
                return true
            end
            task.wait(0.05)
            if rootPart and (rootPart.Position - wp).Magnitude > 5.5 then
                recordFailedRollbackZone(wp)
                break
            end
        end
        clearPathVisuals()
    else
        cancelled = attemptAlternateAngleTween(CFrame.new(goalPos), speed, ignoreThreat, {})
    end

    if cancelled or abortTeleport then return true end

    task.wait(0.10)
    if rootPart and not abortTeleport and (ignoreThreat or not isThreatened()) then
        local distToGoal = (rootPart.Position - goalPos).Magnitude
        if distToGoal > 6.5 then
            if pfStatusRef then
                pfStatusRef.Text = "🔄 Mental balik terdeteksi! Tween memutar arah lain..."
                pfStatusRef.TextColor3 = Color3.fromRGB(255, 190, 70)
            end
            cancelled = attemptAlternateAngleTween(CFrame.new(goalPos), speed, ignoreThreat, {})
        end
    end

    return cancelled
end

performColliderHide = function(statusFn)
    if not rootPart then return false end
    rootPart.Anchored = false
    isHiding = true

    local hideSpeed = math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)
    local centerPos, hideRoute = moveIntoNearestColliderCenter(hideSpeed, true)
    if abortTeleport or not _G.TeleportGUI_Loaded then
        isHiding = false
        clearAllServerSyncedHolds()
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    local targetCol    = hideRoute and hideRoute.targetCol
    local pName        = (targetCol and targetCol.Parent and targetCol.Parent.Name) or (targetCol and targetCol.Name) or "Collider"
    -- Kunci posisi persembunyian di posisi fisik aktual tempat karakter berhasil masuk agar tidak loop sinkronisasi terus-menerus
    local finalHidePos = (rootPart and centerPos and (rootPart.Position - centerPos).Magnitude <= 4.5) and rootPart.Position or (centerPos or rootPart.Position)

    local hidePlat = Instance.new("Part")
    hidePlat.Size         = Vector3.new(10, 1, 10)
    hidePlat.Anchored     = true
    hidePlat.CanCollide   = true
    hidePlat.Transparency = 1
    hidePlat.CFrame       = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
    hidePlat.Parent       = Workspace

    local syncConn = startServerSyncedHold(function() return finalHidePos end)
    local syncRetryCount = 0

    -- [FIX STUCK SINKRONISASI] Maksimal hanya 1x koreksi posisi, matikan hold saat koreksi, lalu terima posisi aktual
    local function verifyAndFixRealHidePosition()
        if not rootPart or abortTeleport or not _G.TeleportGUI_Loaded or syncRetryCount >= 1 then return end
        local desyncDist = (rootPart.Position - finalHidePos).Magnitude
        if desyncDist > 4.5 then
            syncRetryCount = syncRetryCount + 1
            if syncConn then syncConn:Disconnect(); syncConn = nil end
            if statusFn then statusFn("⚠ Sinkronisasi fisik real ke tengah " .. pName .. "...", Color3.fromRGB(255, 160, 60)) end
            setTargetColliderPassable(targetCol, true)
            teleportTween(CFrame.new(finalHidePos), hideSpeed * 0.85, true, true)
            if rootPart and not abortTeleport then
                -- Langsung update finalHidePos ke titik aktual karakter berdiri sekarang agar tidak pernah stuck loop!
                finalHidePos = rootPart.Position
                syncConn = startServerSyncedHold(function() return finalHidePos end)
            end
        end
    end

    if statusFn then statusFn("🛡 Sembunyi di tengah " .. pName .. ", tunggu monster...", Color3.fromRGB(220, 80, 80)) end
    local hideStartClock = os.clock()
    while isThreatened() and (os.clock() - hideStartClock) < 20 and not abortTeleport and _G.TeleportGUI_Loaded do
        verifyAndFixRealHidePosition()
        if hidePlat and hidePlat.Parent and rootPart then
            hidePlat.CFrame = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
        end
        task.wait(0.2)
    end

    if statusFn and not abortTeleport then
        statusFn("⏳ Tunggu " .. Config.MonsterSafeDelay .. "s sebelum keluar collider...", Color3.fromRGB(180, 180, 60))
    end
    local safeStartClock = os.clock()
    while (os.clock() - safeStartClock) < Config.MonsterSafeDelay and (os.clock() - hideStartClock) < 28 and not abortTeleport and _G.TeleportGUI_Loaded do
        if isThreatened() then
            if statusFn then statusFn("🛡 Monster kembali! Tetap di tengah " .. pName .. "...", Color3.fromRGB(220, 80, 80)) end
            safeStartClock = os.clock()
        end
        task.wait(0.2)
    end

    clearAllServerSyncedHolds()
    if hidePlat and hidePlat.Parent then hidePlat:Destroy() end
    if rootPart then rootPart.Anchored = false end
    isHiding = false

    if abortTeleport or not _G.TeleportGUI_Loaded then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if not Config.HybridYMode then
        if statusFn then statusFn("↩ Aman! Keluar ke ruang terbuka...", Color3.fromRGB(100, 220, 150)) end
        if hideRoute and hideRoute.exitPos then
            teleportTween(CFrame.new(hideRoute.exitPos), Config.TweenSpeed, true, true)
        end
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        task.wait(0.25)
    else
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
    end

    return true
end

-- [UPDATE ANTI-CRASH MONSTER PASIF] Pathfinding memasang Virtual Blocker di posisi LooseMonsters (Monster Pasif)
-- sehingga rute otomatis berbelok menghindari monster pasif tanpa freeze/stuck!
pathfindTween = function(targetCF, statusCb, _attempt)
    if isPathfinding or not rootPart then return end
    isPathfinding = true
    abortTeleport = false
    clearPathVisuals()
    updateColliderCaches()

    local function setStatus(txt, col)
        if pfStatusRef then
            pfStatusRef.Text       = txt
            pfStatusRef.TextColor3 = col or Color3.fromRGB(160, 120, 255)
        end
        if statusCb then statusCb(txt) end
    end

    local comboMode     = Config.PathfindMode and Config.UndergroundTeleport
    local computeTarget = clampPositionAboveFloor(targetCF.Position, 3.1)
    local attempt       = _attempt or 0
    local currentParams = (attempt == 2) and AGENT_PARAMS_LASTRESORT
                       or (attempt == 1) and AGENT_PARAMS_FALLBACK
                       or AGENT_PARAMS

    if attempt > 0 and rootPart and not abortTeleport then
        setStatus("🎯 Menengahkan karakter ke lorong terbuka...", Color3.fromRGB(255, 200, 80))
        local hallPt = findNearestOpenHallwayPoint(rootPart.Position)
        if hallPt and (hallPt - rootPart.Position).Magnitude > 1.5 then
            teleportTween(CFrame.new(hallPt), Config.TweenSpeed * 0.85, false, true)
            task.wait(0.06)
        end
    end

    local allTargetParts = getAllNoClipTargetParts()
    for _, p in ipairs(allTargetParts) do
        if p and p:IsA("BasePart") then p.CanCollide = true end
    end
    for _, col in ipairs(cachedAllCols) do
        if col and col:IsA("BasePart") then col.CanCollide = true end
    end

    local tempVirtualBlockers = {}
    -- 1. Pasang Virtual Blocker pada titik-titik yang pernah bikin mental balik
    for _, badZone in ipairs(failedRollbackZones) do
        if rootPart and (badZone - rootPart.Position).Magnitude > 3.5 and (badZone - computeTarget).Magnitude > 3.5 then
            local vb = Instance.new("Part")
            vb.Name         = "_PFVirtualBlocker"
            vb.Size         = Vector3.new(6.5, 10, 6.5)
            vb.Position     = badZone
            vb.Anchored     = true
            vb.CanCollide   = true
            vb.Transparency = 1
            vb.Parent       = Workspace
            table.insert(tempVirtualBlockers, vb)
        end
    end

    -- 2. Pasang Virtual Blocker di sekeliling semua Monster Pasif (LooseMonsters seperti Blott, Squirm, RazzleDazzle, Rodger, dll)
    -- agar PathfindingService menghitung rute memutar menjauhi monster pasif tersebut!
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        local looseSize = (Config.LooseRadius or 10) * 1.9
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") and isLooseMonsterName(m.Name) then
                local mp = getMonsterPart(m)
                if mp and rootPart and (mp.Position - rootPart.Position).Magnitude > 3.0 and (mp.Position - computeTarget).Magnitude > 4.0 then
                    local mb = Instance.new("Part")
                    mb.Name         = "_PFVirtualBlocker"
                    mb.Size         = Vector3.new(looseSize, 12, looseSize)
                    mb.Position     = mp.Position
                    mb.Anchored     = true
                    mb.CanCollide   = true
                    mb.Transparency = 1
                    mb.Parent       = Workspace
                    table.insert(tempVirtualBlockers, mb)
                end
            end
        end
    end

    local startComputePos = clampPositionAboveFloor(rootPart.Position, 3.1)
    local path = PathfindingService:CreatePath(currentParams)
    local ok   = pcall(function() path:ComputeAsync(startComputePos, computeTarget) end)

    for _, vb in ipairs(tempVirtualBlockers) do
        pcall(function() vb:Destroy() end)
    end

    if Config.NoClip then
        applyNoClipState()
    else
        for _, col in ipairs(cachedAllCols) do
            if col and col:IsA("BasePart") then col.CanCollide = true end
        end
    end

    if not ok or path.Status ~= Enum.PathStatus.Success then
        if attempt < 2 then
            setStatus("🔄 Cari rute baru & tengahkan posisi (" .. tostring(attempt + 1) .. ")...", Color3.fromRGB(220, 180, 60))
            isPathfinding = false
            task.wait(0.1)
            pathfindTween(targetCF, statusCb, attempt + 1)
            return
        else
            setStatus("⚠ Path buntu, gunakan Multi-Step Corridor Detour", Color3.fromRGB(220, 140, 60))
            isPathfinding = false
            if not abortTeleport then
                if comboMode then
                    local target = computeTarget
                    local downY  = rootPart.Position.Y - Config.UGDepth
                    teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
                    if not abortTeleport then teleportTween(CFrame.new(target.X, downY, target.Z), Config.TweenSpeed, false, true) end
                    if not abortTeleport then teleportTween(CFrame.new(target.X, target.Y + 3.1, target.Z), Config.UGRiseSpeed, false, true) end
                else
                    safeSingleLayerTween(CFrame.new(computeTarget), Config.TweenSpeed, false)
                end
            end
            restoreNormalGravity()
            task.delay(2, function() if pfStatusRef then pfStatusRef.Text = "" end end)
            return
        end
    end

    local waypoints = path:GetWaypoints()
    if #waypoints == 0 then
        isPathfinding = false
        if not abortTeleport then safeSingleLayerTween(CFrame.new(computeTarget), Config.TweenSpeed, false) end
        restoreNormalGravity()
        return
    end

    local attemptLabel = (attempt == 1) and " [Rute Baru #1]" or (attempt == 2) and " [Rute Baru #2]" or ""
    local modeLabel    = comboMode and " [COMBO]" or ""
    setStatus("🔵 Pathfinding... (" .. #waypoints .. " titik)" .. attemptLabel .. modeLabel, Color3.fromRGB(160, 120, 255))

    Workspace.Gravity = 0
    local drawStep = math.max(1, math.floor(#waypoints / 30))

    for i, wp in ipairs(waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then
            setStatus("🛑 Dibatalkan", Color3.fromRGB(220, 80, 80))
            task.delay(1.5, function() if pfStatusRef then pfStatusRef.Text = "" end end)
            break
        end

        local rawWpPos = wp.Position
        local safeWpPos = clampPositionAboveFloor(rawWpPos, 3.1)
        local wpY  = comboMode and (rawWpPos.Y - Config.UGDepth) or (Config.UndergroundTeleport and (rawWpPos.Y - Config.UGDepth) or safeWpPos.Y)
        local wpCF = CFrame.new(safeWpPos.X, wpY, safeWpPos.Z)

        if i == #waypoints or (i % drawStep == 0) then
            drawWaypoint(Vector3.new(safeWpPos.X, safeWpPos.Y, safeWpPos.Z), i == #waypoints and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 200, 0))
        end

        local isInterrupted = teleportTween(wpCF, Config.TweenSpeed, false, true)
        if isInterrupted then
            if isThreatened() then
                restoreNormalGravity()
                local resumed = performColliderHide(setStatus)
                isPathfinding = false
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded and attempt < 2 then
                    task.wait(0.2)
                    pathfindTween(targetCF, statusCb, attempt + 1)
                end
                return
            end
            if abortTeleport then break end
        end

        if rootPart and not comboMode and not Config.UndergroundTeleport then
            local distErr = (rootPart.Position - wpCF.Position).Magnitude
            if distErr > 4.2 then
                recordFailedRollbackZone(wpCF.Position)
                setStatus("⚡ Jalur mental terdeteksi! Tengahkan & ganti rute...", Color3.fromRGB(255, 180, 60))
                clearPathVisuals()
                isPathfinding = false
                task.wait(0.1)
                if attempt < 2 then
                    pathfindTween(targetCF, statusCb, attempt + 1)
                else
                    safeSingleLayerTween(CFrame.new(computeTarget), Config.TweenSpeed, false)
                end
                return
            end
        end
    end

    isPathfinding = false
    restoreNormalGravity()
    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end

    if not abortTeleport and rootPart then
        local fp = computeTarget
        if comboMode then
            setStatus("⬆ Naik ke target...", Color3.fromRGB(120, 255, 160))
            teleportTween(CFrame.new(fp.X, fp.Y + 3.1, fp.Z), Config.UGRiseSpeed, false, true)
        elseif Config.UndergroundTeleport then
            rootPart.CFrame = CFrame.new(fp.X, fp.Y - Config.UGDepth, fp.Z)
        end
        setStatus("✔ Pathfind selesai!" .. (comboMode and " [COMBO]" or ""), Color3.fromRGB(100, 220, 150))
        task.delay(2, function()
            if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween / Hybrid dipilih" end
            clearPathVisuals()
        end)
    end

    abortTeleport = false
end

local function doTeleport(cf, mode, speed)
    if Config.HybridYMode then
        executeHybridYTeleport(cf, function(txt, col)
            if pfStatusRef then pfStatusRef.Text = txt; pfStatusRef.TextColor3 = col or Color3.fromRGB(120, 220, 255) end
        end)
        return
    end

    if mode == "Tween" and Config.PathfindMode then
        task.spawn(function() pathfindTween(cf) end)
        return
    end

    if Config.UndergroundTeleport and mode == "Tween" then
        if not rootPart then return end
        local target = cf.Position
        local downY  = rootPart.Position.Y - Config.UGDepth
        teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
        if abortTeleport then restoreNormalGravity(); return end
        teleportTween(CFrame.new(target.X, downY, target.Z), speed, false, true)
        if abortTeleport then restoreNormalGravity(); return end
        teleportTween(CFrame.new(target.X, target.Y + 4, target.Z), Config.UGRiseSpeed, false, true)
        restoreNormalGravity()
        return
    end

    local finalCF = Config.UndergroundTeleport and CFrame.new(cf.Position.X, cf.Position.Y - Config.UGDepth, cf.Position.Z) or cf
    if mode == "Tween" then
        safeSingleLayerTween(finalCF, speed, false)
    else
        teleportInstant(finalCF, false)
    end
    restoreNormalGravity()
end

