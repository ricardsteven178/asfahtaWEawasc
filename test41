            addHighlight(gen, fill, Color3.fromRGB(255, 255, 255), "_GenESP")
            local lbl = gen.Name .. "\n(" .. cur .. "/" .. req .. ")" .. (possessed and "\n[POSSESSED]" or "") .. (completed and "\n[DONE]" or "")
            addBillboard(gen, lbl, fill, "_GenESP")
