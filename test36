local function refreshNoClipESP()
    clearNoClipESP()
    if not Config.NoClipESP then return end
    updateColliderCaches()
    for _, entry in ipairs(cachedESPAdornees) do
        local target = entry.adornee
        if target and target.Parent then
            local sb = Instance.new("SelectionBox")
            sb.Name                = "_NoClipESP"
            sb.Color3              = Color3.fromRGB(255, 40, 40)
            sb.SurfaceColor3       = Color3.fromRGB(255, 40, 40)
            sb.SurfaceTransparency = 0.6
            sb.LineThickness       = 0.04
            sb.Adornee             = target
            sb.Parent              = Workspace

            if Config.NoClipLabel then
                local bb = Instance.new("BillboardGui")
                bb.Name        = "_NoClipESPBB"
                bb.Size        = UDim2.new(0, 110, 0, 26)
                bb.AlwaysOnTop = true
