local function interactWithPrompt(prompt)
    prompt.RequiresLineOfSight   = false
    prompt.MaxActivationDistance = math.huge
    if fireproximityprompt then
        fireproximityprompt(prompt, 1)
    else
        pcall(function()
            prompt:InputHoldBegin()
            if prompt.HoldDuration > 0 then task.wait(prompt.HoldDuration) end
            prompt:InputHoldEnd()
        end)
    end
end

local function getItemsInRoom()
    local items  = {}
    local map    = getMap()
    local folder = map and map:FindFirstChild("Items")
    if not folder then return items end
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Model") then
            if not items[item.Name] then
                items[item.Name] = { count = 0, instances = {} }
            end
            items[item.Name].count = items[item.Name].count + 1
            table.insert(items[item.Name].instances, item)
        end
    end
    return items
end

local function getOpenAirStandCFForItem(itemPos)
    local rawPos = Vector3.new(itemPos.X, itemPos.Y + 3, itemPos.Z)
    if isPointStrictlyOpenAir(rawPos, 1.5) then
        return CFrame.new(rawPos)
    end

    local yLevel = rootPart and rootPart.Position.Y or (itemPos.Y + 3)
    local dirs = {
        Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
        Vector3.new(0.707, 0, 0.707), Vector3.new(-0.707, 0, 0.707),
        Vector3.new(0.707, 0, -0.707), Vector3.new(-0.707, 0, -0.707),
    }

    if rootPart then
        table.sort(dirs, function(a, b)
            local pA = Vector3.new(itemPos.X, yLevel, itemPos.Z) + a * 4
            local pB = Vector3.new(itemPos.X, yLevel, itemPos.Z) + b * 4
            return (pA - rootPart.Position).Magnitude < (pB - rootPart.Position).Magnitude
        end)
    end

    for _, dist in ipairs({ 3.6, 4.8, 6.0 }) do
        for _, d in ipairs(dirs) do
            local candidate = Vector3.new(itemPos.X, yLevel, itemPos.Z) + (d * dist)
            if isPointStrictlyOpenAir(candidate, 1.5) then
                return CFrame.new(candidate)
            end
        end
    end
    return CFrame.new(rawPos)
end

local function pickupSelectedItem(targetName, cb)
    if isPickingUp then return end
    isPickingUp             = true
    abortTeleport           = false
    Config.PickupMode       = Config.TeleportMode
    Config.PickupTweenSpeed = Config.TweenSpeed

    task.spawn(function()
        updateColliderCaches()

        local function makePlatform(atPos)
            local plat = Instance.new("Part")
            plat.Size         = Vector3.new(10, 1, 10)
            plat.Anchored     = true
            plat.CanCollide   = true
            plat.Transparency = 1
            plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
            plat.Parent       = Workspace
            return plat
        end

        local function getRemainingTargets()
            local list   = {}
            local map    = getMap()
            local folder = map and map:FindFirstChild("Items")
            if not folder then return list end
            for _, item in ipairs(folder:GetChildren()) do
                if item:IsA("Model") and item.Name == targetName and item.Parent then
                    table.insert(list, item)
                end
            end
            if rootPart then
                table.sort(list, function(a, b)
                    return (rootPart.Position - a:GetPivot().Position).Magnitude
                         < (rootPart.Position - b:GetPivot().Position).Magnitude
                end)
            end
            return list
        end

        local initialList = getRemainingTargets()
        if #initialList == 0 then
            if cb then cb("Item '" .. targetName .. "' tidak ada di room!") end
            isPickingUp = false
            return
        end

        local skipCounts = {}

        while isPickingUp and not abortTeleport and _G.TeleportGUI_Loaded do
            if isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
            end

            local remaining = getRemainingTargets()
            local item = nil
            for _, it in ipairs(remaining) do
                if (skipCounts[it] or 0) < 4 then
                    item = it
                    break
                end
            end

            if not item or not item.Parent or not rootPart then
                break
            end

            if cb then cb("🎯 Mengambil " .. targetName .. " (Sisa: " .. #remaining .. ")...") end

            local itemPos = item:GetPivot().Position
            local standCF = getOpenAirStandCFForItem(itemPos)
            local exactCF = CFrame.new(itemPos.X, itemPos.Y + 3, itemPos.Z)

            local moveInterrupted = false
            if Config.HybridYMode then
                executeHybridYTeleport(exactCF, function(msg) if cb then cb(msg) end end)
            elseif Config.PickupMode == "Tween" and Config.PathfindMode then
                task.spawn(function() pathfindTween(standCF) end)
                local w = 0
                while not isPathfinding and w < 1 do task.wait(0.05); w = w + 0.05 end
                w = 0
                while (isPathfinding or isHiding) and w < 60 and not abortTeleport and isPickingUp do
                    task.wait(0.1)
                    w = w + 0.1
                end
                task.wait(0.2)
            elseif Config.PickupMode == "Tween" and Config.UndergroundTeleport then
                local downY = rootPart.Position.Y - Config.UGDepth
                moveInterrupted = teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed, false, true)
                if not moveInterrupted and not abortTeleport then
                    moveInterrupted = teleportTween(CFrame.new(standCF.X, downY, standCF.Z), Config.PickupTweenSpeed, false, true)
                end
                if not moveInterrupted and not abortTeleport then
                    moveInterrupted = teleportTween(CFrame.new(standCF.X, standCF.Y + 1, standCF.Z), Config.UGRiseSpeed, false, true)
                end
            elseif Config.PickupMode == "Tween" then
                moveInterrupted = safeSingleLayerTween(standCF, Config.PickupTweenSpeed, false)
            else
                teleportInstant(exactCF, false)
            end

            if abortTeleport or not isPickingUp then break end

            if moveInterrupted or isThreatened() then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.1)
                continue
            end

            rootPart.Anchored = true
            local plat = makePlatform(rootPart.Position)
            local waitTicks = 0
            local monsterInterrupted = false

            while item.Parent and waitTicks < 25 and not abortTeleport and isPickingUp do
                if isThreatened() then
                    monsterInterrupted = true
                    break
                end

                if waitTicks == 10 and item.Parent and rootPart and not Config.HybridYMode then
                    rootPart.Anchored = false
                    teleportTween(exactCF, Config.PickupTweenSpeed, false, true)
                    if rootPart then rootPart.Anchored = true end
                end

                local pp   = item:FindFirstChild("Prompt")
                local prox = pp and pp:FindFirstChild("ProximityPrompt")
                if prox and prox.Enabled then
                    interactWithPrompt(prox)
                end

                task.wait(0.1)
                waitTicks = waitTicks + 1
            end

            if plat and plat.Parent then plat:Destroy() end
            if rootPart then rootPart.Anchored = false end

            if monsterInterrupted then
                local okHide = performColliderHide(function(msg) if cb then cb(msg) end end)
                if not okHide or abortTeleport or not isPickingUp then break end
                task.wait(0.1)
                continue
            end

            if item.Parent then
                skipCounts[item] = (skipCounts[item] or 0) + 1
            end

            if Config.HybridYMode and not abortTeleport and isPickingUp then
                if cb then cb("🛡 Selesai ambil, kembali ke tengah Collider tebal...") end
                moveIntoNearestColliderCenter(Config.TweenSpeed, true)
                setTargetColliderPassable(nil, false)
                restoreNormalGravity()
                task.wait(0.15)
            else
                restoreNormalGravity()
                task.wait(0.25)
            end
        end

        if rootPart then rootPart.Anchored = false end
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        if cb then cb("✔ Selesai ambil " .. targetName .. "!") end
        isPickingUp = false
    end)
end

