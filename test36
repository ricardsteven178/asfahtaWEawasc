local function isThreatened()
    local pGui        = player:FindFirstChild("PlayerGui")
    local screenGui   = pGui and pGui:FindFirstChild("ScreenGui")
    local monsterIcon = screenGui and screenGui:FindFirstChild("MonsterIcon")
    if monsterIcon and monsterIcon.Visible and monsterIcon.ImageTransparency < 0.99 then
        return true
    end

    if not rootPart then return false end
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, monster in pairs(monstersFolder:GetChildren()) do
            if monster:IsA("Model") then
                local chasing = monster:FindFirstChild("ChasingValue")
                if chasing and chasing.Value == character then
                    return true
                end
                local primaryPart = monster.PrimaryPart or monster:FindFirstChildWhichIsA("BasePart")
                if primaryPart and (primaryPart.Position - rootPart.Position).Magnitude <= Config.MonsterDangerRadius then
                    return true
                end
            end
        end
    end
    return false
end

local function getMinDistanceToMonsters(pt)
    local minDist = math.huge
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") then
                local p = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
                if p then
                    local d = (p.Position - pt).Magnitude
                    if d < minDist then minDist = d end
                end
            end
        end
    end
    return minDist
end

local function isPointInsideExpandedBox(pt, part, marginXZ, marginY)
    if not part or not part:IsA("BasePart") then return false end
    marginXZ  = marginXZ or 0
    marginY   = marginY or marginXZ
    local wSz = getWorldBoxSize(part)
    local rel = pt - part.Position
    return math.abs(rel.X) <= (wSz.X * 0.5 + marginXZ)
       and math.abs(rel.Y) <= (wSz.Y * 0.5 + marginY)
       and math.abs(rel.Z) <= (wSz.Z * 0.5 + marginXZ)
end

local function segmentIntersectsExpandedBox(posA, posB, part, padXZ, padY)
    if not part or not part:IsA("BasePart") then return false end
    padXZ = padXZ or 1.8
    padY  = padY or 2.0

    local cf = part.CFrame
    local lA = cf:PointToObjectSpace(posA)
    local lB = cf:PointToObjectSpace(posB)
    local d  = lB - lA

    local hx = part.Size.X * 0.5 + padXZ
    local hy = part.Size.Y * 0.5 + padY
    local hz = part.Size.Z * 0.5 + padXZ

    local tMin, tMax = 0.0, 1.0

    if math.abs(d.X) < 1e-6 then
        if math.abs(lA.X) > hx then return false end
    else
        local inv = 1.0 / d.X
        local t1, t2 = (-hx - lA.X) * inv, (hx - lA.X) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false end
    end

    if math.abs(d.Y) < 1e-6 then
        if math.abs(lA.Y) > hy then return false end
    else
        local inv = 1.0 / d.Y
        local t1, t2 = (-hy - lA.Y) * inv, (hy - lA.Y) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false end
    end

    if math.abs(d.Z) < 1e-6 then
        if math.abs(lA.Z) > hz then return false end
    else
        local inv = 1.0 / d.Z
        local t1, t2 = (-hz - lA.Z) * inv, (hz - lA.Z) * inv
        if t1 > t2 then t1, t2 = t2, t1 end
        if t1 > tMin then tMin = t1 end
        if t2 < tMax then tMax = t2 end
        if tMin > tMax then return false end
    end

    return tMin <= tMax
end

local function countCollidersHitBySegment(posA, posB, ignoredCol, padXZ)
    padXZ = padXZ or 1.85
    local allCols   = getNoClipColliders()
    local room      = Workspace:FindFirstChild("CurrentRoom")
    local map       = getMap()
    local hitGroups = {}
    local count     = 0

    local ignoredGroup = (ignoredCol and ignoredCol.Parent and ignoredCol.Parent:IsA("Model") and ignoredCol.Parent ~= room and ignoredCol.Parent ~= map)
        and ignoredCol.Parent or ignoredCol

    for _, col in ipairs(allCols) do
        if col and col.Parent and col ~= ignoredCol then
            local groupKey = (col.Parent and col.Parent:IsA("Model") and col.Parent ~= room and col.Parent ~= map)
                and col.Parent or col

            if groupKey ~= ignoredGroup and not hitGroups[groupKey] then
                if segmentIntersectsExpandedBox(posA, posB, col, padXZ, 1.8) then
                    hitGroups[groupKey] = true
                    count = count + 1
                end
            end
        end
    end
    return count
end

local function isPointStrictlyOpenAir(pt, marginXZ)
    marginXZ = marginXZ or 2.0
    for _, col in ipairs(getNoClipColliders()) do
        if col and col.Parent and isPointInsideExpandedBox(pt, col, marginXZ, 1.8) then
            return false
        end
    end
    return true
end

local function findSafeExitPointOutsideCollider(fromPos, centerPos, targetCol)
    local dir = fromPos - centerPos
    dir = Vector3.new(dir.X, 0, dir.Z)
    local baseDir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(1, 0, 0)
    local perpDir = Vector3.new(-baseDir.Z, 0, baseDir.X)
    local wSz     = getWorldBoxSize(targetCol)
    local radius  = math.max(wSz.X, wSz.Z) * 0.5 + 3.5

    local dirs = {
        baseDir, perpDir, -perpDir, -baseDir,
        (baseDir + perpDir).Unit, (baseDir - perpDir).Unit,
        (-baseDir + perpDir).Unit, (-baseDir - perpDir).Unit,
    }

    for _, d in ipairs(dirs) do
        for extra = 0, 6, 3 do
            local candidate = centerPos + d * (radius + extra)
            if isPointStrictlyOpenAir(candidate, 1.9) then
                if countCollidersHitBySegment(centerPos, candidate, targetCol, 1.8) == 0 then
                    return candidate
                end
            end
        end
    end
    return fromPos
end

local function getNearestSafeColliderRoute(startPos)
    updateColliderCaches()
    local hideableCols = cachedHideCols

    if #hideableCols == 0 then
        local room = Workspace:FindFirstChild("CurrentRoom")
        if room then
            for _, v in ipairs(room:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name == "NoClip_Collider" or v.Name == "CylinderCollider") then
                    local wSz = getWorldBoxSize(v)
                    local pName = (v.Parent and v.Parent.Name or ""):lower()
                    if math.min(wSz.X, wSz.Z) >= 2.4 and not pName:find("wall") and not pName:find("railing") then
                        table.insert(hideableCols, v)
                    end
                end
            end
        end
    end

    if #hideableCols == 0 then
        return { waypoints = { startPos }, targetCol = nil, centerPos = startPos, exitPos = startPos }
    end

    local candidates = {}
    for _, col in ipairs(hideableCols) do
        if col and col.Parent then
            local wSz     = getWorldBoxSize(col)
            local minY    = col.Position.Y - (wSz.Y * 0.5) + 2.5
            local maxY    = col.Position.Y + (wSz.Y * 0.5) - 0.5
            local targetY = (minY <= maxY) and math.clamp(startPos.Y, minY, maxY) or startPos.Y
            local center  = Vector3.new(col.Position.X, targetY, col.Position.Z)

            local touchesAdjacentObject = (countCollidersHitBySegment(center, center, col, 2.0) > 0)
            local monsterDist           = getMinDistanceToMonsters(center)
            local minThickness          = math.min(wSz.X, wSz.Z)

            table.insert(candidates, {
                col         = col,
                centerPos   = center,
                dist        = (center - startPos).Magnitude,
                isIsolated  = not touchesAdjacentObject,
                SafeFromMob = (monsterDist >= 8.0),
                thickness   = minThickness,
            })
        end
    end

    table.sort(candidates, function(a, b)
        if a.SafeFromMob ~= b.SafeFromMob then
            return a.SafeFromMob
        end
        if a.isIsolated ~= b.isIsolated then
            return a.isIsolated
        end
        return a.dist < b.dist
    end)

    for _, cand in ipairs(candidates) do
        if cand.isIsolated and countCollidersHitBySegment(startPos, cand.centerPos, cand.col, 1.9) == 0 then
            local exitPt = findSafeExitPointOutsideCollider(startPos, cand.centerPos, cand.col)
            return { waypoints = { cand.centerPos }, targetCol = cand.col, centerPos = cand.centerPos, exitPos = exitPt }
        end
    end

    for _, cand in ipairs(candidates) do
        if cand.isIsolated then
            local dir = cand.centerPos - startPos
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            if flatDir.Magnitude > 0.5 then
                local uDir = flatDir.Unit
                local perp = Vector3.new(-uDir.Z, 0, uDir.X)
                local midBase = startPos:Lerp(cand.centerPos, 0.5)

                for _, offsetDist in ipairs({ 6, 11, 16, 22 }) do
                    for _, side in ipairs({ 1, -1 }) do
                        local midPt = Vector3.new(midBase.X, startPos.Y, midBase.Z) + (perp * (offsetDist * side))
                        if isPointStrictlyOpenAir(midPt, 2.0) then
                            if countCollidersHitBySegment(startPos, midPt, nil, 1.8) == 0
                               and countCollidersHitBySegment(midPt, cand.centerPos, cand.col, 1.8) == 0 then
                                local exitPt = findSafeExitPointOutsideCollider(midPt, cand.centerPos, cand.col)
                                return { waypoints = { midPt, cand.centerPos }, targetCol = cand.col, centerPos = cand.centerPos, exitPos = exitPt }
                            end
                        end
                    end
                end
            end
        end
    end

    for _, cand in ipairs(candidates) do
        if countCollidersHitBySegment(startPos, cand.centerPos, cand.col, 1.5) == 0 then
            local exitPt = findSafeExitPointOutsideCollider(startPos, cand.centerPos, cand.col)
            return { waypoints = { cand.centerPos }, targetCol = cand.col, centerPos = cand.centerPos, exitPos = exitPt }
        end
    end

    local best = candidates[1]
    local exitPt = findSafeExitPointOutsideCollider(startPos, best.centerPos, best.col)
    return { waypoints = { best.centerPos }, targetCol = best.col, centerPos = best.centerPos, exitPos = exitPt }
end

