local function clearESP(tag)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local e = obj:FindFirstChild(tag)
        if e then e:Destroy() end
    end
end

local function addHighlight(parent, fill, outline, tag)
    if parent:FindFirstChild(tag) then return end
    local h = Instance.new("Highlight")
    h.Name             = tag
    h.FillColor        = fill
    h.OutlineColor     = outline
    h.FillTransparency = 0.5
    h.Parent           = parent
end

local function addBillboard(parent, text, color, tag)
    if parent:FindFirstChild(tag .. "BB") then return end
    local bb = Instance.new("BillboardGui")
    bb.Name        = tag .. "BB"
    bb.Size        = UDim2.new(0, 120, 0, 40)
    bb.AlwaysOnTop = true
    bb.Parent      = parent
    if parent:IsA("Model") and parent.PrimaryPart then
        bb.Adornee = parent.PrimaryPart
    elseif parent:IsA("BasePart") then
        bb.Adornee = parent
    end

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size                   = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                   = text
    lbl.TextColor3             = color
    lbl.TextStrokeTransparency = 0.4
