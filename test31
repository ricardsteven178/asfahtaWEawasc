isThreatened = function()
    local pGui        = player:FindFirstChild("PlayerGui")
    local screenGui   = pGui and pGui:FindFirstChild("ScreenGui")
    local monsterIcon = screenGui and screenGui:FindFirstChild("MonsterIcon")
    if monsterIcon and monsterIcon.Visible and monsterIcon.ImageTransparency < 0.99 then
        return true
    end

    if not rootPart then return false end
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, monster in pairs(monstersFolder:GetChildren()) do
            if monster:IsA("Model") then
                local chasing = monster:FindFirstChild("ChasingValue")
                if chasing and chasing.Value == character then
                    return true
                end
                local primaryPart = monster.PrimaryPart or monster:FindFirstChildWhichIsA("BasePart")
                if primaryPart and (primaryPart.Position - rootPart.Position).Magnitude <= Config.MonsterDangerRadius then
                    return true
                end
            end
        end
    end
    return false
end

local function isPointInsidePart(pt, part, margin)
    if not part or not part:IsA("BasePart") then return false end
    margin = margin or 0
    local rel = part.CFrame:PointToObjectSpace(pt)
    return math.abs(rel.X) <= (part.Size.X * 0.5 + margin)
       and math.abs(rel.Y) <= (part.Size.Y * 0.5 + margin)
       and math.abs(rel.Z) <= (part.Size.Z * 0.5 + margin)
end

-- Memastikan jalur Tween menuju titik tengah kotak merah hanya menembus 1 collider (targetCol)
local function isSingleLayerPath(startPos, targetCenter, targetCol, allColliders)
    local otherCols = {}
    for _, c in ipairs(allColliders) do
        if c and c.Parent and c ~= targetCol then
            c.CanQuery = true
            table.insert(otherCols, c)
        end
    end
    if #otherCols == 0 then return true end

    for _, oc in ipairs(otherCols) do
        if isPointInsidePart(startPos, oc, 0.25) or isPointInsidePart(targetCenter, oc, 0.35) then
            return false
        end
    end

    local dir  = targetCenter - startPos
    local dist = dir.Magnitude
    if dist < 0.2 then return true end

    local steps   = math.max(math.ceil(dist / 1.0), 2)
    local unitDir = dir.Unit
    local perpXZ  = Vector3.new(-unitDir.Z, 0, unitDir.X)
    perpXZ = (perpXZ.Magnitude > 0.01) and (perpXZ.Unit * 0.8) or Vector3.zero

    for i = 1, steps - 1 do
        local samplePt = startPos:Lerp(targetCenter, i / steps)
        for _, oc in ipairs(otherCols) do
            if isPointInsidePart(samplePt, oc, 0.2)
                or isPointInsidePart(samplePt + perpXZ, oc, 0.1)
                or isPointInsidePart(samplePt - perpXZ, oc, 0.1) then
                return false
            end
        end
    end

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Include
    rp.FilterDescendantsInstances = otherCols

    local offsets = { Vector3.zero, perpXZ, -perpXZ, Vector3.new(0, 1.5, 0), Vector3.new(0, -1.0, 0) }
    for _, off in ipairs(offsets) do
        if Workspace:Raycast(startPos + off, dir, rp) or Workspace:Raycast(targetCenter + off, -dir, rp) then
            return false
        end
    end

    return true
end

local function getNearestSafeColliderCFrame(startPos)
    local hideableCols = getHideableColliders()
    local allCols      = getNoClipColliders()
    if #hideableCols == 0 then return CFrame.new(startPos), nil end

    local candidates = {}
    for _, col in ipairs(hideableCols) do
        if col and col.Parent then
            local minY    = col.Position.Y - (col.Size.Y * 0.5) + 2.5
            local maxY    = col.Position.Y + (col.Size.Y * 0.5) - 0.5
            local targetY = (minY <= maxY) and math.clamp(startPos.Y, minY, maxY) or startPos.Y
            local center  = Vector3.new(col.Position.X, targetY, col.Position.Z)
            table.insert(candidates, { col = col, centerPos = center, dist = (center - startPos).Magnitude })
        end
    end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)

    for _, cand in ipairs(candidates) do
        if isSingleLayerPath(startPos, cand.centerPos, cand.col, allCols) then
            return CFrame.new(cand.centerPos), cand.col
        end
    end

    for _, cand in ipairs(candidates) do
        if isPointInsidePart(startPos, cand.col, 0.5) then
            return CFrame.new(cand.centerPos), cand.col
        end
    end

    return CFrame.new(candidates[1].centerPos), candidates[1].col
end

