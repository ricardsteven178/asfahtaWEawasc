-- SECTION 6: TELEPORT & PATHFINDING ENGINE
-- ==============================================================================
local function teleportInstant(cf)
    if not rootPart then return end
    local g = Workspace.Gravity
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity = Vector3.zero
    character:PivotTo(cf)
    Workspace.Gravity = g
end

local function teleportTween(cf, speed, ignoreThreat)
    if not rootPart then return false end
    local g = Workspace.Gravity
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity = Vector3.zero

    local spd  = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
    local dist = (rootPart.Position - cf.Position).Magnitude
    local dur  = math.max(dist / (spd * (speed or 1.25)), 0.001)

    local tw = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
    activeTween = tw
    tw:Play()

    local done, cancelled = false, false
    tw.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed then done = true end
    end)

    while not done do
        if not ignoreThreat and (abortTeleport or (isThreatened and isThreatened())) then
            tw:Cancel()
            cancelled = true
            break
        end
        task.wait(0.01)
    end

    if not cancelled and not isHiding then
        rootPart.CFrame = cf
    end

    rootPart.AssemblyLinearVelocity = Vector3.zero
    if activeTween == tw then activeTween = nil end
    Workspace.Gravity = g
    return cancelled
end

local function refreshColliderCache()
    cachedColliders = getNoClipColliders()
    for _, col in ipairs(cachedColliders) do
        if col and col:IsA("BasePart") then col.CanQuery = true end
    end
end

local function clearPathVisuals()
    for _, v in ipairs(pathVisuals) do pcall(function() v:Destroy() end) end
    pathVisuals = {}
end

local function drawWaypoint(pos, color)
    local p = Instance.new("Part")
    p.Size       = Vector3.new(0.35, 0.35, 0.35)
    p.Shape      = Enum.PartType.Ball
    p.Anchored   = true
    p.CanCollide = false
    p.Material   = Enum.Material.Neon
    p.Color      = color or Color3.fromRGB(255, 200, 0)
    p.CFrame     = CFrame.new(pos)
    p.Parent     = Workspace
    table.insert(pathVisuals, p)
end

hideFromMonsterAndResume = function(targetCF, statusCb, setStatusFn, g)
    if not isThreatened() then return false end

    Workspace.Gravity = g
    local pausePos = rootPart.Position
    local fleeTargetCF, targetCol = getNearestSafeColliderCFrame(pausePos)
    local colLabel = targetCol and targetCol.Name or "Collider"

    setStatusFn("👁 Monster! Masuk tengah " .. colLabel .. " (1-Layer)...", Color3.fromRGB(255, 60, 60))

    isHiding = true
    setTargetColliderPassable(targetCol, true)

    teleportTween(fleeTargetCF, math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5), true)
    if rootPart then
        rootPart.CFrame   = fleeTargetCF
        rootPart.Anchored = true
    end

    setStatusFn("🛡 Di tengah " .. colLabel .. ", tunggu monster pergi...", Color3.fromRGB(220, 80, 80))
    while isThreatened() and not abortTeleport and _G.TeleportGUI_Loaded do
        task.wait(0.2)
    end

    if abortTeleport or not _G.TeleportGUI_Loaded then
        if rootPart then rootPart.Anchored = false end
        setTargetColliderPassable(nil, false)
        isPathfinding, isHiding = false, false
        Workspace.Gravity = g
        return true
    end

    setStatusFn("⏳ Tunggu " .. Config.MonsterSafeDelay .. "s sebelum keluar collider...", Color3.fromRGB(180, 180, 60))
    local safeWait = 0
    while safeWait < Config.MonsterSafeDelay and not abortTeleport and _G.TeleportGUI_Loaded do
        if isThreatened() then
            setStatusFn("🛡 Monster kembali! Tetap di tengah " .. colLabel .. "...", Color3.fromRGB(220, 80, 80))
            safeWait = 0
        end
        task.wait(0.2)
        safeWait = safeWait + 0.2
    end

    if rootPart then rootPart.Anchored = false end

    if abortTeleport or not _G.TeleportGUI_Loaded then
        setTargetColliderPassable(nil, false)
        isPathfinding, isHiding = false, false
        Workspace.Gravity = g
        return true
    end

    setStatusFn("↩ Aman! Keluar dari " .. colLabel .. "...", Color3.fromRGB(100, 220, 150))
    teleportTween(CFrame.new(pausePos), Config.TweenSpeed, true)
    setTargetColliderPassable(nil, false)

    setStatusFn("🔄 Recompute path...", Color3.fromRGB(160, 120, 255))
    Workspace.Gravity = g
    rootPart.AssemblyLinearVelocity = Vector3.zero
    abortTeleport, isPathfinding, isHiding = false, false, false
    task.wait(0.1)

    task.spawn(function()
        task.wait(0.05)
        pathfindTween(targetCF, statusCb, 0)
    end)
    return true
end

pathfindTween = function(targetCF, statusCb, _attempt)
    if isPathfinding or not rootPart then return end
    isPathfinding = true
    abortTeleport = false
    clearPathVisuals()
    refreshColliderCache()

    local function setStatus(txt, col)
        if pfStatusRef then
            pfStatusRef.Text       = txt
            pfStatusRef.TextColor3 = col or Color3.fromRGB(160, 120, 255)
        end
        if statusCb then statusCb(txt) end
    end

    local comboMode     = Config.PathfindMode and Config.UndergroundTeleport
    local computeTarget = targetCF.Position
    local attempt       = _attempt or 0
    local currentParams = (attempt == 2) and AGENT_PARAMS_LASTRESORT
                       or (attempt == 1) and AGENT_PARAMS_FALLBACK
                       or AGENT_PARAMS

    for _, col in ipairs(cachedColliders) do
        if col and col:IsA("BasePart") then col.CanCollide = true end
    end

    local path = PathfindingService:CreatePath(currentParams)
    local ok   = pcall(function() path:ComputeAsync(rootPart.Position, computeTarget) end)

    if Config.NoClip then
        applyNoClipState()
    else
        for _, col in ipairs(cachedColliders) do
            if col and col:IsA("BasePart") then col.CanCollide = true end
        end
    end

    if not ok or path.Status ~= Enum.PathStatus.Success then
        if attempt < 2 then
            setStatus("🔄 Retry path (" .. tostring(attempt) .. ")...", Color3.fromRGB(220, 180, 60))
            isPathfinding = false
            task.wait(0.1)
            pathfindTween(targetCF, statusCb, attempt + 1)
            return
        else
            setStatus("⚠ Path gagal, fallback lurus", Color3.fromRGB(220, 100, 60))
            if not abortTeleport then
                if comboMode then
                    local target = targetCF.Position
                    local downY  = rootPart.Position.Y - Config.UGDepth
                    teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed)
                    if not abortTeleport then teleportTween(CFrame.new(target.X, downY, target.Z), Config.TweenSpeed) end
                    if not abortTeleport then teleportTween(CFrame.new(target.X, target.Y + 4, target.Z), Config.UGRiseSpeed) end
                else
                    teleportTween(targetCF, Config.TweenSpeed)
                end
            end
            task.delay(2, function() if pfStatusRef then pfStatusRef.Text = "" end end)
            isPathfinding = false
            return
        end
    end

    local waypoints = path:GetWaypoints()
    if #waypoints == 0 then
        if not abortTeleport then teleportTween(targetCF, Config.TweenSpeed) end
        isPathfinding = false
        return
    end

    local attemptLabel = (attempt == 1) and " [fallback]" or (attempt == 2) and " [last resort]" or ""
    local modeLabel    = comboMode and " [COMBO]" or ""
    setStatus("🔵 Pathfinding... (" .. #waypoints .. " titik)" .. attemptLabel .. modeLabel, Color3.fromRGB(160, 120, 255))

    local g = Workspace.Gravity
    Workspace.Gravity = 0

    for i, wp in ipairs(waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then
            setStatus("🛑 Dibatalkan", Color3.fromRGB(220, 80, 80))
            task.delay(1.5, function() if pfStatusRef then pfStatusRef.Text = "" end end)
            break
        end

        local wpY  = comboMode and (wp.Position.Y - Config.UGDepth) or (wp.Position.Y + (Config.UndergroundTeleport and -Config.UGDepth or 0.5))
        local wpCF = CFrame.new(wp.Position.X, wpY, wp.Position.Z)

        drawWaypoint(wp.Position, i == #waypoints and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 200, 0))

        local isInterrupted = teleportTween(wpCF, Config.TweenSpeed)
        if isInterrupted then
            if isThreatened() and hideFromMonsterAndResume(targetCF, statusCb, setStatus, g) then
                return
            end
            if abortTeleport then break end
        end
    end

    Workspace.Gravity = g
    rootPart.AssemblyLinearVelocity = Vector3.zero

    if not abortTeleport then
        local fp = targetCF.Position
        if comboMode then
            setStatus("⬆ Naik ke target...", Color3.fromRGB(120, 255, 160))
            teleportTween(CFrame.new(fp.X, fp.Y + 4, fp.Z), Config.UGRiseSpeed)
            if not abortTeleport and rootPart then
                rootPart.CFrame = CFrame.new(fp.X, fp.Y + 4, fp.Z)
            end
        elseif Config.UndergroundTeleport then
            rootPart.CFrame = CFrame.new(fp.X, fp.Y - Config.UGDepth, fp.Z)
        elseif (rootPart.Position - targetCF.Position).Magnitude > 2 then
            rootPart.CFrame = targetCF
        end
        setStatus("✔ Pathfind selesai!" .. (comboMode and " [COMBO]" or ""), Color3.fromRGB(100, 220, 150))
        task.delay(2, function()
            if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween dipilih" end
            clearPathVisuals()
        end)
    end

    abortTeleport = false
    isPathfinding = false
end

local function doTeleport(cf, mode, speed)
    if mode == "Tween" and Config.PathfindMode then
        task.spawn(function() pathfindTween(cf) end)
        return
    end

    if Config.UndergroundTeleport and mode == "Tween" then
        if not rootPart then return end
        local target = cf.Position
        local downY  = rootPart.Position.Y - Config.UGDepth
        teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed)
        if abortTeleport then return end
        teleportTween(CFrame.new(target.X, downY, target.Z), speed)
        if abortTeleport then return end
        teleportTween(CFrame.new(target.X, target.Y + 4, target.Z), Config.UGRiseSpeed)
        return
    end

    local finalCF = Config.UndergroundTeleport and CFrame.new(cf.Position.X, cf.Position.Y - Config.UGDepth, cf.Position.Z) or cf
    if mode == "Tween" then
        teleportTween(finalCF, speed)
    else
        teleportInstant(finalCF)
    end
end

