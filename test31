local function interactWithPrompt(prompt)
    prompt.RequiresLineOfSight   = false
    prompt.MaxActivationDistance = math.huge
    if fireproximityprompt then
        fireproximityprompt(prompt, 1)
    else
        pcall(function()
            prompt:InputHoldBegin()
            if prompt.HoldDuration > 0 then task.wait(prompt.HoldDuration) end
            prompt:InputHoldEnd()
        end)
    end
end

local function getItemsInRoom()
    local items  = {}
    local map    = getMap()
    local folder = map and map:FindFirstChild("Items")
    if not folder then return items end
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Model") then
            if not items[item.Name] then
                items[item.Name] = { count = 0, instances = {} }
            end
            items[item.Name].count = items[item.Name].count + 1
            table.insert(items[item.Name].instances, item)
        end
    end
    return items
end

local function pickupSelectedItem(targetName, cb)
    if isPickingUp then return end
    isPickingUp             = true
    Config.PickupMode       = Config.TeleportMode
    Config.PickupTweenSpeed = Config.TweenSpeed

    task.spawn(function()
        local map    = getMap()
        local folder = map and map:FindFirstChild("Items")
        if not folder then
            if cb then cb("Tidak ada Items folder!") end
            isPickingUp = false
            return
        end

        local targets = {}
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Model") and item.Name == targetName then
                table.insert(targets, item)
            end
        end
        if #targets == 0 then
            if cb then cb("Item '" .. targetName .. "' tidak ada di room!") end
            isPickingUp = false
            return
        end

        if cb then cb("Mengambil " .. #targets .. "x " .. targetName .. "...") end

        local function sortByNearest()
            if not rootPart then return end
            table.sort(targets, function(a, b)
                if not a.Parent then return false end
                if not b.Parent then return true end
                return (rootPart.Position - a:GetPivot().Position).Magnitude
                     < (rootPart.Position - b:GetPivot().Position).Magnitude
            end)
        end

        local function makePlatform(atPos)
            local plat = Instance.new("Part")
            plat.Size         = Vector3.new(10, 1, 10)
            plat.Anchored     = true
            plat.CanCollide   = true
            plat.Transparency = 1
            plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
            plat.Parent       = Workspace
            return plat
        end

        local function hideInNearestColliderAndReturn(targetItemCF)
            local savedPos = rootPart.Position
            local fleeTargetCF, targetCol = getNearestSafeColliderCFrame(savedPos)
            local colName = targetCol and targetCol.Name or "Collider"

            if cb then cb("👁 Monster! Masuk tengah " .. colName .. " (1-Layer)...") end
            rootPart.Anchored = false
            isHiding = true
            setTargetColliderPassable(targetCol, true)

            teleportTween(fleeTargetCF, math.max(Config.PickupTweenSpeed, Config.UGRiseSpeed * 1.5), true)
            if rootPart then
                rootPart.CFrame   = fleeTargetCF
                rootPart.Anchored = true
            end
            local hidePlat = makePlatform(rootPart.Position)

            while isThreatened() and not abortTeleport and isPickingUp do
                if hidePlat and hidePlat.Parent then
                    hidePlat.CFrame = CFrame.new(rootPart.Position.X, rootPart.Position.Y - 3, rootPart.Position.Z)
                end
                task.wait(0.2)
            end

            local safeWait = 0
            while safeWait < Config.MonsterSafeDelay and not abortTeleport and isPickingUp do
                if isThreatened() then safeWait = 0 end
                task.wait(0.2)
                safeWait = safeWait + 0.2
            end

            if hidePlat and hidePlat.Parent then hidePlat:Destroy() end
            rootPart.Anchored = false

            if abortTeleport or not isPickingUp then
                setTargetColliderPassable(nil, false)
                isHiding = false
                return false
            end

            if cb then cb("↩ Aman! Lanjut ambil " .. targetName .. "...") end
            teleportTween(CFrame.new(savedPos), Config.PickupTweenSpeed, true)
            setTargetColliderPassable(nil, false)
            isHiding = false

            if Config.PickupMode == "Tween" and Config.PathfindMode then
                task.spawn(function() pathfindTween(targetItemCF) end)
                local w = 0
                while not isPathfinding and w < 1 do task.wait(0.05); w = w + 0.05 end
                w = 0
                while isPathfinding and w < 30 and not abortTeleport do task.wait(0.1); w = w + 0.1 end
                task.wait(0.2)
            else
                doTeleport(targetItemCF, Config.PickupMode, Config.PickupTweenSpeed)
            end
            return true
        end

        while #targets > 0 do
            if abortTeleport or not isPickingUp then break end

            sortByNearest()
            local item = table.remove(targets, 1)

            if item and item.Parent and rootPart then
                local itemCF = item:GetPivot()
                local cf     = CFrame.new(itemCF.Position.X, itemCF.Position.Y + 3, itemCF.Position.Z)

                if Config.PickupMode == "Tween" and Config.PathfindMode then
                    doTeleport(cf, Config.PickupMode, Config.PickupTweenSpeed)
                    local w = 0
                    while not isPathfinding and w < 1 do task.wait(0.05); w = w + 0.05 end
                    w = 0
                    while isPathfinding and w < 30 do task.wait(0.1); w = w + 0.1 end
                    task.wait(0.3)
                else
                    doTeleport(cf, Config.PickupMode, Config.PickupTweenSpeed)
                    if isThreatened() and not abortTeleport and isPickingUp then
                        hideInNearestColliderAndReturn(cf)
                    end
                end

                rootPart.Anchored = true
                task.wait(0.1)
                local plat = makePlatform(rootPart.Position)

                local timeout = 30
                while item.Parent and timeout > 0 and not abortTeleport do
                    if isThreatened() then
                        if plat and plat.Parent then plat:Destroy() end
                        if not hideInNearestColliderAndReturn(cf) then
                            rootPart.Anchored = false
                            break
                        end
                        rootPart.Anchored = true
                        plat    = makePlatform(rootPart.Position)
                        timeout = 30
                    end

                    local pp   = item:FindFirstChild("Prompt")
                    local prox = pp and pp:FindFirstChild("ProximityPrompt")
                    if prox and prox.Enabled then interactWithPrompt(prox) end

                    task.wait(0.1)
                    timeout = timeout - 0.1
                end

                if plat and plat.Parent then plat:Destroy() end
                rootPart.Anchored = false
                task.wait(0.2)
            end
        end

        if cb then cb("Selesai ambil " .. targetName .. "!") end
        isPickingUp = false
    end)
end

