ddList.BackgroundColor3   = Color3.fromRGB(18, 18, 30)
ddList.BorderSizePixel    = 0
ddList.ScrollBarThickness = 3
ddList.Visible            = false
ddList.ZIndex             = 20
Instance.new("UICorner", ddList).CornerRadius = UDim.new(0, 6)
Instance.new("UIStroke", ddList).Color        = Color3.fromRGB(55, 55, 85)
local ddLayout = Instance.new("UIListLayout", ddList)
ddLayout.SortOrder = Enum.SortOrder.LayoutOrder

local selectedItem, ddOpen = nil, false
local function closeDd() ddOpen = false; ddArrow.Text = "▼"; ddList.Visible = false end

local function refreshDd()
    for _, c in ipairs(ddList:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
    local items, n = getItemsInRoom(), 0
    for name, data in pairs(items) do
        local b = Instance.new("TextButton", ddList)
        b.Size                   = UDim2.new(1, 0, 0, 28)
        b.BackgroundTransparency = 1
        b.TextColor3             = Color3.fromRGB(200, 200, 230)
        b.Font                   = Enum.Font.Gotham
        b.TextSize               = 12
        b.Text                   = "  " .. name .. " (" .. data.count .. ")"
        b.TextXAlignment         = Enum.TextXAlignment.Left
        b.ZIndex                 = 21
        b.LayoutOrder            = n
        b.MouseEnter:Connect(function() b.BackgroundTransparency = 0; b.BackgroundColor3 = Color3.fromRGB(35, 35, 60) end)
        b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
        b.MouseButton1Click:Connect(function()
            selectedItem = name
            ddLabel.Text = name .. " (" .. data.count .. ")"
            closeDd()
        end)
        n = n + 1
    end
    if n == 0 then
        local l = Instance.new("TextLabel", ddList)
        l.Size                   = UDim2.new(1, 0, 0, 28)
        l.BackgroundTransparency = 1
        l.TextColor3             = Color3.fromRGB(110, 110, 140)
        l.Font                   = Enum.Font.Gotham
        l.TextSize               = 12
        l.Text                   = "  Tidak ada item di room"
        l.ZIndex                 = 21
        n = 1
    end
    local h     = math.min(n * 28, 120)
    local dfAbs = ddFrame.AbsolutePosition
    local mfAbs = mainFrame.AbsolutePosition
    local dfSz  = ddFrame.AbsoluteSize
    ddList.CanvasSize = UDim2.new(0, 0, 0, n * 28)
    ddList.Position   = UDim2.new(0, dfAbs.X - mfAbs.X, 0, math.min(dfAbs.Y - mfAbs.Y + dfSz.Y + 2, mainFrame.AbsoluteSize.Y - h - 8))
    ddList.Size       = UDim2.new(0, dfSz.X, 0, h)
end

local ddBtn = Instance.new("TextButton", ddFrame)
ddBtn.Size                   = UDim2.new(1, 0, 1, 0)
ddBtn.BackgroundTransparency = 1
ddBtn.Text                   = ""
ddBtn.ZIndex                 = 5
