end

local function getItemsInRoom()
    local items  = {}
    local map    = getMap()
    local folder = map and map:FindFirstChild("Items")
    if not folder then return items end
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Model") then
            if not items[item.Name] then
                items[item.Name] = { count = 0, instances = {} }
            end
            items[item.Name].count = items[item.Name].count + 1
            table.insert(items[item.Name].instances, item)
        end
    end
    return items
end

-- Mencari titik berdiri di luar collider meja/rak (jarak ~4 stud dari item) agar ambil item tidak menembus collider
local function getColliderFreePickupSpot(itemPos)
    local allCols = getNoClipColliders()
    local standPos = Vector3.new(itemPos.X, itemPos.Y + 3, itemPos.Z)
    if isPointFreeOfAllColliders(standPos, allCols, 1.4) then
        return CFrame.new(standPos), nil
    end

    -- Cari collider meja/rak tempat item tersebut berada
    local enclosingCol = nil
    for _, col in ipairs(allCols) do
        if col and col.Parent and isPointInExpandedPart(standPos, col, 1.5, 2.5) then
            enclosingCol = col
            break
        end
    end

    -- Coba 8 arah di sekitar item (jarak 3.5 s/d 6 stud) yang bebas dari semua collider
    local dirs = {
        Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
        Vector3.new(0.707, 0, 0.707), Vector3.new(-0.707, 0, 0.707),
        Vector3.new(0.707, 0, -0.707), Vector3.new(-0.707, 0, -0.707),
    }
    for _, radius in ipairs({ 3.8, 5.0, 6.2 }) do
        for _, d in ipairs(dirs) do
            local testPt = Vector3.new(itemPos.X, rootPart and rootPart.Position.Y or (itemPos.Y + 3), itemPos.Z) + (d * radius)
            if isPointFreeOfAllColliders(testPt, allCols, 1.4) then
                return CFrame.new(testPt), nil
            end
        end
    end

    return CFrame.new(standPos), enclosingCol
end

local function pickupSelectedItem(targetName, cb)
    if isPickingUp then return end
    isPickingUp             = true
    abortTeleport           = false
    Config.PickupMode       = Config.TeleportMode
    Config.PickupTweenSpeed = Config.TweenSpeed

    task.spawn(function()
        local function makePlatform(atPos)
            local plat = Instance.new("Part")
            plat.Size         = Vector3.new(10, 1, 10)
            plat.Anchored     = true
            plat.CanCollide   = true
            plat.Transparency = 1
            plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
            plat.Parent       = Workspace
            return plat
        end

        local function getRemainingTargets()
            local list   = {}
            local map    = getMap()
            local folder = map and map:FindFirstChild("Items")
            if not folder then return list end
            for _, item in ipairs(folder:GetChildren()) do
                if item:IsA("Model") and item.Name == targetName and item.Parent then
                    table.insert(list, item)
                end
            end
            if rootPart then
                table.sort(list, function(a, b)
                    return (rootPart.Position - a:GetPivot().Position).Magnitude
                         < (rootPart.Position - b:GetPivot().Position).Magnitude
                end)
            end
            return list
        end

        local initialList = getRemainingTargets()
        if #initialList == 0 then
            if cb then cb("Item '" .. targetName .. "' tidak ada di room!") end
            isPickingUp = false
            return
        end

        local skipCounts = {}

        -- Loop utama yang otomatis melanjutkan task sampai semua item terambil
        while isPickingUp and not abortTeleport and _G.TeleportGUI_Loaded do
            local remaining = getRemainingTargets()
            -- Filter item yang gagal diambil lebih dari 4 kali agar tidak infinite loop
            local validTargets = {}
            for _, it in ipairs(remaining) do
                if (skipCounts[it] or 0) < 4 then
                    table.insert(validTargets, it)
                end
            end

            if #validTargets == 0 then
                break
            end

            -- 1. Jika sebelum jalan sudah ada ancaman monster, sembunyi dulu ke tengah collider terdekat
            if isThreatened() then
                performColliderHide(function(msg) if cb then cb(msg) end end)
                if abortTeleport or not isPickingUp then break end
            end

            -- Ambil ulang target terdekat dari posisi keluar collider saat ini
            remaining = getRemainingTargets()
            local item = nil
            for _, it in ipairs(remaining) do
                if (skipCounts[it] or 0) < 4 then
                    item = it
                    break
                end
            end
            if not item or not item.Parent or not rootPart then
                break
            end

            if cb then cb("🎯 Mengambil " .. targetName .. " (Sisa: " .. #remaining .. ")...") end

            local itemPos = item:GetPivot().Position
            local pickupCF, itemEnclosingCol = getColliderFreePickupSpot(itemPos)
            localdirectCF = CFrame.new(itemPos.X, itemPos.Y + 3, itemPos.Z)

            -- 2. Bergerak menuju item tanpa menembus 2 collider
            local moveCancelled = false
            if Config.PickupMode == "Tween" then
                if Config.UndergroundTeleport then
                    local downY = rootPart.Position.Y - Config.UGDepth
                    moveCancelled = teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed)
                    if not moveCancelled and not abortTeleport then
                        moveCancelled = teleportTween(CFrame.new(pickupCF.X, downY, pickupCF.Z), Config.PickupTweenSpeed)
                    end
                    if not moveCancelled and not abortTeleport then
                        moveCancelled = teleportTween(CFrame.new(pickupCF.X, pickupCF.Y, pickupCF.Z), Config.UGRiseSpeed)
                    end
                else
                    local _, wasCancelled = smartTweenTo(pickupCF, Config.PickupTweenSpeed, false, itemEnclosingCol)
                    moveCancelled = wasCancelled
                end
            else
                teleportInstant(pickupCF)
            end

            if abortTeleport or not isPickingUp then break end

            -- 3. Jika perjalanan ke item terpotong karena monster muncul di tengah jalan:
            --    Sembunyi ke tengah kotak merah terdekat, lalu ULANGI loop untuk lanjut ambil sisa item!
            if moveCancelled or isThreatened() then
                performColliderHide(function(msg) if cb then cb(msg) end end)
                continue
            end

            -- 4. Cek apakah karakter benar-benar sudah dekat dengan item (tidak terkena rubberband server)
            local distToItem = (rootPart.Position - itemPos).Magnitude
            if distToItem > 14 then
                skipCounts[item] = (skipCounts[item] or 0) + 1
                task.wait(0.35)
                continue
            end

            -- 5. Interaksi ProximityPrompt (Maksimal 2.5 detik per percobaan, bukan 30 detik!)
            rootPart.Anchored = true
            local plat = makePlatform(rootPart.Position)
            local waitTicks = 0
            local monsterInterrupted = false

            while item.Parent and waitTicks < 25 and not abortTeleport and isPickingUp do
                if isThreatened() then
                    monsterInterrupted = true
                    break
                end

                -- Jika dari luar collider meja belum terambil setelah 1 detik, geser sedikit mendekati item
                if waitTicks == 10 and item.Parent and rootPart then
                    rootPart.Anchored = false
                    setTargetColliderPassable(itemEnclosingCol, true)
                    teleportTween(localdirectCF, Config.PickupTweenSpeed, false)
                    if rootPart then rootPart.Anchored = true end
                end

                local pp   = item:FindFirstChild("Prompt")
                local prox = pp and pp:FindFirstChild("ProximityPrompt")
                if prox and prox.Enabled then
                    interactWithPrompt(prox)
                end

                task.wait(0.1)
                waitTicks = waitTicks + 1
            end

            if plat and plat.Parent then plat:Destroy() end
            if rootPart then rootPart.Anchored = false end
            setTargetColliderPassable(nil, false)

            if monsterInterrupted then
                performColliderHide(function(msg) if cb then cb(msg) end end)
                continue
            end

            if item.Parent then
                skipCounts[item] = (skipCounts[item] or 0) + 1
            end

            task.wait(0.2)
        end

        if rootPart then rootPart.Anchored = false end
        setTargetColliderPassable(nil, false)
        if cb then cb("✔ Selesai ambil semua " .. targetName .. "!") end
        isPickingUp = false
    end)
end

