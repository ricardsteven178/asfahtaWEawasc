-- SECTION 6: TELEPORT, ZERO-COLLIDER ROUTING & MONSTER HIDE ENGINE
-- ==============================================================================
local pathfindTween
local performColliderHide

local function teleportInstant(cf)
    if not rootPart then return end
    local g = Workspace.Gravity
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity = Vector3.zero
    character:PivotTo(cf)
    Workspace.Gravity = g
end

local function teleportTween(cf, speed, ignoreThreat)
    if not rootPart then return false end
    local g = Workspace.Gravity
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity = Vector3.zero

    local spd  = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
    local dist = (rootPart.Position - cf.Position).Magnitude
    local dur  = math.max(dist / (spd * (speed or 1.25)), 0.001)

    local tw = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
    activeTween = tw
    tw:Play()

    local done, cancelled = false, false
    tw.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed then done = true end
    end)

    while not done do
        if not ignoreThreat and (abortTeleport or isThreatened()) then
            tw:Cancel()
            cancelled = true
            break
        end
        task.wait(0.01)
    end

    if not cancelled and not isHiding and rootPart then
        -- Hanya snap ke cf jika tidak terkena rubberband jauh dari server
        if (rootPart.Position - cf.Position).Magnitude <= 8 then
            rootPart.CFrame = cf
        end
    end

    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end
    if activeTween == tw then activeTween = nil end
    Workspace.Gravity = g
    return cancelled
end

-- Menghitung jalur Tween yang memutari NoClip_Collider & CylinderCollider agar TIDAK menembus >1 block
local function computeZeroColliderRoute(startPos, goalPos, allowedEndCol)
    local allCols = getNoClipColliders()
    local directTouched = getCollidersTouchedOnSegment(startPos, goalPos, allCols, allowedEndCol)
    if #directTouched == 0 then
        return { goalPos }
    end

    -- Coba 1-titik belok di ruang terbuka (cepat & tanpa lag)
    local dir = goalPos - startPos
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    if flatDir.Magnitude > 0.5 then
        local uDir = flatDir.Unit
        local perp = Vector3.new(-uDir.Z, 0, uDir.X)
        for _, frac in ipairs({ 0.5, 0.3, 0.7 }) do
            local basePt = startPos:Lerp(goalPos, frac)
            for _, distOff in ipairs({ 5, 9, 14, 20 }) do
                for _, side in ipairs({ 1, -1 }) do
                    local midPt = Vector3.new(basePt.X, startPos.Y, basePt.Z) + (perp * (distOff * side))
                    if isPointFreeOfAllColliders(midPt, allCols, 1.6) then
                        local t1 = getCollidersTouchedOnSegment(startPos, midPt, allCols, nil)
                        if #t1 == 0 then
                            local t2 = getCollidersTouchedOnSegment(midPt, goalPos, allCols, allowedEndCol)
                            if #t2 == 0 then
                                return { midPt, goalPos }
                            end
                        end
                    end
                end
            end
        end
    end

    -- Jika terhalang tembok ruangan, gunakan NavMesh dengan semua collider dibuat solid sementara
    for _, col in ipairs(allCols) do
        if col and col:IsA("BasePart") then col.CanCollide = true end
    end

    local route = nil
    for _, params in ipairs({ AGENT_PARAMS, AGENT_PARAMS_FALLBACK, AGENT_PARAMS_LASTRESORT }) do
        local path = PathfindingService:CreatePath(params)
        local ok = pcall(function() path:ComputeAsync(startPos, goalPos) end)
        if ok and path.Status == Enum.PathStatus.Success then
            local wps = path:GetWaypoints()
            if #wps > 0 then
                route = {}
                for i = 2, #wps do
                    table.insert(route, Vector3.new(wps[i].Position.X, startPos.Y, wps[i].Position.Z))
                end
                table.insert(route, goalPos)
                break
            end
        end
    end

    if Config.NoClip then
        applyNoClipState()
    else
        for _, col in ipairs(allCols) do
            if col and col:IsA("BasePart") then col.CanCollide = true end
        end
    end

    if route and #route > 0 then
        -- String-pulling: gabungkan titik-titik NavMesh yang lurus dan bebas collider agar gerakan mulus
        local simplified = {}
        local curr = startPos
        local idx = 1
        while idx <= #route do
            local furthest = idx
            for j = #route, idx + 1, -1 do
                local allowCol = (j == #route) and allowedEndCol or nil
                local touched = getCollidersTouchedOnSegment(curr, route[j], allCols, allowCol)
                if #touched == 0 then
                    furthest = j
                    break
                end
            end
            table.insert(simplified, route[furthest])
            curr = route[furthest]
            idx  = furthest + 1
        end
        return simplified
    end

    return { goalPos }
end

-- Menjalankan Tween melewati jalur bebas collider
local function smartTweenTo(targetCF, speed, ignoreThreat, allowedEndCol)
    if not rootPart then return false, true end
    local waypoints = computeZeroColliderRoute(rootPart.Position, targetCF.Position, allowedEndCol)
    for _, wpPos in ipairs(waypoints) do
        if abortTeleport then return false, true end
        local cancelled = teleportTween(CFrame.new(wpPos), speed, ignoreThreat)
        if cancelled then
            return false, true
        end
    end
    return true, false
end

-- Fungsi Terpusat: Masuk ke tengah NoClip_Collider / CylinderCollider terdekat (1-Layer) & keluar dengan aman
performColliderHide = function(statusFn)
    if not rootPart then return false end
    local startPos = rootPart.Position
    local hideRoute = findBestHideColliderRoute(startPos)
    local targetCol = hideRoute.targetCol
    local colName   = targetCol and targetCol.Name or "Collider"

    if statusFn then statusFn("👁 Monster! Masuk tengah " .. colName .. " (1-Layer)...", Color3.fromRGB(255, 60, 60)) end

    rootPart.Anchored = false
    isHiding = true
    setTargetColliderPassable(targetCol, true)

    -- Jalankan Tween menuju titik tengah kotak merah (mengikuti waypoint 1-layer)
    local hideSpeed = math.max(Config.TweenSpeed, Config.UGRiseSpeed * 1.5)
    for _, wpPos in ipairs(hideRoute.waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then break end
        teleportTween(CFrame.new(wpPos), hideSpeed, true)
    end

    local finalHidePos = hideRoute.waypoints[#hideRoute.waypoints] or startPos
    if rootPart then
        rootPart.CFrame   = CFrame.new(finalHidePos)
        rootPart.Anchored = true
    end

    -- Buat platform penyangga selama di tengah collider
    local hidePlat = Instance.new("Part")
    hidePlat.Size         = Vector3.new(10, 1, 10)
    hidePlat.Anchored     = true
    hidePlat.CanCollide   = true
    hidePlat.Transparency = 1
    hidePlat.CFrame       = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
    hidePlat.Parent       = Workspace

    if statusFn then statusFn("🛡 Di tengah " .. colName .. ", tunggu monster pergi...", Color3.fromRGB(220, 80, 80)) end
    while isThreatened() and not abortTeleport and _G.TeleportGUI_Loaded do
        if hidePlat and hidePlat.Parent and rootPart then
            hidePlat.CFrame = CFrame.new(rootPart.Position.X, rootPart.Position.Y - 3, rootPart.Position.Z)
        end
        task.wait(0.2)
    end

    if statusFn then statusFn("⏳ Tunggu " .. Config.MonsterSafeDelay .. "s sebelum keluar collider...", Color3.fromRGB(180, 180, 60)) end
    local safeWait = 0
    while safeWait < Config.MonsterSafeDelay and not abortTeleport and _G.TeleportGUI_Loaded do
        if isThreatened() then
            if statusFn then statusFn("🛡 Monster kembali! Tetap di tengah " .. colName .. "...", Color3.fromRGB(220, 80, 80)) end
            safeWait = 0
        end
        task.wait(0.2)
        safeWait = safeWait + 0.2
    end

    if hidePlat and hidePlat.Parent then hidePlat:Destroy() end
    if rootPart then rootPart.Anchored = false end

    -- Matikan flag isHiding SEBELUM keluar agar CFrame ter-update normal
    isHiding = false

    if abortTeleport or not _G.TeleportGUI_Loaded then
        setTargetColliderPassable(nil, false)
        return false
    end

    -- Keluar ke titik ruang terbuka (safeOutsidePos) agar tidak menembus 2 collider beruntun
    if statusFn then statusFn("↩ Aman! Keluar dari " .. colName .. "...", Color3.fromRGB(100, 220, 150)) end
    if hideRoute.safeOutsidePos then
        teleportTween(CFrame.new(hideRoute.safeOutsidePos), Config.TweenSpeed, true)
    end

    setTargetColliderPassable(nil, false)

    -- Jeda singkat di ruang terbuka agar server me-reset hitungan 1-layer collider
    task.wait(0.4)
    return true
end

local function refreshColliderCache()
    cachedColliders = getNoClipColliders()
    for _, col in ipairs(cachedColliders) do
        if col and col:IsA("BasePart") then col.CanQuery = true end
    end
end

local function clearPathVisuals()
    for _, v in ipairs(pathVisuals) do pcall(function() v:Destroy() end) end
    pathVisuals = {}
end

local function drawWaypoint(pos, color)
    local p = Instance.new("Part")
    p.Size       = Vector3.new(0.35, 0.35, 0.35)
    p.Shape      = Enum.PartType.Ball
    p.Anchored   = true
    p.CanCollide = false
    p.Material   = Enum.Material.Neon
    p.Color      = color or Color3.fromRGB(255, 200, 0)
    p.CFrame     = CFrame.new(pos)
    p.Parent     = Workspace
    table.insert(pathVisuals, p)
end

pathfindTween = function(targetCF, statusCb, _attempt)
    if isPathfinding or not rootPart then return end
    isPathfinding = true
    abortTeleport = false
    clearPathVisuals()
    refreshColliderCache()

    local function setStatus(txt, col)
        if pfStatusRef then
            pfStatusRef.Text       = txt
            pfStatusRef.TextColor3 = col or Color3.fromRGB(160, 120, 255)
        end
        if statusCb then statusCb(txt) end
    end

    local comboMode     = Config.PathfindMode and Config.UndergroundTeleport
    local computeTarget = targetCF.Position
    local attempt       = _attempt or 0
    local currentParams = (attempt == 2) and AGENT_PARAMS_LASTRESORT
                       or (attempt == 1) and AGENT_PARAMS_FALLBACK
                       or AGENT_PARAMS

    for _, col in ipairs(cachedColliders) do
        if col and col:IsA("BasePart") then col.CanCollide = true end
    end

    local path = PathfindingService:CreatePath(currentParams)
    local ok   = pcall(function() path:ComputeAsync(rootPart.Position, computeTarget) end)

    if Config.NoClip then
        applyNoClipState()
    else
        for _, col in ipairs(cachedColliders) do
            if col and col:IsA("BasePart") then col.CanCollide = true end
        end
    end

    if not ok or path.Status ~= Enum.PathStatus.Success then
        if attempt < 2 then
            setStatus("🔄 Retry path (" .. tostring(attempt) .. ")...", Color3.fromRGB(220, 180, 60))
            isPathfinding = false
            task.wait(0.1)
            pathfindTween(targetCF, statusCb, attempt + 1)
            return
        else
            setStatus("⚠ Path gagal, gunakan Zero-Collider Route", Color3.fromRGB(220, 100, 60))
            if not abortTeleport then
                if comboMode then
                    local target = targetCF.Position
                    local downY  = rootPart.Position.Y - Config.UGDepth
                    teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed)
                    if not abortTeleport then teleportTween(CFrame.new(target.X, downY, target.Z), Config.TweenSpeed) end
                    if not abortTeleport then teleportTween(CFrame.new(target.X, target.Y + 4, target.Z), Config.UGRiseSpeed) end
                else
                    smartTweenTo(targetCF, Config.TweenSpeed, false, nil)
                end
            end
            task.delay(2, function() if pfStatusRef then pfStatusRef.Text = "" end end)
            isPathfinding = false
            return
        end
    end

    local waypoints = path:GetWaypoints()
    if #waypoints == 0 then
        if not abortTeleport then smartTweenTo(targetCF, Config.TweenSpeed, false, nil) end
        isPathfinding = false
        return
    end

    local attemptLabel = (attempt == 1) and " [fallback]" or (attempt == 2) and " [last resort]" or ""
    local modeLabel    = comboMode and " [COMBO]" or ""
    setStatus("🔵 Pathfinding... (" .. #waypoints .. " titik)" .. attemptLabel .. modeLabel, Color3.fromRGB(160, 120, 255))

    local g = Workspace.Gravity
    Workspace.Gravity = 0

    for i, wp in ipairs(waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then
            setStatus("🛑 Dibatalkan", Color3.fromRGB(220, 80, 80))
            task.delay(1.5, function() if pfStatusRef then pfStatusRef.Text = "" end end)
            break
        end

        local wpY  = comboMode and (wp.Position.Y - Config.UGDepth) or (wp.Position.Y + (Config.UndergroundTeleport and -Config.UGDepth or 0.5))
        local wpCF = CFrame.new(wp.Position.X, wpY, wp.Position.Z)

        drawWaypoint(wp.Position, i == #waypoints and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 200, 0))

        local isInterrupted = teleportTween(wpCF, Config.TweenSpeed)
        if isInterrupted then
            if isThreatened() then
                Workspace.Gravity = g
                local resumed = performColliderHide(setStatus)
                isPathfinding = false
                if resumed and not abortTeleport and _G.TeleportGUI_Loaded then
                    pathfindTween(targetCF, statusCb, 0)
                end
                return
            end
            if abortTeleport then break end
        end
    end

    Workspace.Gravity = g
    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end

    if not abortTeleport and rootPart then
        local fp = targetCF.Position
        if comboMode then
            setStatus("⬆ Naik ke target...", Color3.fromRGB(120, 255, 160))
            teleportTween(CFrame.new(fp.X, fp.Y + 4, fp.Z), Config.UGRiseSpeed)
        elseif Config.UndergroundTeleport then
            rootPart.CFrame = CFrame.new(fp.X, fp.Y - Config.UGDepth, fp.Z)
        end
        setStatus("✔ Pathfind selesai!" .. (comboMode and " [COMBO]" or ""), Color3.fromRGB(100, 220, 150))
        task.delay(2, function()
            if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween dipilih" end
            clearPathVisuals()
        end)
    end

    abortTeleport = false
    isPathfinding = false
end

local function doTeleport(cf, mode, speed)
    if mode == "Tween" and Config.PathfindMode then
        task.spawn(function() pathfindTween(cf) end)
        return
    end

    if Config.UndergroundTeleport and mode == "Tween" then
        if not rootPart then return end
        local target = cf.Position
        local downY  = rootPart.Position.Y - Config.UGDepth
        teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), Config.UGRiseSpeed)
        if abortTeleport then return end
        teleportTween(CFrame.new(target.X, downY, target.Z), speed)
        if abortTeleport then return end
        teleportTween(CFrame.new(target.X, target.Y + 4, target.Z), Config.UGRiseSpeed)
        return
    end

    local finalCF = Config.UndergroundTeleport and CFrame.new(cf.Position.X, cf.Position.Y - Config.UGDepth, cf.Position.Z) or cf
    if mode == "Tween" then
        smartTweenTo(finalCF, speed, false, nil)
    else
        teleportInstant(finalCF)
    end
end

