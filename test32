local function isThreatened()
    local pGui        = player:FindFirstChild("PlayerGui")
    local screenGui   = pGui and pGui:FindFirstChild("ScreenGui")
    local monsterIcon = screenGui and screenGui:FindFirstChild("MonsterIcon")
    if monsterIcon and monsterIcon.Visible and monsterIcon.ImageTransparency < 0.99 then
        return true
    end

    if not rootPart then return false end
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, monster in pairs(monstersFolder:GetChildren()) do
            if monster:IsA("Model") then
                local chasing = monster:FindFirstChild("ChasingValue")
                if chasing and chasing.Value == character then
                    return true
                end
                local primaryPart = monster.PrimaryPart or monster:FindFirstChildWhichIsA("BasePart")
                if primaryPart and (primaryPart.Position - rootPart.Position).Magnitude <= Config.MonsterDangerRadius then
                    return true
                end
            end
        end
    end
    return false
end

-- Mengecek apakah titik pt berada di dalam BasePart + margin ukuran tubuh karakter
local function isPointInExpandedPart(pt, part, marginXZ, marginY)
    if not part or not part:IsA("BasePart") then return false end
    marginXZ = marginXZ or 0
    marginY  = marginY or marginXZ
    local rel = part.CFrame:PointToObjectSpace(pt)
    return math.abs(rel.X) <= (part.Size.X * 0.5 + marginXZ)
       and math.abs(rel.Y) <= (part.Size.Y * 0.5 + marginY)
       and math.abs(rel.Z) <= (part.Size.Z * 0.5 + marginXZ)
end

-- Menghitung daftar collider yang tersentuh oleh tubuh karakter di sepanjang garis posA -> posB
local function getCollidersTouchedOnSegment(posA, posB, allCols, ignoredCol)
    local touched, seen = {}, {}
    local dir  = posB - posA
    local dist = dir.Magnitude

    local function checkPoint(pt, mXZ, mY)
        for _, col in ipairs(allCols) do
            if col and col.Parent and col ~= ignoredCol and not seen[col] then
                if isPointInExpandedPart(pt, col, mXZ, mY) then
                    seen[col] = true
                    table.insert(touched, col)
                end
            end
        end
    end

    checkPoint(posA, 1.4, 1.8)
    checkPoint(posB, 1.4, 1.8)
    if dist < 0.2 then return touched end

    -- Sampling rapat setiap 0.6 stud dengan margin lebar badan karakter (1.65 stud)
    local steps = math.max(math.ceil(dist / 0.6), 2)
    for i = 1, steps - 1 do
        local pt = posA:Lerp(posB, i / steps)
        checkPoint(pt, 1.65, 2.0)
    end

    -- Tambahan Raycast fisik dua arah untuk memastikan tidak ada celah tipis yang terlewat
    local filter = {}
    for _, col in ipairs(allCols) do
        if col and col.Parent and col ~= ignoredCol then
            col.CanQuery = true
            table.insert(filter, col)
        end
    end
    if #filter > 0 then
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Include
        rp.FilterDescendantsInstances = filter
        local hit1 = Workspace:Raycast(posA, dir, rp)
        if hit1 and hit1.Instance and not seen[hit1.Instance] then
            seen[hit1.Instance] = true
            table.insert(touched, hit1.Instance)
        end
        local hit2 = Workspace:Raycast(posB, -dir, rp)
        if hit2 and hit2.Instance and not seen[hit2.Instance] then
            seen[hit2.Instance] = true
            table.insert(touched, hit2.Instance)
        end
    end

    return touched
end

-- Mengecek apakah sebuah titik di ruang terbuka benar-benar bebas dari SEMUA collider
local function isPointFreeOfAllColliders(pt, allCols, marginXZ)
    marginXZ = marginXZ or 1.8
    for _, col in ipairs(allCols) do
        if col and col.Parent and isPointInExpandedPart(pt, col, marginXZ, 2.0) then
            return false
        end
    end
    return true
end

-- Mencari titik aman di ruang terbuka tepat di luar permukaan collider
local function getSafeOutsidePointForCollider(fromPos, centerPos, targetCol, allCols)
    local dir = fromPos - centerPos
    dir = Vector3.new(dir.X, 0, dir.Z)
    local baseDir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(1, 0, 0)
    local maxRadius = math.max(targetCol.Size.X, targetCol.Size.Z) * 0.5 + 3.2

    -- Coba ke arah datangnya player terlebih dahulu, lalu 8 penjuru mata angin di sekitar collider
    local dirs = {
        baseDir,
        -baseDir,
        Vector3.new(-baseDir.Z, 0, baseDir.X),
        Vector3.new(baseDir.Z, 0, -baseDir.X),
        (baseDir + Vector3.new(-baseDir.Z, 0, baseDir.X)).Unit,
        (baseDir + Vector3.new(baseDir.Z, 0, -baseDir.X)).Unit,
    }

    for _, d in ipairs(dirs) do
        for extra = 0, 6, 2 do
            local candidatePt = centerPos + d * (maxRadius + extra)
            if isPointFreeOfAllColliders(candidatePt, allCols, 1.6) then
                local touched = getCollidersTouchedOnSegment(centerPos, candidatePt, allCols, targetCol)
                if #touched == 0 then
                    return candidatePt
                end
            end
        end
    end
    return fromPos
end

-- Mencari rute 1-Layer ke titik tengah NoClip_Collider / CylinderCollider terdekat
-- Dijamin 0 collider lain tersentuh di perjalanan, dan hanya masuk ke 1 collider tujuan
local function findBestHideColliderRoute(startPos)
    local hideableCols = getHideableColliders()
    local allCols      = getNoClipColliders()
    if #hideableCols == 0 then
        return { waypoints = { startPos }, targetCol = nil, safeOutsidePos = startPos }
    end

    -- 1. Cek apakah player saat ini SUDAH berada di dalam salah satu hideable collider yang bersih
    for _, col in ipairs(hideableCols) do
        if col and col.Parent and isPointInExpandedPart(startPos, col, 0.5, 1.5) then
            local minY    = col.Position.Y - (col.Size.Y * 0.5) + 2.5
            local maxY    = col.Position.Y + (col.Size.Y * 0.5) - 0.5
            local targetY = (minY <= maxY) and math.clamp(startPos.Y, minY, maxY) or startPos.Y
            local center  = Vector3.new(col.Position.X, targetY, col.Position.Z)
            local touched = getCollidersTouchedOnSegment(startPos, center, allCols, col)
            if #touched == 0 then
                local outPt = getSafeOutsidePointForCollider(startPos, center, col, allCols)
                return { waypoints = { center }, targetCol = col, safeOutsidePos = outPt }
            end
        end
    end

    local candidates = {}
    for _, col in ipairs(hideableCols) do
        if col and col.Parent then
            local minY    = col.Position.Y - (col.Size.Y * 0.5) + 2.5
            local maxY    = col.Position.Y + (col.Size.Y * 0.5) - 0.5
            local targetY = (minY <= maxY) and math.clamp(startPos.Y, minY, maxY) or startPos.Y
            local center  = Vector3.new(col.Position.X, targetY, col.Position.Z)

            -- Pastikan titik tengah collider ini TIDAK bertumpukan (overlap) dengan collider ke-2
            local centerOverlapsOther = false
            for _, oc in ipairs(allCols) do
                if oc ~= col and oc and oc.Parent and isPointInExpandedPart(center, oc, 1.8, 2.0) then
                    centerOverlapsOther = true
                    break
                end
            end

            if not centerOverlapsOther then
                table.insert(candidates, {
                    col       = col,
                    centerPos = center,
                    dist      = (center - startPos).Magnitude,
                })
            end
        end
    end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)

    -- 2. Prioritas Utama: Garis lurus murni 1-Layer (0 collider lain tersentuh)
    for _, cand in ipairs(candidates) do
        local touched = getCollidersTouchedOnSegment(startPos, cand.centerPos, allCols, cand.col)
        if #touched == 0 then
            local outPt = getSafeOutsidePointForCollider(startPos, cand.centerPos, cand.col, allCols)
            return { waypoints = { cand.centerPos }, targetCol = cand.col, safeOutsidePos = outPt }
        end
    end

    -- 3. Prioritas Kedua: 1-Titik Belok (Open-Air Corner Bypass) untuk menghindari collider penghalang
    for _, cand in ipairs(candidates) do
        local dir = cand.centerPos - startPos
        local flatDir = Vector3.new(dir.X, 0, dir.Z)
        if flatDir.Magnitude > 0.5 then
            local uDir = flatDir.Unit
            local perp = Vector3.new(-uDir.Z, 0, uDir.X)
            local midBase = startPos:Lerp(cand.centerPos, 0.5)

            for _, distOff in ipairs({ 5, 9, 14, 19 }) do
                for _, side in ipairs({ 1, -1 }) do
                    local midPt = Vector3.new(midBase.X, startPos.Y, midBase.Z) + (perp * (distOff * side))
                    if isPointFreeOfAllColliders(midPt, allCols, 1.7) then
                        local t1 = getCollidersTouchedOnSegment(startPos, midPt, allCols, nil)
                        if #t1 == 0 then
                            local t2 = getCollidersTouchedOnSegment(midPt, cand.centerPos, allCols, cand.col)
                            if #t2 == 0 then
                                local outPt = getSafeOutsidePointForCollider(midPt, cand.centerPos, cand.col, allCols)
                                return { waypoints = { midPt, cand.centerPos }, targetCol = cand.col, safeOutsidePos = outPt }
                            end
                        end
                    end
                end
            end
        end
    end

    -- Fallback aman jika semua terhalang tembok berlapis
    if #candidates > 0 then
        local best = candidates[1]
        local outPt = getSafeOutsidePointForCollider(startPos, best.centerPos, best.col, allCols)
        return { waypoints = { best.centerPos }, targetCol = best.col, safeOutsidePos = outPt }
    end
    return { waypoints = { startPos }, targetCol = nil, safeOutsidePos = startPos }
end

