local function getItemsInRoom()
    local map = getMap(); local items = {}
    if not map then return items end
    local folder = map:FindFirstChild("Items"); if not folder then return items end
    for _, item in ipairs(folder:GetChildren()) do
        if item:IsA("Model") then
            if not items[item.Name] then items[item.Name] = {count=0,instances={}} end
            items[item.Name].count = items[item.Name].count + 1
            table.insert(items[item.Name].instances, item)
        end
    end
    return items
end

local function pickupSelectedItem(targetName, cb)
    if isPickingUp then return end
    isPickingUp = true
    Config.PickupMode = Config.TeleportMode
    Config.PickupTweenSpeed = Config.TweenSpeed
    task.spawn(function()
        local map = getMap()
        if not map then if cb then cb("Map tidak ditemukan!") end isPickingUp=false; return end
        local folder = map:FindFirstChild("Items")
        if not folder then if cb then cb("Tidak ada Items folder!") end isPickingUp=false; return end

        local targets = {}
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Model") and item.Name == targetName then
                table.insert(targets, item)
            end
        end
        if #targets == 0 then
            if cb then cb("Item '"..targetName.."' tidak ada di room!") end
            isPickingUp = false; return
        end

        if cb then cb("Mengambil "..#targets.."x "..targetName.."...") end

        local function sortByNearest()
            if not rootPart then return end
            table.sort(targets, function(a, b)
                if not a.Parent then return false end
                if not b.Parent then return true end
                return (rootPart.Position - a:GetPivot().Position).Magnitude
                     < (rootPart.Position - b:GetPivot().Position).Magnitude
            end)
        end

        while #targets > 0 do
            if abortTeleport or not isPickingUp then break end

            sortByNearest()
            local item = targets[1]
            table.remove(targets, 1)

            if not item or not item.Parent or not rootPart then
                -- skip, item udah hilang
            else
                local itemCF  = item:GetPivot()
                -- +3 di Y: karakter berdiri sedikit di atas pivot item biar ProximityPrompt masih ke-reach tapi karakter gak ambles
                local cf = CFrame.new(itemCF.Position.X, itemCF.Position.Y + 3, itemCF.Position.Z)

                -- PRIORITAS: Pathfind ON → masuk pathfindTween (dia handle underground juga)
                if Config.PickupMode == "Tween" and Config.PathfindMode then
                    doTeleport(cf, Config.PickupMode, Config.PickupTweenSpeed)
                    -- Tunggu pathfinding benar-benar mulai
                    local waitStart = 0
                    while not isPathfinding and waitStart < 1 do
                        task.wait(0.05); waitStart = waitStart + 0.05
                    end
                    -- Tunggu pathfinding benar-benar selesai, max 30 detik
                    local waited = 0
                    while isPathfinding and waited < 30 do
                        task.wait(0.1); waited = waited + 0.1
                    end
                    -- Extra wait biar rootPart settle di posisi akhir
                    task.wait(0.3)

                -- Underground only (tanpa pathfind)
                elseif Config.UndergroundTeleport and Config.PickupMode == "Tween" then
                    if not rootPart then return end
                    local target = cf.Position
                    local startY = rootPart.Position.Y
                    local downY  = startY - ugDepth

                    teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), ugRiseSpeed)
                    if abortTeleport or not isPickingUp then
                        rootPart.Anchored = false; isPickingUp = false; return
                    end
                    teleportTween(CFrame.new(target.X, downY, target.Z), Config.PickupTweenSpeed)
                    if abortTeleport or not isPickingUp then
                        rootPart.Anchored = false; isPickingUp = false; return
                    end
                    teleportTween(CFrame.new(target.X, target.Y + 4, target.Z), ugRiseSpeed)
                    if abortTeleport or not isPickingUp then
                        rootPart.Anchored = false; isPickingUp = false; return
                    end

                -- Normal tween atau instant
                else
                    doTeleport(cf, Config.PickupMode, Config.PickupTweenSpeed)
                    if Config.PickupMode == "Tween" then
                        local waited  = 0
                        local dist    = (rootPart.Position - cf.Position).Magnitude
                        local estTime = dist / ((player:GetAttribute("KM_MAX_PLAYER_SPEED") or 16) * Config.PickupTweenSpeed) + 0.5
                        while waited < estTime and not abortTeleport do
                            task.wait(0.1); waited = waited + 0.1
                        end
                    end
                end
                rootPart.Anchored = true
                task.wait(0.1)

                local function makePlatform(atCF)
                    local plat = Instance.new("Part")
                    plat.Size = Vector3.new(10,1,10); plat.Anchored = true
                    plat.CanCollide = true; plat.Transparency = 1
                    plat.CFrame = CFrame.new(
                        atCF.X,
                        atCF.Y - 3,
                        atCF.Z
                    )
                    plat.Parent = Workspace
                    return plat
                end

                local plat = makePlatform(rootPart.Position)

                local timeout = 30
                while item.Parent and timeout > 0 and not abortTeleport do

                    if isThreatened() then
                        print("[PICKUP] Monster! Turun underground dari posisi sekarang...")

                        -- Simpan posisi Y SEBELUM turun
                        local savedPos = rootPart.Position
                        local hidePos  = Vector3.new(savedPos.X, savedPos.Y - ugDepth, savedPos.Z)

                        -- Unanchor, hapus platform lama
                        rootPart.Anchored = false
                        if plat and plat.Parent then plat:Destroy() end

                        -- Tween turun underground
                        teleportTween(CFrame.new(hidePos), ugRiseSpeed)

                        -- Anchor + platform di posisi underground
                        rootPart.Anchored = true
                        plat = makePlatform(rootPart.Position)

                        -- Diam di bawah, tunggu aman
                        print("[PICKUP] Diam underground, tunggu monster pergi...")
                        while isThreatened() and not abortTeleport and isPickingUp do
                            -- Update platform ngikutin posisi karakter
                            if plat and plat.Parent then
                                plat.CFrame = CFrame.new(
                                    rootPart.Position.X,
                                    rootPart.Position.Y - 3,
                                    rootPart.Position.Z
                                )
                            end
                            timeout = 30 -- reset timeout selama hiding
                            task.wait(0.2)
                        end

                        if abortTeleport or not isPickingUp then
                            if plat and plat.Parent then plat:Destroy() end
                            rootPart.Anchored = false
                            break
                        end

                        print("[PICKUP] Aman! Naik balik ke Y semula...")

                        -- Unanchor, hapus platform underground
                        rootPart.Anchored = false
                        if plat and plat.Parent then plat:Destroy() end

                        -- Tween naik ke Y semula (savedPos)
                        teleportTween(CFrame.new(savedPos), ugRiseSpeed)

                        -- Anchor + platform di posisi naik
                        rootPart.Anchored = true
                        plat = makePlatform(rootPart.Position)

                        print("[PICKUP] Lanjut pathfind ke item dari posisi sekarang...")

                        -- Pathfind ulang dari posisi sekarang ke item
                        if Config.PickupMode == "Tween" and Config.PathfindMode then
                            rootPart.Anchored = false
                            if plat and plat.Parent then plat:Destroy() end

                            task.spawn(function() pathfindTween(cf) end)

                            -- Tunggu pathfind mulai
                            local w = 0
                            while not isPathfinding and w < 1 do
                                task.wait(0.05); w = w + 0.05
                            end
                            -- Tunggu pathfind selesai
                            w = 0
                            while isPathfinding and w < 30 and not abortTeleport do
                                task.wait(0.1); w = w + 0.1
                            end
                            task.wait(0.2)

                            -- Anchor lagi setelah pathfind selesai
                            rootPart.Anchored = true
                            plat = makePlatform(rootPart.Position)
                        else
                            -- Non-pathfind: tween biasa ke item
                            rootPart.Anchored = false
                            if plat and plat.Parent then plat:Destroy() end
                            doTeleport(cf, Config.PickupMode, Config.PickupTweenSpeed)
                            if Config.PickupMode == "Tween" then
                                local w = 0
                                local spd = (player:GetAttribute("KM_MAX_PLAYER_SPEED") or 16) * Config.PickupTweenSpeed
                                local est = (rootPart.Position - cf.Position).Magnitude / spd + 0.3
                                while w < est and not abortTeleport do
                                    task.wait(0.1); w = w + 0.1
                                end
                            end
                            rootPart.Anchored = true
                            plat = makePlatform(rootPart.Position)
                        end

                        -- Reset timeout setelah repath
                        timeout = 30
                    end

                    -- Interact normal
                    local pp = item:FindFirstChild("Prompt")
                    if pp then
                        local prox = pp:FindFirstChild("ProximityPrompt")
                        if prox and prox.Enabled then interactWithPrompt(prox) end
                    end

                    task.wait(0.1)
                    timeout = timeout - 0.1
                end

                if plat and plat.Parent then plat:Destroy() end
                rootPart.Anchored = false
                task.wait(0.2)
            end
        end

        if cb then cb("Selesai ambil "..targetName.."!") end
        isPickingUp = false
    end)
end

