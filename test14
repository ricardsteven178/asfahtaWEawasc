-- ==================== PATHFIND TWEEN ====================
local pathfindTween -- forward declaration untuk rekursi
pathfindTween = function(targetCF, statusCb, _attempt)
    if isPathfinding or not rootPart then return end
    isPathfinding = true
    abortTeleport = false
    -- Flag terpisah biar pickup bisa deteksi pathfind beneran selesai
    local pfDone = false
    clearPathVisuals()
    refreshColliderCache()

    local function setStatus(txt, col)
        if pfStatusRef then pfStatusRef.Text = txt; pfStatusRef.TextColor3 = col or Color3.fromRGB(160,120,255) end
        if statusCb then statusCb(txt) end
    end

    local comboMode = Config.PathfindMode and Config.UndergroundTeleport

    -- ALWAYS compute di Y normal supaya NavMesh valid
    -- underground offset diterapkan per-waypoint saat gerak
    local computeTarget = targetCF.Position

    local attempt = _attempt or 0
    local currentParams = (attempt == 2) and AGENT_PARAMS_LASTRESORT
                       or (attempt == 1) and AGENT_PARAMS_FALLBACK
                       or AGENT_PARAMS

    local path = PathfindingService:CreatePath(currentParams)
    local ok = pcall(function() path:ComputeAsync(rootPart.Position, computeTarget) end)

    if not ok or path.Status ~= Enum.PathStatus.Success then
        if attempt < 2 then
            local msgs = {"🔄 Retry path (fallback)...", "🔄 Retry path (last resort)..."}
            setStatus(msgs[attempt+1], Color3.fromRGB(220,180,60))
            isPathfinding = false
            task.wait(0.1)
            pathfindTween(targetCF, statusCb, attempt + 1)
            return
        else
            setStatus("⚠ Path gagal total, fallback tween", Color3.fromRGB(220,100,60))
            if not abortTeleport then
                if comboMode then
                    local target = targetCF.Position
                    local startY = rootPart.Position.Y
                    local downY  = startY - ugDepth
                    teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), ugRiseSpeed)
                    if not abortTeleport then
                        teleportTween(CFrame.new(target.X, downY, target.Z), Config.TweenSpeed)
                    end
                    if not abortTeleport then
                        teleportTween(CFrame.new(target.X, target.Y + 4, target.Z), ugRiseSpeed)
                    end
                else
                    teleportTween(targetCF, Config.TweenSpeed)
                end
            end
            task.delay(2, function() if pfStatusRef then pfStatusRef.Text = "" end end)
            isPathfinding = false
            return
        end
    end

    local waypoints = path:GetWaypoints()
    if #waypoints == 0 then
        if not abortTeleport then teleportTween(targetCF, Config.TweenSpeed) end
        isPathfinding = false
        return
    end

    local attemptLabel = (attempt == 1) and " [fallback]" or (attempt == 2) and " [last resort]" or ""
    local modeLabel    = comboMode and " [COMBO]" or ""
    setStatus("🔵 Pathfinding... ("..#waypoints.." titik)"..attemptLabel..modeLabel, Color3.fromRGB(160,120,255))

    local g = Workspace.Gravity; Workspace.Gravity = 0

    for i, wp in ipairs(waypoints) do
        if abortTeleport or not _G.TeleportGUI_Loaded then
            setStatus("🛑 Dibatalkan", Color3.fromRGB(220,80,80))
            task.delay(1.5, function() if pfStatusRef then pfStatusRef.Text = "" end end)
            break
        end

        -- Monster check SUPERSENSITIF antar waypoint
        if isThreatened() then
            if hideFromMonsterAndResume and hideFromMonsterAndResume(targetCF, statusCb, setStatus, g) then
                return
            end
        end

        -- Combo mode: X,Z ikut NavMesh path, Y di-offset underground
        -- Normal pathfind: +0.5 biar ga nyangkut lantai
        local wpY
        if comboMode then
            wpY = wp.Position.Y - ugDepth
        else
            wpY = wp.Position.Y + (Config.UndergroundTeleport and -ugDepth or 0.5)
        end

        local wpPos = Vector3.new(wp.Position.X, wpY, wp.Position.Z)
        local wpCF  = CFrame.new(wpPos)

        local pathOk = isRayClear(rootPart.Position, wpPos)

        if not pathOk then
            -- WAJIB stop di sini, jangan lanjut tween ke waypoint ini
            -- karena jalurnya lewat NoClip collider
            print("[PATHFIND] Waypoint "..i.." blocked, STOP — mencari bypass...")
            drawWaypoint(wp.Position, Color3.fromRGB(255,50,50))
            setStatus("🔴 Waypoint "..i.." blocked, bypass...", Color3.fromRGB(255,100,50))

            -- Cari collider yang ngeblok
            local blockingCol = nil
            for _, col in ipairs(cachedColliders) do
                if not col or not col.Parent then continue end
                local colPos   = col.Position
                local colSize  = col.Size
                local marginXZ = AGENT_PARAMS.AgentRadius + 1
                local marginY  = AGENT_PARAMS.AgentHeight / 2
                local midPoint = (rootPart.Position + wpPos) / 2
                if math.abs(midPoint.X - colPos.X) < (colSize.X / 2 + marginXZ + 2)
                and math.abs(midPoint.Y - colPos.Y) < (colSize.Y / 2 + marginY + 2)
                and math.abs(midPoint.Z - colPos.Z) < (colSize.Z / 2 + marginXZ + 2) then
                    blockingCol = col
                    break
                end
            end

            -- Waypoint blocked — skip saja, jangan paksa bypass
            -- NavMesh sudah hitung path terbaik, kalau blocked berarti
            -- collider overlap dengan waypoint itu sendiri, bukan jalurnya
            -- Cukup skip waypoint ini dan lanjut ke berikutnya
            print("[PATHFIND] Waypoint "..i.." blocked, skip ke waypoint berikutnya")
            -- Jangan break, jangan bypass paksa — lanjut loop
        else
            drawWaypoint(wp.Position, i == #waypoints and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,200,0))

            local posBeforeTween = rootPart.CFrame
            local dist = (rootPart.Position - wpPos).Magnitude
            -- Skip waypoint kalau terlalu dekat (sudah ada di sana)
            if dist < 0.3 then continue end
            -- Duration minimum 0.05 biar physics server sempat sync
            -- TweenSpeed sebagai multiplier: makin tinggi = makin cepat
            local dur = math.max(dist / (16 * Config.TweenSpeed), 0.05)

            rootPart.AssemblyLinearVelocity = Vector3.zero
            local tw = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = wpCF})
            tw:Play()

            -- Monitor tween dengan interrupt monster INSTAN
            local tweenDone = false
            tw.Completed:Connect(function() tweenDone = true end)
            while not tweenDone do
                -- CEK MONSTER TIAP 0.05 DETIK — supersensitif
                if isThreatened() then
                    tw:Cancel()
                    print("[PATHFIND] Monster terdeteksi saat tween! Interrupt instan.")
                    tweenDone = true
                end
                if abortTeleport or not _G.TeleportGUI_Loaded then
                    tw:Cancel()
                    tweenDone = true
                end
                task.wait(0.05)
            end

            -- Kalau monster interrupt tween, langsung sembunyi
            if isThreatened() then
                Workspace.Gravity = g
                rootPart.AssemblyLinearVelocity = Vector3.zero
                if hideFromMonsterAndResume and hideFromMonsterAndResume(targetCF, statusCb, setStatus, g) then
                    return
                end
            end

            if not isRayClear(posBeforeTween.Position, rootPart.Position) then
                print("[PATHFIND] Post-tween nabrak collider! Rollback waypoint "..i)
                rootPart.CFrame = posBeforeTween
            end
        end
    end

    Workspace.Gravity = g
    rootPart.AssemblyLinearVelocity = Vector3.zero

    if not abortTeleport then
        local fp = targetCF.Position
        if comboMode then
            setStatus("⬆ Naik ke target...", Color3.fromRGB(120,255,160))
            -- Naik ke Y item + offset, TUNGGU tween selesai beneran
            teleportTween(CFrame.new(fp.X, fp.Y + 4, fp.Z), ugRiseSpeed)
            -- Hard snap ke posisi akhir setelah tween
            if not abortTeleport and rootPart then
                rootPart.CFrame = CFrame.new(fp.X, fp.Y + 4, fp.Z)
            end
        elseif Config.UndergroundTeleport then
            rootPart.CFrame = CFrame.new(fp.X, fp.Y - ugDepth, fp.Z)
        else
            -- Tidak perlu hard snap kalau pathfind sudah jalan sampai waypoint terakhir
            -- Hard snap hanya kalau jarak masih jauh (>2 studs) dari target
            local distToTarget = (rootPart.Position - targetCF.Position).Magnitude
            if distToTarget > 2 then
                rootPart.CFrame = targetCF
            end
        end
        setStatus("✔ Pathfind selesai!" .. (comboMode and " [COMBO]" or ""), Color3.fromRGB(100,220,150))
        task.delay(2, function()
            if pfStatusRef then pfStatusRef.Text = "Aktif saat mode Tween dipilih" end
            clearPathVisuals()
        end)
    end

    abortTeleport = false
    isPathfinding = false
    pfDone = true -- flag selesai
end

-- ==================== MASTER TELEPORT ROUTER ====================
local function doTeleport(cf, mode, speed)
    -- Pathfind ON: selalu masuk pathfindTween, dia yang handle underground juga
    if mode == "Tween" and Config.PathfindMode then
        task.spawn(function() pathfindTween(cf) end)
        return
    end

    -- Underground only (tanpa pathfind)
    if Config.UndergroundTeleport and mode == "Tween" then
        if not rootPart then return end
        local target = cf.Position
        local startY = rootPart.Position.Y
        local downY  = startY - ugDepth

        teleportTween(CFrame.new(rootPart.Position.X, downY, rootPart.Position.Z), ugRiseSpeed)
        if abortTeleport then return end
        teleportTween(CFrame.new(target.X, downY, target.Z), speed)
        if abortTeleport then return end
        teleportTween(CFrame.new(target.X, target.Y + 4, target.Z), ugRiseSpeed)
        return
    end

    -- Normal tween atau instant
    local finalCF = cf
    if Config.UndergroundTeleport then
        local p = cf.Position
        finalCF = CFrame.new(p.X, p.Y - ugDepth, p.Z)
    end

    if mode == "Tween" then
        teleportTween(finalCF, speed)
    else
        teleportInstant(finalCF)
    end
end

-- ==================== MONSTER HIDE HELPER ====================
local function hideFromMonsterAndResume(targetCF, statusCb, setStatusFn, g)
    if not isThreatened() then return false end

    setStatusFn("👁 Monster! Sembunyi...", Color3.fromRGB(255,60,60))
    Workspace.Gravity = g

    local pausePos = rootPart.Position
    local hideY    = pausePos.Y - ugDepth

    teleportTween(CFrame.new(pausePos.X, hideY, pausePos.Z), ugRiseSpeed)
    rootPart.Anchored = true

    setStatusFn("🕳 Tunggu monster pergi...", Color3.fromRGB(200,60,60))
    while isThreatened() and not abortTeleport and _G.TeleportGUI_Loaded do
        task.wait(0.2)
    end

    rootPart.Anchored = false

    if abortTeleport or not _G.TeleportGUI_Loaded then
        isPathfinding = false
        Workspace.Gravity = g
        return true
    end

    setStatusFn("⏳ Tunggu "..monsterSafeDelay.."s sebelum naik...", Color3.fromRGB(180,180,60))
    local safeWait = 0
    while safeWait < monsterSafeDelay and not abortTeleport and _G.TeleportGUI_Loaded do
        if isThreatened() then
            safeWait = 0
            setStatusFn("👁 Monster balik! Tunggu lagi...", Color3.fromRGB(255,60,60))
        end
        task.wait(0.2)
        safeWait = safeWait + 0.2
    end

    if abortTeleport or not _G.TeleportGUI_Loaded then
        isPathfinding = false
        Workspace.Gravity = g
        return true
    end

    setStatusFn("⬆ Aman, naik balik...", Color3.fromRGB(100,220,150))
    teleportTween(CFrame.new(pausePos.X, pausePos.Y, pausePos.Z), ugRiseSpeed)

    setStatusFn("🔄 Recompute path...", Color3.fromRGB(160,120,255))
    Workspace.Gravity = g
    rootPart.AssemblyLinearVelocity = Vector3.zero
    abortTeleport = false
    isPathfinding = false
    task.wait(0.1)

    task.spawn(function()
        task.wait(0.05)
        pathfindTween(targetCF, statusCb, 0)
    end)
    return true
end

local function waitUntilSafe(timeout)
    local elapsed = 0
    while isThreatened() and elapsed < timeout do
        task.wait(0.2)
        elapsed = elapsed + 0.2
    end
    return not isThreatened()
end

-- ==================== ITEM INTERACT ====================
local function interactWithPrompt(prompt)
    prompt.RequiresLineOfSight = false
    prompt.MaxActivationDistance = math.huge
    if fireproximityprompt then
        fireproximityprompt(prompt, 1)
    else
        pcall(function()
            prompt:InputHoldBegin()
            if prompt.HoldDuration > 0 then task.wait(prompt.HoldDuration) end
            prompt:InputHoldEnd()
        end)
    end
end

-- ==================== ESP ====================
local function clearESP(tag)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local e = obj:FindFirstChild(tag)
        if e then e:Destroy() end
    end
end

local function addHighlight(parent, fill, outline, tag)
    if parent:FindFirstChild(tag) then return end
