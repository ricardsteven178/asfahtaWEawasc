-- ==================== COLLIDER CACHE + CHECKS ====================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function refreshColliderCache()
    cachedColliders = getNoClipColliders()
    if #cachedColliders > 0 then
        rayParams.FilterDescendantsInstances = cachedColliders
    end
end

-- Hapus isPositionSafe sepenuhnya, ganti semua check pakai raycast murni

local function isRayClear(fromPos, toPos)
    if #cachedColliders == 0 then return true end
    local dir    = toPos - fromPos
    local dist   = dir.Magnitude
    if dist < 0.1 then return true end

    -- Cast dari 5 titik: tengah, atas, bawah, kiri, kanan karakter
    -- biar coverage lebih lebar, tidak cuma garis lurus
    local perpXZ = Vector3.new(-dir.Z, 0, dir.X).Unit * 1.5
    local offsets = {
        Vector3.new(0, 0.5, 0),          -- tengah
        Vector3.new(0, 2.5, 0),          -- atas
        Vector3.new(0, -0.5, 0),         -- bawah
        perpXZ + Vector3.new(0, 0.5, 0), -- kiri
        -perpXZ + Vector3.new(0, 0.5, 0),-- kanan
    }
    for _, off in ipairs(offsets) do
        local result = Workspace:Raycast(fromPos + off, dir, rayParams)
        if result then return false end
    end
    return true
end

-- isPathClear sekarang pakai raycast, bukan AABB
local function isPathClear(fromPos, toPos)
    return isRayClear(fromPos, toPos)
end

