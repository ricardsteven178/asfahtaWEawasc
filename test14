local espI,espT=makeTogglePair("🟢 Item ESP","🔵 Gen ESP")
local espM,espL=makeTogglePair("🔴 Monster ESP","📏 Line ESP")

local function updateESPUI()
    espI.BackgroundColor3=Config.ItemESP    and Color3.fromRGB(30,90,50)   or Color3.fromRGB(30,30,45)
    espI.TextColor3      =Config.ItemESP    and Color3.fromRGB(100,220,120) or Color3.fromRGB(140,140,160)
    espT.BackgroundColor3=Config.GenESP     and Color3.fromRGB(30,50,100)  or Color3.fromRGB(30,30,45)
    espT.TextColor3      =Config.GenESP     and Color3.fromRGB(120,170,255) or Color3.fromRGB(140,140,160)
    espM.BackgroundColor3=Config.MonsterESP and Color3.fromRGB(90,25,25)   or Color3.fromRGB(30,30,45)
    espM.TextColor3      =Config.MonsterESP and Color3.fromRGB(255,90,90)   or Color3.fromRGB(140,140,160)
    espL.BackgroundColor3=Config.LineESP    and Color3.fromRGB(70,50,20)   or Color3.fromRGB(30,30,45)
    espL.TextColor3      =Config.LineESP    and Color3.fromRGB(255,200,60)  or Color3.fromRGB(140,140,160)
end
updateESPUI()

espI.MouseButton1Click:Connect(function() Config.ItemESP=not Config.ItemESP; if not Config.ItemESP then clearESP("_ItemESP") end; updateESPUI() end)
espT.MouseButton1Click:Connect(function() Config.GenESP=not Config.GenESP;   if not Config.GenESP  then clearESP("_GenESP")  end; updateESPUI() end)
espM.MouseButton1Click:Connect(function() Config.MonsterESP=not Config.MonsterESP; if not Config.MonsterESP then clearESP("_MonsterESP") end; updateESPUI() end)
