-- ==================== HELPERS ====================
local function getMap()
    return Workspace:FindFirstChild("CurrentRoom")
        and Workspace.CurrentRoom:FindFirstChildWhichIsA("Model")
end

local function getModelCenter(model)
    if not model or not model:IsA("Model") then return nil end
    local total, n = Vector3.zero, 0
    for _, p in pairs(model:GetDescendants()) do
        if p:IsA("BasePart") then total = total + p.Position; n = n + 1 end
    end
    return n > 0 and total / n or nil
end

local function getSafePlaceCFrame()
    local elevators = Workspace:FindFirstChild("Elevators")
    if elevators then
        for _, el in ipairs(elevators:GetChildren()) do
            if el.Name == "Elevator" and el:IsA("Model") then
                local ds = el:FindFirstChild("DandyStore")
                if ds then
                    local dsh = ds:FindFirstChild("DandyShop")
                    if dsh then
                        local r = dsh:FindFirstChild("RootPart")
                        if r then return r.CFrame * CFrame.new(0,3,0) end
                    end
                end
            end
        end
    end
    local map = getMap()
    if map then
        local fa = map:FindFirstChild("FreeArea")
        if fa then
            local fe = fa:FindFirstChild("FakeElevator")
            if fe and fe:IsA("Model") then
                local c = getModelCenter(fe)
                if c then return CFrame.new(c) end
            end
        end
    end
    return nil
end

-- ==================== MONSTER THREAT DETECTION ====================
local function isThreatened()
    -- LAYER 1: UI icon — cek transparency saja, ignore Visible
    -- karena MonsterIcon bisa selalu Visible di game ini
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        -- Cari semua ScreenGui, bukan cuma "ScreenGui"
        for _, gui in ipairs(pGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local monsterIcon = gui:FindFirstChild("MonsterIcon")
                if monsterIcon then
                    -- Cek ImageTransparency SAJA tanpa cek Visible
                    if typeof(monsterIcon.ImageTransparency) == "number"
                    and monsterIcon.ImageTransparency < 0.99 then
                        return true
                    end
                end
                -- Fallback: cari ImageLabel apapun yang namanya mengandung "monster"
                for _, child in ipairs(gui:GetDescendants()) do
                    if child:IsA("ImageLabel") then
                        local nameLower = string.lower(child.Name)
                        if string.find(nameLower, "monster") or string.find(nameLower, "icon") then
                            if child.ImageTransparency < 0.99 and child.Visible then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end

    -- LAYER 2: Jarak langsung ke monster — paling reliable
    -- Kalau monster dalam radius 25 studs dari karakter = bahaya
    if rootPart then
        local map = getMap()
        if map then
            local monstersFolder = map:FindFirstChild("Monsters")
            if monstersFolder then
                for _, monster in pairs(monstersFolder:GetChildren()) do
                    -- Cek ChasingValue dulu
                    local chasing = monster:FindFirstChild("ChasingValue")
                    if chasing and chasing.Value == character then
                        return true
                    end
                    -- Cek jarak fisik
                    if monster:IsA("Model") and monster.PrimaryPart then
                        local dist = (monster.PrimaryPart.Position - rootPart.Position).Magnitude
                        if dist <= 25 then
                            return true
                        end
                    end
                end
            end
        end
    end

    return false
end

-- ==================== TELEPORT ====================
local function teleportInstant(cf)
    if not rootPart then return end
    local g = Workspace.Gravity; Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity = Vector3.zero
    character:PivotTo(cf)
    Workspace.Gravity = g
end

local function teleportTween(cf, speed)
    if not rootPart then return end
    local g = Workspace.Gravity
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity = Vector3.zero

    local spd  = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 16
    local dist = (rootPart.Position - cf.Position).Magnitude
    local dur  = math.max(dist / (spd * (speed or 1.25)), 0.1)

    local tw = TweenService:Create(
        rootPart,
        TweenInfo.new(dur, Enum.EasingStyle.Linear),
        {CFrame = cf}
    )
    activeTween = tw
    tw:Play()

    local done = false
    tw.Completed:Connect(function() done = true end)
    while not done do
        if abortTeleport then tw:Cancel(); break end
        -- Interrupt INSTAN kalau monster terdeteksi saat tween jalan
        if isThreatened() then
            tw:Cancel()
            break
        end
        task.wait(0.05) -- 0.05 cukup responsif, 0.01 terlalu boros CPU
    end

    rootPart.CFrame = cf
    rootPart.AssemblyLinearVelocity = Vector3.zero
    activeTween = nil
    Workspace.Gravity = g
end

-- ==================== NOCLIP COLLIDER GETTER ====================
local function getNoClipColliders()
    local cols = {}
    local room = Workspace:FindFirstChild("CurrentRoom")
    if not room then return cols end
    for _, v in ipairs(room:GetDescendants()) do
        if v:IsA("BasePart") then
            local n = v.Name
            -- HANYA nama yang spesifik = invisible wall beneran
            -- Jangan tambah "Collider" atau "NoClip" karena itu nama generik
            -- yang dipakai tangga, lantai, dan geometry normal lainnya
            if n == "NoClip_Collider" or n == "CylinderCollider" then
                table.insert(cols, v)
            end
        end
    end
    return cols
end

